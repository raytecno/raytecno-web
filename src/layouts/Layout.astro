---
/**
 * Layout principal con SEO completo, Header y Footer multiidioma
 *
 * Incluye:
 * - Redirección automática .com → .es
 * - SEO completo (meta, OG, Twitter, Schema JSON-LD)
 * - Header responsive
 * - Footer con redes sociales
 * - WhatsApp flotante
 *
 * TEMA CLARO/OSCURO (Septiembre 2026):
 * - ThemeScript va lo primero del <head>, antes de fuentes y estilos, para
 *   que no haya destello blanco al cargar en modo oscuro.
 * - tokens.css define todo el color. Ningún componente escribe ya un #hex.
 * - CORREGIDO: body tenía  background: var(--ink)  — el color del TEXTO como
 *   fondo. Ahora usa var(--bg).
 *
 * SEO (Septiembre 2026):
 * - [A] <html lang> ahora emite etiquetas BCP-47 completas (es-ES, pt-BR,
 *       ca-ES...) en vez del código interno en minúsculas. Debe coincidir
 *       con lo que declaran los hreflang de SEO.astro.
 * - [B] Se reenvían a SEO.astro dos props que existían en el componente pero
 *       que el Layout nunca pasaba, así que ninguna página podía usarlas:
 *       imageAlt (alt de la imagen OG) y breadcrumbs (migas personalizadas).
 * - [C] La redirección .com → .es por JavaScript se mantiene como red de
 *       seguridad, pero NO es una redirección válida para buscadores: no
 *       transmite autoridad y Google puede indexar igualmente el .com.
 *       El arreglo de verdad es un 301 en el hosting del dominio .com.
 */
import SEO from "@/components/SEO.astro";
import Analytics from "@/components/Analytics.astro";
import AnalyticsEvents from "@/components/AnalyticsEvents.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CookieBanner from "@/components/Cookiebanner.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { type Lang } from "@/config/pages";
import ThemeScript from "@/components/ThemeScript.astro";
import "@/styles/tokens.css";

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  /** [B] Alt de la imagen OG. Describe la IMAGEN, no la página. */
  imageAlt?: string;
  lang?: Lang;
  type?: "website" | "article" | "product";
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  alternateUrls?: { lang: Lang; url: string }[];
  /** [B] Migas personalizadas; si no se pasan, SEO.astro las deduce del path. */
  breadcrumbs?: { name: string; url?: string }[];
}

const {
  title,
  description,
  keywords,
  image,
  imageAlt,
  lang = "es",
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  alternateUrls = [],
  breadcrumbs,
} = Astro.props;

// [A] Código interno -> etiqueta BCP-47 para el atributo lang del <html>
const HTML_LANG: Record<Lang, string> = {
  es: "es",
  ca: "ca",
  en: "en",
  fr: "fr",
  "pt-br": "pt-BR",
};

const htmlLang = HTML_LANG[lang] || "es";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- TEMA: lo primero que se ejecuta, antes de pintar nada -->
    <ThemeScript />

    <!-- REDIRECCIÓN .COM → .ES
         [C] Red de seguridad para el visitante. Para el buscador hace falta
         un 301 real en el hosting de raytecno.com. -->
    <script is:inline>
      (function () {
        var host = window.location.hostname;
        if (host === "raytecno.com" || host === "www.raytecno.com") {
          var newUrl =
            "https://www.raytecno.es" +
            window.location.pathname +
            window.location.search +
            window.location.hash;
          window.location.replace(newUrl);
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Completo (meta, OG, Twitter, Schema JSON-LD) -->
    <SEO
      lang={lang}
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      alternateUrls={alternateUrls}
      breadcrumbs={breadcrumbs}
    />
    <Analytics />
  </head>

  <body>
    <Header lang={lang} />

    <main class="main-content">
      <slot />
    </main>

    <Footer lang={lang} />
    <WhatsAppButton lang={lang} />
    <AnalyticsEvents />
    <CookieBanner lang={lang} />
  </body>
</html>

<style is:global>
  /* Reset básico */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* Color, fondo y tipografía salen de tokens.css.
     Aquí solo lo que no es color. */
  body {
    line-height: 1.6;
    min-height: 100vh;
    background: var(--rg-bg);
    color: var(--rg-ink);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Contenido principal con padding para header fijo */
  .main-content {
    padding-top: 72px;
    min-height: calc(100vh - 72px);
  }
</style>