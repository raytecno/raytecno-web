---
// src/pages/404.astro
// Genera /404.html en la raíz del build.
// Azure Static Web Apps la sirve con responseOverrides.404 manteniendo el status 404 real.
// No usa Layout para evitar dependencias de idioma: es una página neutra multiidioma.

const idiomas = [
  { code: "es", label: "Español",    home: "/es", cta: "Ir al inicio" },
  { code: "ca", label: "Català",     home: "/ca", cta: "Anar a l'inici" },
  { code: "en", label: "English",    home: "/en", cta: "Go to homepage" },
  { code: "fr", label: "Français",   home: "/fr", cta: "Aller à l'accueil" },
  { code: "pt-br", label: "Português", home: "/pt-br", cta: "Ir para o início" },
];
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Página no encontrada (404) | RayGold</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --bg: #0b0b0f;
        --fg: #f5f5f7;
        --muted: #9ca3af;
        --purple: #7c3aed;
        --border: rgba(245, 245, 247, 0.12);
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
      }
      main {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem 1.5rem;
        gap: 1.25rem;
      }
      .code {
        font-size: clamp(4rem, 14vw, 8rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.04em;
        background: linear-gradient(135deg, var(--purple), #a78bfa);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin: 0;
      }
      h1 {
        font-size: clamp(1.25rem, 3vw, 1.75rem);
        font-weight: 600;
        margin: 0;
      }
      p {
        color: var(--muted);
        max-width: 46ch;
        margin: 0;
        line-height: 1.6;
      }
      ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        padding: 0;
        margin: 1rem 0 0;
      }
      a {
        display: inline-block;
        padding: 0.6rem 1.1rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--fg);
        text-decoration: none;
        font-size: 0.9rem;
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      a:hover, a:focus-visible {
        border-color: var(--purple);
        background: rgba(124, 58, 237, 0.12);
      }
      .primary {
        border-color: var(--purple);
        background: var(--purple);
        font-weight: 600;
      }
      .primary:hover, .primary:focus-visible {
        background: #6d28d9;
        border-color: #6d28d9;
      }
      .lang-code {
        color: var(--muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-right: 0.4rem;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="code">404</p>
      <h1>Esta página no existe</h1>
      <p>
        La dirección que has abierto no corresponde a ninguna página de RayGold.
        Puede que el enlace esté obsoleto o contenga una errata.
      </p>

      <a class="primary" href="/es">Ir al inicio</a>

      <ul>
        {idiomas.map((i) => (
          <li>
            <a href={i.home}>
              <span class="lang-code">{i.code}</span>{i.cta}
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>