         ======================================== -->
    <section class="faq">
      <div class="container">
        <h2>Preguntas frecuentes sobre ERP de joyería</h2>

        <details class="faq-item">
          <summary><h3>¿Qué es un ERP de joyería?</h3></summary>
          <p>
