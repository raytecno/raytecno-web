  </article>
</Layout>

<style>
  /* ── Variables locales, dentro de la landing (nunca en :root) ─────────── */
  .landing-erp-joyeria {
    --ok: #1f7a4d;
    --ok-soft: rgba(31, 122, 77, 0.1);
    --card-r: 14px;

    background: var(--rg-bg);
    color: var(--rg-ink);
    line-height: 1.7;
    transition: background 0.25s ease, color 0.25s ease;
  }

  :global([data-theme="oscuro"]) .landing-erp-joyeria {
    --ok: #4ade80;
    --ok-soft: rgba(74, 222, 128, 0.12);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
