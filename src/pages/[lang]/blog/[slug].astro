---
/**
 * Blog - Artículo individual
 * src/pages/[lang]/blog/[slug].astro
 *
 * CAMBIOS vs versión WordPress:
 * - Usa getAllBlogSlugs() para getStaticPaths
 * - Usa render() de Content Collections para el HTML del Markdown
 * - Ya NO depende de GraphQL ni WordPress
 *
 * CORRECCIÓN SEO (Febrero 2026):
 * - URLs del Schema.org con www.
 *
 * AÑADIDO (Junio 2026):
 * - FAQPage Schema.org generado desde el campo `faq` del frontmatter
 *
 * TEMA CLARO/OSCURO (Septiembre 2026):
 * - CAUSA DE QUE NO CAMBIARA EL TEMA: la primera regla del <style> era
 *   .blog-article { background: var(--white); color: #1a1a1a; }
 *   Blanco fijo con texto casi negro fijo. El interruptor cambiaba el
 *   data-theme del <html>, pero esta página lo ignoraba por completo.
 * - Todo el bloque .prose pasa a tokens: es lo que pinta el Markdown.
 * - CORREGIDO: <main> anidado dentro del <main> del Layout.
 *
 * PENDIENTE: BlogCTA.astro, RelatedPosts.astro y TableOfContents.astro
 * tienen sus propios <style>. Hasta que se migren, seguirán con sus
 * colores fijos aunque esta página ya responda al tema.
 */

import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Layout.astro';
import BlogCTA from '@/components/blog/BlogCTA.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import { getBlogPostBySlug, getRelatedPosts, getTranslations, getAllBlogSlugs } from '@/lib/blog';
import { supportedLangs, getPageUrl, type Lang } from '@/config/pages';

export const getStaticPaths: GetStaticPaths = async () => {
  const allSlugs = await getAllBlogSlugs();

  return allSlugs.map(({ lang, slug }) => ({
    params: { lang, slug },
    props: { lang: lang as Lang, slug },
  }));
};

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;

// Obtener el post
const post = await getBlogPostBySlug(slug, lang);

if (!post) {
  return Astro.redirect(`/${lang}/blog`);
}

// Renderizar el Markdown a HTML
const { Content, headings } = await post._entry.render();

// Obtener posts relacionados
const relatedPosts = await getRelatedPosts(post, 3);

// Obtener traducciones para hreflang
const translations = post.translationGroup
  ? await getTranslations(post.translationGroup)
  : [];

// Alternate URLs (traducciones + idiomas sin traducción apuntan al blog)
const alternateUrls = supportedLangs.flatMap(l => {
  const translation = translations.find(t => t.language === l);
  return translation
    ? [{ lang: l, url: `/${l}/blog/${translation.slug}` }]
    : [];
});

// Garantizar la autorreferencia aunque translationGroup falte o venga vacío
if (!alternateUrls.some(a => a.lang === lang)) {
  alternateUrls.unshift({ lang, url: `/${lang}/blog/${slug}` });
}

// Traducciones UI
const uiT: Record<string, Record<string, string>> = {
  es: { backToBlog: '← Volver al blog', minRead: 'min lectura', publishedOn: 'Publicado el', by: 'por', toc: 'Contenido' },
  en: { backToBlog: '← Back to blog', minRead: 'min read', publishedOn: 'Published on', by: 'by', toc: 'Contents' },
  fr: { backToBlog: '← Retour au blog', minRead: 'min de lecture', publishedOn: 'Publié le', by: 'par', toc: 'Sommaire' },
  ca: { backToBlog: '← Tornar al blog', minRead: 'min lectura', publishedOn: 'Publicat el', by: 'per', toc: 'Contingut' },
  'pt-br': { backToBlog: '← Voltar ao blog', minRead: 'min de leitura', publishedOn: 'Publicado em', by: 'por', toc: 'Conteúdo' },
};
const ut = uiT[lang] || uiT['es'];

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString(
    lang === 'pt-br' ? 'pt-BR' : lang === 'ca' ? 'ca-ES' : `${lang}-${lang.toUpperCase()}`,
    { year: 'numeric', month: 'long', day: 'numeric' }
  );
}

// Schema.org Article
const schemaArticle = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.seoTitle || post.title,
  "description": post.seoDescription || post.excerpt,
  "image": post.featuredImage,
  "datePublished": post.date,
  "dateModified": post.modified || post.date,
  "author": {
    "@type": "Organization",
    "name": post.author,
  },
  "publisher": {
    "@type": "Organization",
    "name": "Raytecno BCN SL",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.raytecno.es/images/raygold-logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.raytecno.es/${lang}/blog/${slug}`
  }
};

// Schema.org FAQPage - solo si el post define preguntas en su frontmatter
const faqSchema = post.faq && post.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.faq.map((item: { q: string; a: string }) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
} : null;
---

<Layout
  title={post.seoTitle || `${post.title} | Blog RayGold`}
  description={post.seoDescription || post.excerpt}
  lang={lang}
  type="article"
  image={post.featuredImage || undefined}
  publishedTime={post.date}
  modifiedTime={post.modified || undefined}
  alternateUrls={alternateUrls}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <article class="blog-article">
    <!-- Navegación superior -->
    <div class="container">
      <a href={`/${lang}/blog`} class="back-link">{ut.backToBlog}</a>
    </div>

    <!-- Header del artículo -->
    <header class="article-header">
      <div class="container">
        <span class="article-category">{post.category}</span>
        <h1>{post.title}</h1>
        <div class="article-meta">
          <time>{ut.publishedOn} {formatDate(post.date)}</time>
          <span>·</span>
          <span>{post.readingTime} {ut.minRead}</span>
          <span>·</span>
          <span>{ut.by} {post.author}</span>
        </div>

        {/* Traducciones disponibles */}
        {translations.length > 1 && (
          <div class="translations">
            {translations
              .filter(t => t.language !== lang)
              .map(t => (
                <a href={`/${t.language}/blog/${t.slug}`} class="translation-link">
                  {t.language.toUpperCase()}
                </a>
              ))
            }
          </div>
        )}
      </div>
    </header>

    {/* Imagen destacada */}
    {post.featuredImage && (
      <div class="container">
        <div class="featured-image">
          <img src={post.featuredImage} alt={post.title} width="1100" height="550" />
        </div>
      </div>
    )}

    <!-- Contenido -->
    <div class="container article-layout">
      {/* Sidebar con TOC */}
      {post.showToc && headings.length > 0 && (
        <aside class="article-sidebar">
          <TableOfContents headings={headings} title={ut.toc} />
        </aside>
      )}

      {/* Contenido del artículo - render() del Markdown */}
      <div class="article-content prose">
        <Content />
      </div>
    </div>

    {/* Tags */}
    {post.tags.length > 0 && (
      <div class="container">
        <div class="article-tags">
          {post.tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      </div>
    )}

    {/* CTA */}
    {post.ctaEnabled && (
      <div class="container">
        <BlogCTA
          type={post.ctaType}
          title={post.ctaTitle}
          text={post.ctaText}
          button={post.ctaButton}
          url={post.ctaUrl}
          lang={lang}
        />
      </div>
    )}

    {/* Posts relacionados */}
    {relatedPosts.length > 0 && (
      <div class="container">
        <RelatedPosts posts={relatedPosts} lang={lang} />
      </div>
    )}
  </article>
</Layout>

<style>
  .blog-article {
    background: var(--rg-bg);
    color: var(--rg-ink);
    padding-bottom: 3rem;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .back-link {
    display: inline-block;
    padding: 1.25rem 0;
    font-size: 0.85rem;
    color: var(--rg-accent);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- Cabecera del artículo ---------- */
  .article-header {
    padding: 1rem 0 2rem;
  }

  .article-category {
    display: inline-block;
    font-family: var(--rg-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--rg-accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .article-header h1 {
    font-family: var(--rg-display);
    font-size: clamp(1.85rem, 4vw, 2.4rem);
    font-weight: 400;
    line-height: 1.16;
    color: var(--rg-ink);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
    max-width: 24ch;
    text-wrap: balance;
  }

  .article-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--rg-faint);
    flex-wrap: wrap;
  }

  .translations {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.5rem;
  }

  .translation-link {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--rg-line);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--rg-soft);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .translation-link:hover {
    color: var(--rg-accent);
    border-color: var(--rg-accent);
  }

  /* ---------- Imagen destacada ---------- */
  .featured-image {
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 2.5rem;
    background: var(--rg-sup2);
    border: 1px solid var(--rg-line);
  }

  .featured-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ---------- Maquetación ---------- */
  .article-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    padding-bottom: 2rem;
    align-items: start;
  }

  .article-sidebar {
    position: sticky;
    top: 90px;
    align-self: start;
  }

  /* ---------- Contenido Markdown ----------
     Aquí es donde vive el texto del artículo. Todo con tokens: es lo que
     hacía que el cuerpo del post ignorara el tema. */
  .article-content {
    max-width: 70ch;
    color: var(--rg-soft);
    font-size: 1.02rem;
  }

  .prose :global(h2) {
    font-family: var(--rg-display);
    font-size: 1.55rem;
    font-weight: 450;
    letter-spacing: -0.015em;
    color: var(--rg-ink);
    margin: 2.5rem 0 1rem;
    line-height: 1.25;
  }

  .prose :global(h3) {
    font-family: var(--rg-display);
    font-size: 1.22rem;
    font-weight: 500;
    color: var(--rg-ink);
    margin: 1.75rem 0 0.75rem;
    line-height: 1.3;
  }

  .prose :global(h4) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--rg-ink);
    margin: 1.5rem 0 0.5rem;
  }

  .prose :global(p) {
    margin: 0 0 1.1rem;
    line-height: 1.75;
  }

  .prose :global(strong) {
    color: var(--rg-ink);
    font-weight: 600;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.45rem;
    line-height: 1.65;
  }

  .prose :global(li::marker) {
    color: var(--rg-accent);
  }

  .prose :global(a) {
    color: var(--rg-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--rg-ink);
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--rg-accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 1.75rem 0;
    color: var(--rg-ink);
    font-family: var(--rg-display);
    font-size: 1.1rem;
    font-style: italic;
  }

  .prose :global(blockquote p) {
    margin-bottom: 0.5rem;
  }

  .prose :global(code) {
    font-family: var(--rg-mono);
    background: var(--rg-sup2);
    border: 1px solid var(--rg-line);
    color: var(--rg-ink);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85em;
  }

  /* Bloque de código: oscuro en los dos temas, con filete para separarlo
     del fondo cuando el tema ya es oscuro. */
  .prose :global(pre) {
    background: #0f172a;
    color: #e8ecf3;
    border: 1px solid var(--rg-line);
    padding: 1.1rem 1.25rem;
    border-radius: 10px;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    background: none;
    border: none;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--rg-line);
    margin: 1.5rem 0;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rg-line);
    margin: 2.5rem 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .prose :global(th) {
    text-align: left;
    font-weight: 600;
    color: var(--rg-ink);
    background: var(--rg-sup2);
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--rg-line);
  }

  .prose :global(td) {
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--rg-line);
  }

  /* ---------- Tags ---------- */
  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--rg-line);
  }

  .tag {
    font-size: 0.75rem;
    color: var(--rg-accent);
    background: var(--rg-accent-soft);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }

  @media (max-width: 768px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .article-sidebar {
      display: none;
    }
    .featured-image {
      margin-bottom: 1.5rem;
    }
  }
</style>