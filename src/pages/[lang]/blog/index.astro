---
/**
 * Blog - Listado de artículos
 * src/pages/[lang]/blog/index.astro
 *
 * CAMBIOS vs versión WordPress:
 * - Import de getBlogPosts desde @/lib/blog (Content Collections)
 * - Ya NO importa de wordpress ni GraphQL
 *
 * CORRECCIÓN (Julio 2026 - Post Screaming Frog):
 * - Los enlaces de filtro usaban el nombre crudo de la categoría como slug,
 *   generando URLs con espacios y "&" sin escapar.
 * - Se slugifica localmente con slugify().
 * - El filtro se aplica en cliente vía data-cat.
 * - rel="nofollow" en los filtros.
 *
 * TEMA CLARO/OSCURO (Septiembre 2026):
 * - CAUSA DE LOS TÍTULOS INVISIBLES: la página definía --dark: var(--ink) y
 *   pintaba la cabecera con ese degradado, más color: var(--white). Al
 *   renombrarse los tokens, --ink dejó de existir: el degradado no se
 *   aplicaba y quedaba texto blanco sobre fondo blanco.
 * - La cabecera deja de ser banda oscura. Va pegada al menú, que ya es
 *   superficie invertida: dos bandas oscuras seguidas se funden y el titular
 *   del blog parecía parte de la navegación. Ahora es clara con filete.
 * - El oscuro se reserva para el CTA del final, que es una caja suelta y ahí
 *   sí destaca (class="rg-inv").
 * - CORREGIDO: <main> anidado dentro del <main> del Layout.
 */

import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Layout.astro';
import { getBlogPosts, getBlogCategories } from '@/lib/blog';
import { supportedLangs, getPageUrl, type Lang } from '@/config/pages';
import { getTranslations } from '@/i18n';

export const getStaticPaths: GetStaticPaths = async () => {
  return supportedLangs.map(lang => ({
    params: { lang },
    props: { lang },
  }));
};

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// ============================================
// SLUGIFY - Normaliza nombres de categoría a slug seguro para URL
// ============================================
function slugify(value: string): string {
  return (value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

// ============================================
// OBTENER DATOS (Content Collections)
// ============================================
const posts = await getBlogPosts(lang);
const categories = await getBlogCategories(lang);

// Traducciones del blog
const blogT: Record<string, Record<string, string>> = {
  es: {
    title: 'Blog', subtitle: 'Artículos sobre gestión joyera y tecnología ERP',
    allCategories: 'Todas', noPosts: 'No hay artículos disponibles.',
    noResults: 'No hay artículos en esta categoría.',
    minRead: 'min lectura', ctaTitle: '¿Listo para transformar tu negocio joyero?',
    ctaButton: 'Contactar',
  },
  en: {
    title: 'Blog', subtitle: 'Articles about jewelry management and ERP technology',
    allCategories: 'All', noPosts: 'No articles available.',
    noResults: 'No articles in this category.',
    minRead: 'min read', ctaTitle: 'Ready to transform your jewelry business?',
    ctaButton: 'Contact Us',
  },
  fr: {
    title: 'Blog', subtitle: 'Articles sur la gestion joaillière et la technologie ERP',
    allCategories: 'Toutes', noPosts: 'Aucun article disponible.',
    noResults: 'Aucun article dans cette catégorie.',
    minRead: 'min de lecture', ctaTitle: 'Prêt à transformer votre entreprise de joaillerie?',
    ctaButton: 'Contactez-nous',
  },
  ca: {
    title: 'Blog', subtitle: 'Articles sobre gestió joiera i tecnologia ERP',
    allCategories: 'Totes', noPosts: 'No hi ha articles disponibles.',
    noResults: 'No hi ha articles en aquesta categoria.',
    minRead: 'min lectura', ctaTitle: 'Preparat per transformar el teu negoci joier?',
    ctaButton: 'Contactar',
  },
  'pt-br': {
    title: 'Blog', subtitle: 'Artigos sobre gestão joalheira e tecnologia ERP',
    allCategories: 'Todas', noPosts: 'Nenhum artigo disponível.',
    noResults: 'Nenhum artigo nesta categoria.',
    minRead: 'min de leitura', ctaTitle: 'Pronto para transformar seu negócio joalheiro?',
    ctaButton: 'Contato',
  },
};

const bt = blogT[lang] || blogT['es'];

// Helpers
function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString(
    lang === 'pt-br' ? 'pt-BR' : lang === 'ca' ? 'ca-ES' : `${lang}-${lang.toUpperCase()}`,
    { year: 'numeric', month: 'long', day: 'numeric' }
  );
}

function cleanExcerpt(text: string, maxLength: number = 120): string {
  const clean = text.replace(/<[^>]*>/g, '').replace(/\n/g, ' ').trim();
  return clean.length > maxLength ? clean.substring(0, maxLength) + '...' : clean;
}

// Alternate URLs para hreflang
const alternateUrls = supportedLangs.map(l => ({
  lang: l,
  url: `/${l}/blog`,
}));

// ============================================
// SCRIPT DE FILTRADO EN CLIENTE
// El JS evita deliberadamente el carácter "<" para no confundir
// al parser de Astro.
// ============================================
const filterScript = `
(function () {
  function applyFilter() {
    var params = new URLSearchParams(window.location.search);
    var cat = params.get('cat') || '';
    var cards = document.querySelectorAll('[data-cat]');
    var buttons = document.querySelectorAll('.filter-btn');
    var visible = 0;

    cards.forEach(function (card) {
      var match = cat === '' || card.getAttribute('data-cat') === cat;
      card.hidden = !match;
      if (match) { visible = visible + 1; }
    });

    buttons.forEach(function (btn) {
      var slug = btn.getAttribute('data-cat-slug') || '';
      btn.classList.toggle('active', slug === cat);
    });

    var empty = document.getElementById('no-results');
    if (empty) { empty.hidden = visible !== 0; }
  }

  applyFilter();
  window.addEventListener('popstate', applyFilter);
})();
`;
---

<Layout
  title={`${bt.title} | RayGold`}
  description={bt.subtitle}
  lang={lang}
  alternateUrls={alternateUrls}
>
  <section class="blog-page">
    <!-- Header -->
    <div class="blog-header">
      <div class="container">
        <div class="header-top">
          <div class="title-area">
            <h1>{bt.title}</h1>
            <p>{bt.subtitle}</p>
          </div>
        </div>

        {/* Filtro de categorías */}
        {categories.length > 0 && (
          <div class="category-filters">
            <a
              href={`/${lang}/blog`}
              class="filter-btn active"
              data-cat-slug=""
            >{bt.allCategories}</a>
            {categories.map(cat => (
              <a
                href={`/${lang}/blog?cat=${slugify(cat.name)}`}
                class="filter-btn"
                data-cat-slug={slugify(cat.name)}
                rel="nofollow"
              >
                {cat.name} <span class="count">({cat.count})</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Listado de posts -->
    <div class="container blog-content">
      {posts.length > 0 ? (
        <Fragment>
          <div class="posts-grid">
            {posts.map(post => (
              <article class="post-card" data-cat={slugify(post.category)}>
                <a href={`/${lang}/blog/${post.slug}`}>
                  {post.featuredImage && (
                    <div class="post-image">
                      <img
                        src={post.featuredImage}
                        alt={post.title}
                        loading="lazy"
                        width="400"
                        height="225"
                      />
                    </div>
                  )}
                  <div class="post-info">
                    <span class="post-category">{post.category}</span>
                    <h3>{post.title}</h3>
                    <p class="post-excerpt">{cleanExcerpt(post.excerpt, 100)}</p>
                    <div class="post-meta">
                      <time>{formatDate(post.date)}</time>
                      <span>·</span>
                      <span>{post.readingTime} {bt.minRead}</span>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
          <p class="no-posts" id="no-results" hidden>{bt.noResults}</p>
        </Fragment>
      ) : (
        <p class="no-posts">{bt.noPosts}</p>
      )}

      <!-- CTA -->
      <div class="cta-banner rg-inv">
        <span>{bt.ctaTitle}</span>
        <a href={getPageUrl("contacto", lang)}>{bt.ctaButton}</a>
      </div>
    </div>
  </section>

  <script is:inline set:html={filterScript}></script>
</Layout>

<style>
  .blog-page {
    background: var(--rg-bg);
    color: var(--rg-ink);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ---------- Cabecera ---------- */
  .blog-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--rg-line);
  }

  .header-top {
    margin-bottom: 1.5rem;
  }

  .title-area h1 {
    font-family: var(--rg-display);
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--rg-ink);
    margin: 0 0 0.5rem 0;
    line-height: 1.12;
  }

  .title-area p {
    font-size: 0.95rem;
    color: var(--rg-soft);
    margin: 0;
  }

  /* ---------- Filtros ---------- */
  .category-filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--rg-soft);
    background: var(--rg-accent-soft);
    border: 1px solid transparent;
    text-decoration: none;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }

  .filter-btn:hover {
    border-color: var(--rg-accent);
    color: var(--rg-ink);
  }

  .filter-btn.active {
    background: var(--rg-ink);
    color: var(--rg-on-ink);
    border-color: var(--rg-ink);
  }

  .filter-btn .count {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  /* ---------- Listado ---------- */
  .blog-content {
    padding: 2.5rem 0 3rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    background: var(--rg-panel);
    border: 1px solid var(--rg-line);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .post-card:hover {
    transform: translateY(-2px);
    border-color: var(--rg-accent);
    box-shadow: 0 8px 24px var(--rg-sombra);
  }

  .post-card a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .post-card[hidden] {
    display: none;
  }

  .post-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--rg-sup2);
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-info {
    padding: 1.25rem;
  }

  .post-category {
    display: inline-block;
    font-family: var(--rg-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--rg-accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .post-info h3 {
    font-family: var(--rg-display);
    font-size: 1.15rem;
    font-weight: 450;
    letter-spacing: -0.01em;
    color: var(--rg-ink);
    margin: 0 0 0.5rem 0;
    line-height: 1.32;
  }

  .post-excerpt {
    font-size: 0.85rem;
    color: var(--rg-soft);
    margin: 0 0 0.75rem 0;
    line-height: 1.55;
  }

  .post-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--rg-faint);
  }

  .no-posts {
    text-align: center;
    padding: 3rem;
    color: var(--rg-soft);
  }

  .no-posts[hidden] {
    display: none;
  }

  /* ---------- CTA ---------- */
  .cta-banner {
    margin-top: 3rem;
    padding: 2rem;
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .cta-banner span {
    font-family: var(--rg-display);
    font-size: 1.2rem;
    font-weight: 450;
    color: var(--rg-ink);
  }

  .cta-banner a {
    padding: 0.7rem 1.6rem;
    background: var(--rg-accent);
    color: var(--rg-on-ink);
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .cta-banner a:hover {
    background: var(--rg-ink);
    color: var(--rg-bg);
  }

  @media (max-width: 640px) {
    .blog-header {
      padding: 2rem 0 1.5rem;
    }
    .posts-grid {
      grid-template-columns: 1fr;
    }
    .cta-banner {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>