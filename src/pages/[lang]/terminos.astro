---
/**
 * Página de Términos y Condiciones
 * NOINDEX - Esta página no debe aparecer en buscadores
 * CORREGIDO: Añadido alternateUrls para hreflang
 */
import Layout from "@/layouts/Layout.astro";
import { type Lang, getLegalAlternateUrls } from "@/config/pages";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
    { params: { lang: "fr" } },
    { params: { lang: "ca" } },
    { params: { lang: "pt-br" } },
  ];
}

const { lang } = Astro.params as { lang: Lang };

// Generar URLs alternativas para hreflang
const alternateUrls = getLegalAlternateUrls("terminos");

const content = {
  es: {
    title: "Términos y Condiciones",
    metaDescription: "Términos y condiciones de uso de RayGold - Software ERP para joyería.",
    lastUpdate: "Última actualización: Enero 2025",
    sections: [
      {
        title: "1. Identificación",
        text: `Raytecno BCN SL, con domicilio en Montgat, Barcelona, España.\nCIF: BXXXXXXXX\nEmail: info@raytecno.es`
      },
      {
        title: "2. Objeto",
        text: `Estos términos regulan el uso del software RayGold ERP, una solución de gestión empresarial especializada para el sector joyero.`
      },
      {
        title: "3. Licencia de uso",
        text: `Se concede una licencia no exclusiva, intransferible y revocable para usar el software según el plan contratado. Queda prohibida la reproducción, distribución o modificación del software.`
      },
      {
        title: "4. Obligaciones del usuario",
        text: `• Proporcionar información veraz\n• Mantener la confidencialidad de las credenciales\n• No usar el software para fines ilegales\n• Cumplir con la normativa del sector joyero`
      },
      {
        title: "5. Precios y pagos",
        text: `Los precios son los indicados en nuestra web. El pago es mensual anticipado. El impago puede resultar en la suspensión del servicio.`
      },
      {
        title: "6. Soporte técnico",
        text: `Incluido en todos los planes. Horario: Lunes a Viernes, 9:00-18:00 (CET). Tiempo de respuesta máximo: 4 horas laborables.`
      },
      {
        title: "7. Limitación de responsabilidad",
        text: `RayGold no será responsable de daños indirectos. La responsabilidad máxima se limita al importe pagado en los últimos 12 meses.`
      },
      {
        title: "8. Legislación aplicable",
        text: `Estos términos se rigen por la legislación española. Para cualquier controversia, las partes se someten a los juzgados de Barcelona.`
      }
    ]
  },
  en: {
    title: "Terms and Conditions",
    metaDescription: "RayGold Terms and Conditions - ERP Software for jewelry.",
    lastUpdate: "Last updated: January 2025",
    sections: [
      {
        title: "1. Identification",
        text: `Raytecno BCN SL, located in Montgat, Barcelona, Spain.\nEmail: info@raytecno.es`
      },
      {
        title: "2. Purpose",
        text: `These terms govern the use of RayGold ERP software, a business management solution specialized for the jewelry sector.`
      },
      {
        title: "3. License",
        text: `A non-exclusive, non-transferable, revocable license is granted to use the software according to the contracted plan.`
      },
      {
        title: "4. User obligations",
        text: `• Provide accurate information\n• Maintain credential confidentiality\n• Not use the software for illegal purposes\n• Comply with jewelry sector regulations`
      },
      {
        title: "5. Applicable law",
        text: `These terms are governed by Spanish law. For any dispute, the parties submit to the courts of Barcelona.`
      }
    ]
  },
  fr: {
    title: "Conditions Générales",
    metaDescription: "Conditions générales de RayGold.",
    lastUpdate: "Dernière mise à jour: Janvier 2025",
    sections: [
      { title: "1. Identification", text: `Raytecno BCN SL, Montgat, Barcelone, Espagne.\nEmail: info@raytecno.es` },
      { title: "2. Objet", text: `Ces conditions régissent l'utilisation du logiciel RayGold ERP.` }
    ]
  },
  ca: {
    title: "Termes i Condicions",
    metaDescription: "Termes i condicions de RayGold.",
    lastUpdate: "Última actualització: Gener 2025",
    sections: [
      { title: "1. Identificació", text: `Raytecno BCN SL, Montgat, Barcelona, Espanya.\nEmail: info@raytecno.es` },
      { title: "2. Objecte", text: `Aquests termes regulen l'ús del programari RayGold ERP.` }
    ]
  },
  "pt-br": {
    title: "Termos e Condições",
    metaDescription: "Termos e condições do RayGold.",
    lastUpdate: "Última atualização: Janeiro 2025",
    sections: [
      { title: "1. Identificação", text: `Raytecno BCN SL, Montgat, Barcelona, Espanha.\nEmail: info@raytecno.es` },
      { title: "2. Objeto", text: `Estes termos regulam o uso do software RayGold ERP.` }
    ]
  }
};

const c = content[lang] || content.es;
---

<Layout 
  title={c.title} 
  description={c.metaDescription} 
  lang={lang} 
  noindex={true}
  alternateUrls={alternateUrls}
>
  <main class="legal-page">
    <div class="legal-container">
      <h1>{c.title}</h1>
      <p class="last-update">{c.lastUpdate}</p>
      
      {c.sections.map((section) => (
        <section class="legal-section">
          <h2>{section.title}</h2>
          <p set:html={section.text.replace(/\n/g, '<br>')} />
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  .legal-page {
    background: linear-gradient(180deg, #0f172a 0%, #020617 100%);
    min-height: 100vh;
    padding: 120px 24px 80px;
  }

  .legal-container {
    max-width: 800px;
    margin: 0 auto;
  }

  h1 {
    font-size: 2.5rem;
    color: white;
    margin-bottom: 8px;
    font-weight: 700;
  }

  .last-update {
    color: #94a3b8;
    font-size: 0.9rem;
    margin-bottom: 48px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .legal-section {
    margin-bottom: 40px;
  }

  h2 {
    font-size: 1.15rem;
    color: white;
    margin-bottom: 16px;
    font-weight: 600;
  }

  .legal-section p {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .legal-page {
      padding: 100px 20px 60px;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }
    
    h1 { 
      font-size: 1.75rem; 
      color: #1e293b;
    }
    
    h2 { 
      font-size: 1.05rem; 
      color: #1e293b;
    }
    
    .legal-section p {
      color: #475569;
    }
    
    .last-update {
      color: #64748b;
      border-bottom-color: #e2e8f0;
    }
  }
</style>