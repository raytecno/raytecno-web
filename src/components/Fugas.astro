---
/**
 * Fugas.astro — Las dos frases, el medidor de 15 × 2 % y las 15 fugas
 *
 * @file src/components/Fugas.astro
 *
 * Las 15 fugas se renderizan en el build, no por JavaScript: esta página
 * existe para que la lean buscadores y modelos de IA.
 *
 * CAPTURAS (Septiembre 2026):
 * - Al desplegar una fuga aparece una captura del ERP a la derecha.
 * - Las imágenes NO se descargan al cargar la página: van con data-src y solo
 *   se convierten en src la primera vez que se abre esa fuga. Con
 *   loading="lazy" no bastaría: el navegador puede descargar igualmente
 *   imágenes dentro de display:none, y serían quince capturas de golpe.
 * - Al pulsar la captura se abre a pantalla completa. La miniatura va
 *   recortada (object-fit: cover) porque en la fila hay poco alto; la versión
 *   ampliada va entera (object-fit: contain), que es donde se lee de verdad.
 */
import { getPageUrl, type Lang } from '@/config/pages';
import { getFugasTranslations, contarPorArea, type AreaId } from '@/i18n/fugas';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = getFugasTranslations(lang);
const cuenta = contarPorArea(t);
const areasOrden: AreaId[] = ['fab', 'prov', 'cli', 'info', 'it'];
const total = t.fugas.length;
const urlContacto = getPageUrl('contacto', lang);

const BLOB = 'https://raygoldstorage.blob.core.windows.net/web';
---

<div class="fugas-sec" data-plantilla-area={t.frases.medidorPieArea}>
  <!-- ═══════════ Las dos frases + medidor ═══════════ -->
  <section class="par">
    <div class="par__grid">
      <blockquote class="par__q">
        {t.frases.propia} <em>{t.frases.propiaEnfasis}</em>
        <p class="par__src">{t.frases.propiaFuente}</p>
      </blockquote>

      <div class="par__rule" aria-hidden="true"></div>

      <blockquote class="par__q">
        {t.frases.fugas} <em>{t.frases.fugasEnfasis}</em>
        <p class="par__src">{t.frases.fugasFuente}</p>
      </blockquote>
    </div>

    <div class="medidor">
      <div class="medidor__row">
        <div class="medidor__bars">
          {t.fugas.map((f) => <div class="barra is-on" data-area={f.area}></div>)}
        </div>
        <div class="medidor__sum">
          <span class="medidor__cifra" data-cifra>{total * 2} %</span>
          <span class="medidor__pie" data-pie>{t.frases.medidorPie}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ Las 15 fugas ═══════════ -->
  <section class="fugas" id="fugas">
    <div class="fugas__head">
      <div>
        <h2>{t.seccion.titulo}</h2>
        <p>{t.seccion.entradilla}</p>
      </div>

      <div class="pastillas" data-pastillas>
        <button class="pastilla is-on" data-area="all">
          {t.seccion.filtroTodas}<b>{total}</b>
        </button>
        {areasOrden.map((a) => (
          <button class="pastilla" data-area={a}>
            {t.areas[a]}<b>{cuenta[a]}</b>
          </button>
        ))}
      </div>
    </div>

    <div class="lista">
      {t.fugas.map((f, i) => (
        <article class="fuga" data-area={f.area}>
          <div class="fuga__n">
            {String(i + 1).padStart(2, '0')}
            <i>{t.areas[f.area]}</i>
          </div>

          <div class="fuga__cuerpo">
            <h3 class="fuga__t">{f.titulo}</h3>
            <p class="fuga__s">{f.problema}</p>

            <div class="fuga__fix">
              <div class="fuga__texto">
                <p class="fuga__cierre">
                  <span class="k">{t.seccion.etiquetaCierre}</span>
                  <span>{f.cierre}</span>
                </p>
                <p class="mod">{t.seccion.dentroDelPrograma} <b>{f.modulo}</b></p>
              </div>

              {f.imagen && (
                <figure class="fuga__shot">
                  <button class="fuga__zoom" data-zoom aria-label={t.hero.verPantalla}>
                    <img
                      data-src={`${BLOB}/${f.imagen}`}
                      alt={f.imagenAlt}
                      width="640"
                      height="400"
                      decoding="async"
                    />
                    <span class="fuga__lupa" aria-hidden="true">
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                        <circle cx="8.8" cy="8.8" r="5.6"></circle>
                        <path d="M13 13l4 4M8.8 6.6v4.4M6.6 8.8h4.4"></path>
                      </svg>
                    </span>
                  </button>
                  <figcaption>{t.seccion.etiquetaPantalla}</figcaption>
                </figure>
              )}
            </div>
          </div>

          <button
            class="ibtn"
            data-abrir
            data-tip-abrir={t.seccion.verComoSeCierra}
            data-tip-cerrar={t.seccion.cerrar}
            data-tip={t.seccion.verComoSeCierra}
            aria-expanded="false"
            aria-label={t.seccion.verComoSeCierra}
          >
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M8 3v10M3 8h10"></path>
            </svg>
          </button>
        </article>
      ))}
    </div>
  </section>

  <!-- ═══════════ Cierre ═══════════ -->
  <section class="cierre">
    <p class="cierre__q">
      {t.cierre.frase} <em>{t.cierre.fraseEnfasis}</em>
    </p>
    <p class="cierre__t">{t.cierre.texto}</p>
    <a class="btn btn--solid" href={urlContacto}>{t.cierre.cta}</a>
  </section>

  <!-- Visor a pantalla completa -->
  <div class="lb" data-lb role="dialog" aria-modal="true" aria-label={t.hero.verPantalla}>
    <button class="lb__x" data-lb-x aria-label={t.hero.cerrar}>
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M5 5l10 10M15 5L5 15"></path>
      </svg>
    </button>
    <figure class="lb__fig">
      <img data-lb-img src="" alt="" />
      <figcaption data-lb-pie></figcaption>
    </figure>
  </div>
</div>

<style>
  .fugas-sec {
    background: var(--rg-bg);
    color: var(--rg-ink);
    font-family: var(--rg-sans);
  }

  .fugas-sec section {
    max-width: 1140px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  /* ── Las dos frases ── */
  .par {
    padding-top: 66px;
    padding-bottom: 8px;
  }
  .par__grid {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: 0 40px;
  }
  .par__rule {
    background: var(--rg-line);
  }
  .par__q {
    margin: 0;
    font-family: var(--rg-display);
    font-weight: 380;
    font-size: clamp(1.3rem, 2.5vw, 1.85rem);
    line-height: 1.26;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .par__q em {
    font-style: italic;
    color: var(--rg-accent);
  }
  .par__src {
    margin: 14px 0 0;
    font-family: var(--rg-sans);
    font-size: 13px;
    color: var(--rg-faint);
    line-height: 1.5;
  }

  /* ── Medidor ── */
  .medidor {
    margin-top: 44px;
    padding-top: 26px;
    border-top: 1px solid var(--rg-line);
  }
  .medidor__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .medidor__bars {
    display: grid;
    grid-template-columns: repeat(15, 1fr);
    gap: 5px;
    flex: 1;
    min-width: 260px;
    height: 38px;
    align-items: end;
  }
  .barra {
    height: 100%;
    background: var(--rg-line);
    border-radius: 2px;
    position: relative;
    transition: background 0.18s, opacity 0.18s;
  }
  .barra.is-on {
    background: var(--rg-accent);
  }
  .barra.is-dim {
    opacity: 0.28;
  }
  .barra::after {
    content: '2 %';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -20px;
    text-align: center;
    font-family: var(--rg-mono);
    font-size: 9.5px;
    color: var(--rg-faint);
  }
  .medidor__sum {
    white-space: nowrap;
  }
  .medidor__cifra {
    display: block;
    font-family: var(--rg-display);
    font-size: 1.5rem;
    line-height: 1;
  }
  .medidor__pie {
    display: block;
    font-size: 13px;
    color: var(--rg-soft);
    margin-top: 6px;
  }

  /* ── Cabecera de la sección ── */
  .fugas {
    padding-top: 74px;
    padding-bottom: 88px;
  }
  .fugas__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .fugas__head h2 {
    margin: 0;
    font-family: var(--rg-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    letter-spacing: -0.015em;
    line-height: 1.15;
    max-width: 22ch;
    text-wrap: balance;
  }
  .fugas__head p {
    margin: 10px 0 0;
    color: var(--rg-soft);
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.55;
  }

  .pastillas {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pastilla {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13.5px;
    font-family: inherit;
    color: var(--rg-soft);
    border: 1px solid transparent;
    background: var(--rg-accent-soft);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .pastilla:hover {
    border-color: var(--rg-accent);
  }
  .pastilla.is-on {
    background: var(--rg-ink);
    color: var(--rg-on-ink);
  }
  .pastilla b {
    font-weight: 500;
    font-family: var(--rg-mono);
    font-size: 11.5px;
    margin-left: 6px;
    opacity: 0.7;
  }

  /* ── Lista ── */
  .lista {
    border-top: 1px solid var(--rg-line);
  }
  .fuga {
    border-bottom: 1px solid var(--rg-line);
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 44px;
    gap: 0 18px;
    align-items: start;
    padding: 20px 0;
  }
  .fuga[hidden] {
    display: none;
  }
  .fuga__n {
    font-family: var(--rg-mono);
    font-size: 12.5px;
    color: var(--rg-faint);
    padding-top: 5px;
    font-variant-numeric: tabular-nums;
  }
  .fuga__n i {
    display: block;
    font-style: normal;
    font-size: 10px;
    margin-top: 4px;
    color: var(--rg-accent);
  }
  .fuga__cuerpo {
    min-width: 0;
  }
  .fuga__t {
    margin: 0;
    font-family: var(--rg-display);
    font-weight: 450;
    font-size: 1.22rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .fuga__s {
    margin: 6px 0 0;
    color: var(--rg-soft);
    font-size: 15px;
    max-width: 64ch;
    line-height: 1.55;
  }

  /* ── Bloque desplegado: texto + captura ── */
  .fuga__fix {
    margin-top: 16px;
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: 24px 32px;
    align-items: start;
  }
  .fuga.is-open .fuga__fix {
    display: grid;
  }

  .fuga__texto {
    min-width: 0;
    max-width: 60ch;
  }

  .fuga__cierre {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
  }
  .fuga__cierre .k {
    font-family: var(--rg-mono);
    font-size: 11px;
    color: var(--rg-accent);
    padding-top: 4px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .mod {
    margin: 12px 0 0;
    font-size: 13px;
    color: var(--rg-faint);
  }
  .mod b {
    font-weight: 500;
    color: var(--rg-soft);
  }

  /* ── Captura: miniatura pulsable ── */
  .fuga__shot {
    margin: 0;
  }

  .fuga__zoom {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 1px solid var(--rg-line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--rg-sup2);
    cursor: zoom-in;
    box-shadow: 0 10px 28px var(--rg-sombra);
    transition: border-color 0.2s, transform 0.2s;
  }

  .fuga__zoom:hover {
    border-color: var(--rg-accent);
    transform: translateY(-2px);
  }

  .fuga__zoom img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .fuga__lupa {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(15, 23, 42, 0.72);
    color: #fff;
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .fuga__zoom:hover .fuga__lupa,
  .fuga__zoom:focus-visible .fuga__lupa {
    opacity: 1;
  }

  .fuga__lupa svg {
    width: 17px;
    height: 17px;
  }

  .fuga__shot figcaption {
    margin-top: 8px;
    font-family: var(--rg-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rg-faint);
  }

  /* ── Visor a pantalla completa ── */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(10, 12, 18, 0.92);
    display: none;
    place-items: center;
    padding: 40px 28px 28px;
  }
  .lb.is-on {
    display: grid;
  }

  .lb__fig {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 100%;
  }

  .lb img {
    max-width: min(1500px, 96vw);
    max-height: 84vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.5);
  }

  .lb figcaption {
    color: rgba(255, 255, 255, 0.72);
    font-size: 13px;
    text-align: center;
    max-width: 60ch;
  }

  .lb__x {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
    transition: background 0.15s;
  }
  .lb__x:hover {
    background: rgba(255, 255, 255, 0.24);
  }
  .lb__x svg {
    width: 18px;
    height: 18px;
  }

  /* ── Botón solo icono ── */
  .ibtn {
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--rg-soft);
    cursor: pointer;
    position: relative;
    justify-self: end;
    margin-top: 2px;
    transition: background 0.15s, color 0.15s;
  }
  .ibtn:hover {
    background: var(--rg-accent-soft);
    color: var(--rg-accent);
  }
  .ibtn svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s;
  }
  .fuga.is-open .ibtn svg {
    transform: rotate(45deg);
  }
  .ibtn[data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    right: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--rg-ink);
    color: var(--rg-on-ink);
    font-size: 11.5px;
    padding: 5px 9px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s;
  }
  .ibtn:hover::after,
  .ibtn:focus-visible::after {
    opacity: 1;
  }

  /* ── Cierre ── */
  .cierre {
    padding-top: 64px;
    padding-bottom: 80px;
    border-top: 1px solid var(--rg-line);
  }
  .cierre__q {
    margin: 0;
    font-family: var(--rg-display);
    font-weight: 380;
    font-size: clamp(1.5rem, 3.4vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    max-width: 26ch;
    text-wrap: balance;
  }
  .cierre__q em {
    font-style: italic;
    color: var(--rg-accent);
  }
  .cierre__t {
    margin: 18px 0 0;
    color: var(--rg-soft);
    max-width: 56ch;
    line-height: 1.55;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    margin-top: 28px;
    padding: 12px 21px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--rg-ink);
    transition: background 0.18s, border-color 0.18s;
  }
  .btn--solid {
    background: var(--rg-ink);
    color: var(--rg-on-ink);
  }
  .btn--solid:hover {
    background: var(--rg-accent);
    border-color: var(--rg-accent);
  }

  /* ── Responsive ── */
  @media (max-width: 980px) {
    .fuga__fix {
      grid-template-columns: minmax(0, 1fr);
    }
    .fuga__shot {
      max-width: 480px;
    }
    .fuga__lupa {
      opacity: 1;
    }
  }

  @media (max-width: 860px) {
    .par__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .par__rule {
      height: 1px;
    }
    .barra::after {
      display: none;
    }
    .barra:nth-child(5n)::after {
      display: block;
    }
    .fuga {
      grid-template-columns: 36px minmax(0, 1fr) 36px;
      gap: 0 12px;
    }
    .fuga__n i {
      display: none;
    }
    .ibtn[data-tip]::after {
      display: none;
    }
    .lb {
      padding: 56px 12px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .barra,
    .ibtn svg,
    .fuga__zoom {
      transition: none;
    }
  }
</style>

<script>
  function initFugas() {
    const sec = document.querySelector<HTMLElement>('.fugas-sec');
    if (!sec || sec.dataset.listo === '1') return;
    sec.dataset.listo = '1';

    // ── Abrir / cerrar cada fuga ──
    sec.querySelectorAll<HTMLButtonElement>('[data-abrir]').forEach((b) => {
      b.addEventListener('click', () => {
        const art = b.closest('.fuga');
        if (!art) return;

        const abierta = art.classList.toggle('is-open');
        const txt = abierta ? b.dataset.tipCerrar || '' : b.dataset.tipAbrir || '';
        b.setAttribute('aria-expanded', String(abierta));
        b.setAttribute('aria-label', txt);
        b.dataset.tip = txt;

        // Carga diferida real: la captura se descarga la primera vez que
        // se abre esta fuga, no al cargar la página.
        if (abierta) {
          const img = art.querySelector<HTMLImageElement>('.fuga__zoom img[data-src]');
          if (img) {
            img.src = img.dataset.src || '';
            img.removeAttribute('data-src');
          }
        }
      });
    });

    // ── Visor a pantalla completa ──
    const lb = sec.querySelector<HTMLElement>('[data-lb]');
    const lbImg = sec.querySelector<HTMLImageElement>('[data-lb-img]');
    const lbPie = sec.querySelector<HTMLElement>('[data-lb-pie]');
    const lbX = sec.querySelector<HTMLButtonElement>('[data-lb-x]');
    let ultimoFoco: HTMLElement | null = null;

    function abrirLb(origen: HTMLImageElement, disparador: HTMLElement) {
      if (!lb || !lbImg) return;
      ultimoFoco = disparador;
      lbImg.src = origen.currentSrc || origen.src;
      lbImg.alt = origen.alt;
      if (lbPie) lbPie.textContent = origen.alt;
      lb.classList.add('is-on');
      document.body.style.overflow = 'hidden';
      lbX?.focus();
    }

    function cerrarLb() {
      if (!lb) return;
      lb.classList.remove('is-on');
      document.body.style.overflow = '';
      ultimoFoco?.focus();
      ultimoFoco = null;
    }

    sec.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const img = btn.querySelector('img');
        // Si aún no se ha resuelto el data-src, resolverlo antes de ampliar
        if (img?.dataset.src) {
          img.src = img.dataset.src;
          img.removeAttribute('data-src');
        }
        if (img) abrirLb(img, btn);
      });
    });

    lbX?.addEventListener('click', cerrarLb);
    lb?.addEventListener('click', (e) => {
      if (e.target === lb) cerrarLb();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lb?.classList.contains('is-on')) cerrarLb();
    });

    // ── Filtro por área ──
    const pastillas = sec.querySelectorAll<HTMLButtonElement>('[data-pastillas] .pastilla');
    const fugas = sec.querySelectorAll<HTMLElement>('.fuga');
    const barras = sec.querySelectorAll<HTMLElement>('.barra');
    const cifra = sec.querySelector<HTMLElement>('[data-cifra]');
    const pie = sec.querySelector<HTMLElement>('[data-pie]');
    const pieTodas = pie?.textContent || '';
    const plantillaArea = sec.dataset.plantillaArea || '';

    pastillas.forEach((p) => {
      p.addEventListener('click', () => {
        pastillas.forEach((x) => x.classList.remove('is-on'));
        p.classList.add('is-on');

        const area = p.dataset.area || 'all';
        let n = 0;

        fugas.forEach((f) => {
          const visible = area === 'all' || f.dataset.area === area;
          f.hidden = !visible;
          if (visible) n++;
        });

        barras.forEach((b) => {
          b.classList.toggle('is-dim', !(area === 'all' || b.dataset.area === area));
        });

        if (cifra) cifra.textContent = `${n * 2} %`;
        if (pie) {
          if (area === 'all') {
            pie.textContent = pieTodas;
          } else {
            const nombre = (p.childNodes[0]?.textContent || '').trim().toLowerCase();
            pie.textContent = plantillaArea.replace('{area}', nombre);
          }
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initFugas);
  initFugas();
</script>