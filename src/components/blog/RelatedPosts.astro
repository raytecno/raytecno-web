---
/**
 * Related Posts - Artículos relacionados
 * src/components/blog/RelatedPosts.astro
 */

import type { Lang } from '@/config/pages';
import type { BlogPostProcessed } from '@/lib/blog';

interface Props {
  posts: BlogPostProcessed[];
  lang: Lang;
}

const { posts, lang } = Astro.props;

const titles: Record<string, string> = {
  es: 'Artículos relacionados',
  en: 'Related articles',
  fr: 'Articles connexes',
  ca: 'Articles relacionats',
  'pt-br': 'Artigos relacionados',
};

const readT: Record<string, string> = {
  es: 'min lectura',
  en: 'min read',
  fr: 'min de lecture',
  ca: 'min lectura',
  'pt-br': 'min de leitura',
};

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString(
    lang === 'pt-br' ? 'pt-BR' : lang === 'ca' ? 'ca-ES' : `${lang}-${lang.toUpperCase()}`,
    { year: 'numeric', month: 'short', day: 'numeric' }
  );
}
---

<section class="related-posts">
  <h2>{titles[lang] || titles['es']}</h2>
  <div class="related-grid">
    {posts.map(post => (
      <a href={`/${lang}/blog/${post.slug}`} class="related-card">
        {post.featuredImage && (
          <div class="related-image">
            <img src={post.featuredImage} alt={post.title} loading="lazy" width="300" height="170" />
          </div>
        )}
        <div class="related-info">
          <span class="related-category">{post.category}</span>
          <h3>{post.title}</h3>
          <div class="related-meta">
            <time>{formatDate(post.date)}</time>
            <span>·</span>
            <span>{post.readingTime} {readT[lang] || readT['es']}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .related-posts {
    padding: 2rem 0;
    border-top: 1px solid #e5e7eb;
    margin-top: 2rem;
  }

  .related-posts h2 { font-size: 1.3rem; margin-bottom: 1.25rem; }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .related-card {
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .related-card:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.06); }

  .related-image { aspect-ratio: 16/9; overflow: hidden; }
  .related-image img { width: 100%; height: 100%; object-fit: cover; }

  .related-info { padding: 1rem; }
  .related-category {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    color: #c9a227;
    letter-spacing: 0.05em;
  }
  .related-info h3 { font-size: 0.95rem; margin: 0.4rem 0 0.5rem; line-height: 1.3; }
  .related-meta { display: flex; gap: 0.4rem; font-size: 0.7rem; color: #9ca3af; }
</style>
