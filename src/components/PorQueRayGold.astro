---
/**
 * PorQueRayGold.astro - Sección de diferenciadores
 *
 * TEMA CLARO/OSCURO (Septiembre 2026):
 * - La sección es una SUPERFICIE INVERTIDA (class="rg-inv"): oscura cuando la
 *   página es clara y clara cuando la página es oscura. Es el mismo color del
 *   menú, así que la banda deja de parecer "otra web" y rima con la cabecera.
 * - Dentro de .rg-inv, --rg-ink, --rg-soft, --rg-line y --rg-accent ya vienen
 *   invertidos: este CSS no necesita saber en qué tema está.
 * - Eliminado el bloque de "tema blanco en móvil". Era la causa del salto
 *   escritorio/móvil. El móvil ahora solo cambia tamaños y columnas.
 * - Fuera los literales: rgba(102,126,234,.x), #764ba2, #818cf8, #a5b4fc,
 *   #fbbf24, #f59e0b, #d97706, #334155, rgba(30,41,59,.5).
 *
 * CONTENIDO: los años estaban descuadrados (35 en español, 34 en el resto).
 * Desde 1990 son 36. Unificado en los cinco idiomas.
 */
import { type Lang, getPageUrl } from "@/config/pages";

interface Props {
