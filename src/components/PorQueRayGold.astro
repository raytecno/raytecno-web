const t = translations[lang] || translations.es;
const contactUrl = getPageUrl('contacto', lang);
---

<section class="porque-section rg-inv" id="porque">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">{t.badge}</span>
      <h2>{t.title}</h2>
      <p>{t.subtitle}</p>
      {lang === "es" && (
        <p class="porque-link">
          <a href={getPageUrl("queEsRayGold", lang)}
             data-ga="cta_click"
             data-ga-elemento="que_es_raygold"
             data-ga-ubicacion="home_porque">
            Qué es exactamente RayGold, y qué no es
          </a>
        </p>
      )}
    </div>

    <div class="diferenciadores-grid">
      <!-- Especialistas (featured) -->
      <div class="diferenciador-card featured">
        <div class="diferenciador-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2.5 9l9.5 12 9.5-12-3-6H5.5l-3 6z"/>
            <path d="M2.5 9h19M12 21V9M5.5 3l6.5 6 6.5-6"/>
          </svg>
        </div>
        <div class="diferenciador-content">
          <h3>{t.card1Title}</h3>
          <p>{t.card1Text}</p>
          <span class="diferenciador-stat">{t.card1Stat}</span>
        </div>
      </div>

      <!-- Control de metales -->
      <div class="diferenciador-card">
        <div class="diferenciador-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 1v4M12 19v4M1 12h4M19 12h4"/>
          </svg>
        </div>
        <div class="diferenciador-content">
          <h3>{t.card2Title}</h3>
          <p>{t.card2Text}</p>
          <span class="diferenciador-stat">{t.card2Stat}</span>
        </div>
      </div>

      <!-- Fabricación -->
      <div class="diferenciador-card">
        <div class="diferenciador-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2"/>
            <path d="M16 7V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v3"/>
            <rect x="6" y="11" width="4" height="4"/>
            <rect x="14" y="11" width="4" height="4"/>
          </svg>
        </div>
        <div class="diferenciador-content">
          <h3>{t.card3Title}</h3>
          <p>{t.card3Text}</p>
          <span class="diferenciador-stat">{t.card3Stat}</span>
        </div>
      </div>

      <!-- Soporte real -->
      <div class="diferenciador-card">
        <div class="diferenciador-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 00-3-3.87"/>
            <path d="M16 3.13a4 4 0 010 7.75"/>
          </svg>
        </div>
        <div class="diferenciador-content">
          <h3>{t.card4Title}</h3>
          <p>{t.card4Text}</p>
          <span class="diferenciador-stat">{t.card4Stat}</span>
        </div>
      </div>

      <!-- Cloud moderno -->
      <div class="diferenciador-card">
        <div class="diferenciador-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/>
          </svg>
        </div>
        <div class="diferenciador-content">
          <h3>{t.card5Title}</h3>
          <p>{t.card5Text}</p>
          <span class="diferenciador-stat">{t.card5Stat}</span>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="porque-cta">
      <p>{t.ctaText}</p>
      <a href={contactUrl} class="cta-button">{t.ctaButton}</a>
    </div>
  </div>
</section>

<style>
  /* ============================================
     Superficie invertida: el mismo color del menú
     ============================================ */
  .porque-section {
    padding: 5rem 1.5rem;
    /* el fondo lo pone .rg-inv */
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .porque-link {
    margin-top: 1rem !important;
    font-size: 0.95rem !important;
  }

  .porque-link a {
    color: var(--rg-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: color 0.2s ease;
  }

  .porque-link a:hover {
    color: var(--rg-ink);
  }

  .section-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--rg-accent-soft);
    color: var(--rg-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    border-radius: 50px;
    margin-bottom: 1rem;
  }

  .section-header h2 {
    font-family: var(--rg-display);
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--rg-ink);
    margin: 0 0 0.75rem;
  }

  .section-header p {
    color: var(--rg-soft);
    font-size: 1.1rem;
    margin: 0 auto;
    max-width: 600px;
  }

  .diferenciadores-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .diferenciador-card {
    background: color-mix(in srgb, var(--rg-ink) 6%, transparent);
    border: 1px solid var(--rg-line);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    gap: 1rem;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .diferenciador-card:hover {
    border-color: var(--rg-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--rg-sombra);
  }

  .diferenciador-card.featured {
    background: linear-gradient(
      135deg,
      var(--rg-accent-soft) 0%,
      color-mix(in srgb, var(--rg-ink) 6%, transparent) 100%
    );
    border-color: color-mix(in srgb, var(--rg-accent) 45%, transparent);
    grid-column: span 2;
  }

  .diferenciador-icon {
    width: 48px;
    height: 48px;
    min-width: 48px;
    background: linear-gradient(
      135deg,
      var(--rg-accent),
      color-mix(in srgb, var(--rg-accent) 55%, var(--rg-ink))
    );
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--rg-on-ink);
  }

  .diferenciador-icon svg {
    width: 24px;
    height: 24px;
  }

  .diferenciador-content {
    flex: 1;
  }

  .diferenciador-content h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--rg-ink);
    margin: 0 0 0.5rem;
  }

  .diferenciador-content p {
    font-size: 0.9rem;
    color: var(--rg-soft);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .diferenciador-stat {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--rg-accent-soft);
    color: var(--rg-accent);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 50px;
  }

  .porque-cta {
    text-align: center;
    margin-top: 3rem;
    padding: 2rem;
    background: color-mix(in srgb, var(--rg-ink) 5%, transparent);
    border: 1px solid var(--rg-line);
    border-radius: 16px;
  }

  .porque-cta p {
    color: var(--rg-ink);
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }

  .cta-button {
    display: inline-flex;
    padding: 0.875rem 1.75rem;
    background: var(--rg-accent);
    color: var(--rg-on-ink);
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--rg-sombra);
  }

  /* ============================================
     Móvil: solo tamaños y columnas.
     El color NO cambia (antes se volvía blanco).
     ============================================ */
  @media (max-width: 768px) {
    .porque-section {
      padding: 3rem 1rem;
    }

    .section-header h2 {
      font-size: 1.5rem;
    }

    .diferenciadores-grid {
      grid-template-columns: 1fr;
    }

    .diferenciador-card.featured {
      grid-column: span 1;
    }
  }
</style>