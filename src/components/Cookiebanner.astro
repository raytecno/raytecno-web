---
/**
 * CookieBanner.astro — Modal de consentimiento de cookies
 *
 * Consent Mode v2 + AEPD:
 * - Aceptar y Rechazar con el mismo peso visual (sin patrones oscuros)
 * - Rechazar es un solo clic, igual que aceptar
 * - Sin botón de cerrar: no elegir NO equivale a aceptar
 * - Elección persistida 12 meses en localStorage
 * - Reapertura desde el footer con window.openCookiePreferences()
 *
 * La restauración del consentimiento guardado NO vive aquí:
 * está en Analytics.astro, dentro del <head>, para llegar
 * dentro de la ventana de wait_for_update (500 ms).
 */
import { type Lang } from "@/config/pages";

interface Props {
  lang?: Lang;
  policyUrl?: string;
}

const { lang = "es", policyUrl } = Astro.props;

// Ajusta esta ruta si tu página de cookies usa otro slug por idioma
const cookiesUrl = policyUrl ?? `/${lang}/cookies`;

const t: Record<Lang, Record<string, string>> = {
  es: {
    title: "Cookies en RayGold",
    intro:
      "Usamos cookies propias y de terceros para entender cómo se usa la web y mejorarla. Puedes aceptarlas todas, rechazarlas todas o elegir por categoría.",
    accept: "Aceptar todas",
    reject: "Rechazar todas",
    settings: "Configurar",
    save: "Guardar preferencias",
    back: "Volver",
    policy: "Política de cookies",
    necessaryTitle: "Necesarias",
    necessaryDesc:
      "Imprescindibles para que la web funcione: idioma, seguridad y navegación. No se pueden desactivar.",
    always: "Siempre activas",
    analyticsTitle: "Analíticas",
    analyticsDesc:
      "Nos dicen qué páginas se visitan y cómo se navega, de forma agregada. Sin ellas no sabemos qué mejorar.",
    marketingTitle: "Marketing",
    marketingDesc:
      "Permiten medir la eficacia de nuestras campañas y mostrar contenido más relevante.",
  },
  ca: {
    title: "Galetes a RayGold",
    intro:
      "Fem servir galetes pròpies i de tercers per entendre com s'utilitza el web i millorar-lo. Pots acceptar-les totes, rebutjar-les totes o triar per categoria.",
    accept: "Acceptar-les totes",
    reject: "Rebutjar-les totes",
    settings: "Configurar",
    save: "Desar preferències",
    back: "Tornar",
    policy: "Política de galetes",
    necessaryTitle: "Necessàries",
    necessaryDesc:
      "Imprescindibles perquè el web funcioni: idioma, seguretat i navegació. No es poden desactivar.",
    always: "Sempre actives",
    analyticsTitle: "Analítiques",
    analyticsDesc:
      "Ens diuen quines pàgines es visiten i com es navega, de manera agregada. Sense elles no sabem què millorar.",
    marketingTitle: "Màrqueting",
    marketingDesc:
      "Permeten mesurar l'eficàcia de les nostres campanyes i mostrar contingut més rellevant.",
  },
  en: {
    title: "Cookies on RayGold",
    intro:
      "We use our own and third-party cookies to understand how the site is used and improve it. Accept all, reject all, or choose by category.",
    accept: "Accept all",
    reject: "Reject all",
    settings: "Customise",
    save: "Save preferences",
    back: "Back",
    policy: "Cookie policy",
    necessaryTitle: "Necessary",
    necessaryDesc:
      "Required for the site to work: language, security and navigation. These cannot be turned off.",
    always: "Always on",
    analyticsTitle: "Analytics",
    analyticsDesc:
      "Tell us which pages are visited and how people navigate, in aggregate. Without them we can't tell what to improve.",
    marketingTitle: "Marketing",
    marketingDesc:
      "Let us measure how our campaigns perform and show more relevant content.",
  },
  fr: {
    title: "Cookies sur RayGold",
    intro:
      "Nous utilisons des cookies internes et tiers pour comprendre l'usage du site et l'améliorer. Acceptez tout, refusez tout ou choisissez par catégorie.",
    accept: "Tout accepter",
    reject: "Tout refuser",
    settings: "Personnaliser",
    save: "Enregistrer les préférences",
    back: "Retour",
    policy: "Politique de cookies",
    necessaryTitle: "Nécessaires",
    necessaryDesc:
      "Indispensables au fonctionnement du site : langue, sécurité et navigation. Non désactivables.",
    always: "Toujours actifs",
    analyticsTitle: "Analytiques",
    analyticsDesc:
      "Indiquent quelles pages sont consultées et comment, de façon agrégée. Sans elles, impossible de savoir quoi améliorer.",
    marketingTitle: "Marketing",
    marketingDesc:
      "Permettent de mesurer l'efficacité de nos campagnes et d'afficher un contenu plus pertinent.",
  },
  "pt-br": {
    title: "Cookies no RayGold",
    intro:
      "Usamos cookies próprios e de terceiros para entender como o site é usado e melhorá-lo. Aceite todos, recuse todos ou escolha por categoria.",
    accept: "Aceitar todos",
    reject: "Recusar todos",
    settings: "Configurar",
    save: "Salvar preferências",
    back: "Voltar",
    policy: "Política de cookies",
    necessaryTitle: "Necessários",
    necessaryDesc:
      "Essenciais para o site funcionar: idioma, segurança e navegação. Não podem ser desativados.",
    always: "Sempre ativos",
    analyticsTitle: "Analíticos",
    analyticsDesc:
      "Mostram quais páginas são visitadas e como se navega, de forma agregada. Sem eles não sabemos o que melhorar.",
    marketingTitle: "Marketing",
    marketingDesc:
      "Permitem medir a eficácia das nossas campanhas e exibir conteúdo mais relevante.",
  },
