---
/**
 * CrmVitrina.astro — Portada: el CRM comercial en una vitrina con pestañas
 *
 * @file src/components/CrmVitrina.astro
 *
 * Octubre 2026. Una sola pantalla de alto:
 *   - cabecera (sello, titular, entradilla),
 *   - a la izquierda las pestañas; la activa despliega su frase y su texto,
 *   - a la derecha la captura entera (object-fit: contain), con lupa.
 *
 * Avance automático: cada pestaña tiene una línea de progreso a la izquierda.
 * Al acabar la animación pasa a la siguiente (animationend, no setInterval),
 * así que pausar es solo pausar la animación: al pasar el ratón, con el foco
 * dentro o con la sección fuera de pantalla. En cuanto el usuario elige una
 * pestaña, el avance automático se apaga para siempre en esa visita.
 * Con prefers-reduced-motion no hay avance automático.
 *
 * Textos: todos en el HTML del build (buscadores e IA). Vienen de i18n/crm.ts.
 *
 * Imágenes: no son el LCP (la sección está bajo el hero). La primera va con
 * loading="lazy"; el resto con data-src y se resuelven cuando la sección
 * se acerca a la pantalla, para que el cambio de pestaña sea instantáneo.
 *
 * Marco: adopta la proporción real de la captura visible (--ratio), igual que
 * la vitrina del hero. RATIO_INICIAL evita el salto mientras carga.
 *
 * FONDO OSCURO (Octubre 2026): la sección va siempre en azul noche, como
 * "¿Por qué RayGold?", para cortar la portada clara. Los tokens --rg-* se
 * redefinen DENTRO de .crm-vit (nunca en :root), así el resto del
 * componente no cambia y no se filtra nada al resto de la web. En tema
 * oscuro el fondo baja un tono más para seguir separándose de la página.
 *
 * Enlace a la página /crm: solo aparece si se pasa `urlDetalle`. Así este
 * componente se puede publicar antes de que exista la página.
 *   <CrmVitrina lang={lang} urlDetalle={getPageUrl('crm', lang)} />
 */
import type { Lang } from '@/config/pages';
import { getCrmTranslations } from '@/i18n/crm';

interface Props {
  lang?: Lang;
  urlDetalle?: string;
}

const { lang = 'es', urlDetalle } = Astro.props;
const t = getCrmTranslations(lang);
const v = t.vitrina;

const BLOB = 'https://raygoldstorage.blob.core.windows.net/web';
const pantallas = t.pantallas.map((p) => ({ ...p, url: `${BLOB}/${p.archivo}` }));

// Proporción provisional del marco hasta que carga la primera captura.
// Las capturas del ERP a pantalla completa rondan 2 / 1.
const RATIO_INICIAL = '2 / 1';

// Duración de cada pestaña en avance automático (ms)
const DURACION = 7000;
---

<section class="crm-vit" id="crm" style={`--cv-dur: ${DURACION}ms`}>
  <div class="cv-in">
    <!-- Cabecera -->
    <header class="cv-head">
      <span class="cv-sello"><i aria-hidden="true"></i>{v.sello}</span>
      <h2>
        {v.titulo}
        <em>{v.tituloEnfasis}</em>
      </h2>
      <p class="cv-lead">{v.lead}</p>
    </header>

    <div class="cv-grid">
      <!-- Pestañas -->
      <div class="cv-tabs" role="tablist" aria-label={v.pestanasLabel} aria-orientation="vertical">
        {pantallas.map((p, i) => (
          <div class:list={['cv-item', { 'is-on': i === 0 }]} role="none" data-item={i}>
            <span class="cv-bar" aria-hidden="true"></span>

            <button
              class="cv-tab"
              role="tab"
              id={`cv-tab-${p.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls="cv-panel"
              tabindex={i === 0 ? 0 : -1}
              data-tab={i}
            >
              <span class="cv-tab__t">{p.pestana}</span>
              <span class:list={['cv-chip', `cv-chip--${p.para}`]}>{v.para[p.para]}</span>
            </button>

            <div class="cv-desc">
              <div class="cv-desc__in">
                <p class="cv-desc__t">{p.titulo}</p>
                <p class="cv-desc__s">{p.texto}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Vitrina -->
      <figure
        class="cv-vitrina"
        id="cv-panel"
        role="tabpanel"
        aria-labelledby={`cv-tab-${pantallas[0].id}`}
      >
        <div class="cv-marco" style={`--ratio: ${RATIO_INICIAL}`}>
          {pantallas.map((p, i) =>
            i === 0 ? (
              <img
                src={p.url}
                alt={p.alt}
                class="cv-img is-on"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <img data-src={p.url} alt={p.alt} class="cv-img" decoding="async" />
            )
          )}
        </div>

        <!-- En móvil la descripción de la pestaña activa va aquí, bajo la captura -->
        <div class="cv-movil" aria-hidden="true" data-movil>
          <p class="cv-desc__t" data-movil-t>{pantallas[0].titulo}</p>
          <p class="cv-desc__s" data-movil-s>{pantallas[0].texto}</p>
        </div>

        <figcaption class="cv-pie">
          <span class="cv-pie__et">{v.etiquetaPantalla}</span>
          <button class="cv-ibtn" data-lupa data-tip={v.verPantalla} aria-label={v.verPantalla}>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <circle cx="8.8" cy="8.8" r="5.6"></circle>
              <path d="M13 13l4 4M8.8 6.6v4.4M6.6 8.8h4.4"></path>
            </svg>
          </button>
        </figcaption>
      </figure>
    </div>

    {urlDetalle && (
      <a class="cv-mas" href={urlDetalle}>
        {v.verMas}
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </a>
    )}
  </div>

  <!-- Visor a pantalla completa -->
  <div class="cv-lb" data-lb role="dialog" aria-modal="true" aria-label={v.verPantalla}>
    <button class="cv-lb__x" data-lb-x aria-label={v.cerrar}>
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M5 5l10 10M15 5L5 15"></path>
      </svg>
    </button>
    <figure class="cv-lb__fig">
      <img data-lb-img src="" alt="" />
      <figcaption data-lb-pie></figcaption>
    </figure>
  </div>
</section>

<style>
  .crm-vit {
    /* Color de identidad del módulo Comercial (fijo; tono claro para fondo oscuro) */
    --cv-mod: #2dd4bf;

    /* Paleta oscura fija de la sección: redefine los tokens solo aquí dentro */
    --cv-fondo: #0f172a;
    --rg-bg: var(--cv-fondo);
    --rg-ink: #f5f2ea;
    --rg-soft: rgba(245, 242, 234, 0.72);
    --rg-faint: rgba(245, 242, 234, 0.46);
    --rg-line: rgba(255, 255, 255, 0.12);
    --rg-panel: rgba(255, 255, 255, 0.04);
    --rg-accent: #c9a54a;
    --rg-accent-soft: rgba(201, 165, 74, 0.16);
    --rg-on-ink: #0f172a;
    --rg-sombra: rgba(0, 0, 0, 0.5);

    background: var(--rg-bg);
    color: var(--rg-ink);
    font-family: var(--rg-sans);
    padding: 88px 24px 96px;
  }

  /* En tema oscuro la página ya es azul noche: la sección baja un tono y
     se separa con filetes. Ajusta el selector si tu tema usa otra marca. */
  :global([data-theme='dark']) .crm-vit {
    --cv-fondo: #080d1a;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cv-in {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Cabecera ── */
  .cv-sello {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--rg-accent);
    background: var(--rg-accent-soft);
    padding: 7px 15px;
    border-radius: 999px;
  }
  .cv-sello i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cv-mod);
  }

  .cv-head h2 {
    margin: 20px 0 0;
    font-family: var(--rg-display);
    font-weight: 380;
    font-size: clamp(1.75rem, 3.6vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 24ch;
    text-wrap: balance;
  }
  .cv-head h2 em {
    font-style: italic;
    color: var(--rg-accent);
  }

  .cv-lead {
    margin: 18px 0 0;
    max-width: 62ch;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--rg-soft);
  }

  /* ── Rejilla ── */
  .cv-grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.5fr);
    gap: 48px;
    align-items: start;
  }

  /* ── Pestañas ── */
  .cv-tabs {
    display: flex;
    flex-direction: column;
  }

  .cv-item {
    position: relative;
    padding: 4px 0 4px 22px;
    cursor: pointer;
  }

  /* Línea de progreso a la izquierda */
  .cv-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--rg-line);
    border-radius: 2px;
    overflow: hidden;
  }
  .cv-bar::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 0;
    background: var(--rg-accent);
  }
  .cv-item.is-on .cv-bar::after {
    height: 100%;
  }
  .crm-vit.is-auto .cv-item.is-on .cv-bar::after {
    animation: cv-progreso var(--cv-dur) linear forwards;
  }
  .crm-vit.is-pausa .cv-item.is-on .cv-bar::after {
    animation-play-state: paused;
  }
  @keyframes cv-progreso {
    from {
      height: 0;
    }
    to {
      height: 100%;
    }
  }

  .cv-tab {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 0;
    border: 0;
    background: none;
    font-family: inherit;
    text-align: left;
    color: var(--rg-soft);
    cursor: pointer;
    transition: color 0.15s;
  }
  .cv-tab:focus-visible {
    outline: 2px solid var(--rg-accent);
    outline-offset: 2px;
    border-radius: 6px;
  }
  .cv-tab__t {
    font-family: var(--rg-display);
    font-size: 1.15rem;
    font-weight: 420;
    letter-spacing: -0.01em;
  }
  .cv-item:hover .cv-tab,
  .cv-item.is-on .cv-tab {
    color: var(--rg-ink);
  }

  .cv-chip {
    font-family: var(--rg-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid var(--rg-line);
    color: var(--rg-faint);
    white-space: nowrap;
  }
  .cv-chip--vendedor {
    color: var(--cv-mod);
    border-color: color-mix(in srgb, var(--cv-mod) 35%, transparent);
    background: color-mix(in srgb, var(--cv-mod) 8%, transparent);
  }

  /* Descripción: se despliega solo en la pestaña activa */
  .cv-desc {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }
  .cv-item.is-on .cv-desc {
    grid-template-rows: 1fr;
  }
  .cv-desc__in {
    min-height: 0;
    overflow: hidden;
  }
  .cv-desc__t {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--rg-ink);
    line-height: 1.45;
  }
  .cv-desc__s {
    margin: 6px 0 0;
    font-size: 14.5px;
    color: var(--rg-soft);
    line-height: 1.55;
    padding-bottom: 14px;
  }

  /* ── Vitrina ── */
  .cv-vitrina {
    margin: 0;
    min-width: 0;
  }

  .cv-marco {
    position: relative;
    aspect-ratio: var(--ratio, 2 / 1);
    background: var(--rg-panel);
    border: 1px solid var(--rg-line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 18px 50px var(--rg-sombra);
    cursor: zoom-in;
    transition: aspect-ratio 0.5s ease;
  }

  .cv-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .cv-img.is-on {
    opacity: 1;
  }

  .cv-movil {
    display: none;
  }

  .cv-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 4px 0;
  }
  .cv-pie__et {
    font-family: var(--rg-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rg-faint);
  }

  /* ── Botón solo icono ── */
  .cv-ibtn {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--rg-soft);
    cursor: pointer;
    position: relative;
    flex: 0 0 auto;
    transition: background 0.15s, color 0.15s;
  }
  .cv-ibtn:hover {
    background: var(--rg-accent-soft);
    color: var(--rg-accent);
  }
  .cv-ibtn svg {
    width: 16px;
    height: 16px;
  }
  .cv-ibtn[data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    right: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--rg-ink);
    color: var(--rg-on-ink);
    font-size: 11.5px;
    padding: 5px 9px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s;
    z-index: 5;
  }
  .cv-ibtn:hover::after,
  .cv-ibtn:focus-visible::after {
    opacity: 1;
  }

  /* ── Enlace a la página /crm ── */
  .cv-mas {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 40px;
    padding: 11px 18px 11px 20px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    color: var(--rg-ink);
    background: var(--rg-accent-soft);
    border: 1px solid transparent;
    transition: border-color 0.15s;
  }
  .cv-mas:hover {
    border-color: var(--rg-accent);
  }
  .cv-mas svg {
    width: 15px;
    height: 15px;
    color: var(--rg-accent);
    transition: transform 0.2s;
  }
  .cv-mas:hover svg {
    transform: translateX(3px);
  }

  /* ── Visor a pantalla completa ── */
  .cv-lb {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(10, 12, 18, 0.92);
    display: none;
    place-items: center;
    padding: 40px 28px 28px;
  }
  .cv-lb.is-on {
    display: grid;
  }
  .cv-lb__fig {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 100%;
  }
  .cv-lb img {
    max-width: min(1600px, 96vw);
    max-height: 84vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.5);
  }
  .cv-lb figcaption {
    color: rgba(255, 255, 255, 0.72);
    font-size: 13px;
    text-align: center;
    max-width: 60ch;
  }
  .cv-lb__x {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
    transition: background 0.15s;
  }
  .cv-lb__x:hover {
    background: rgba(255, 255, 255, 0.24);
  }
  .cv-lb__x svg {
    width: 18px;
    height: 18px;
  }

  /* ── Responsive: pestañas en fila de pastillas, texto bajo la captura ── */
  @media (max-width: 980px) {
    .crm-vit {
      padding: 64px 20px 72px;
    }
    .cv-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      margin-top: 32px;
    }
    .cv-tabs {
      flex-direction: row;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      margin: 0 -20px;
      padding: 0 20px 4px;
    }
    .cv-tabs::-webkit-scrollbar {
      display: none;
    }
    .cv-item {
      padding: 0;
      flex: 0 0 auto;
    }
    .cv-bar,
    .cv-desc,
    .cv-chip {
      display: none;
    }
    .cv-tab {
      padding: 8px 15px;
      border-radius: 999px;
      background: var(--rg-accent-soft);
      white-space: nowrap;
    }
    .cv-tab__t {
      font-family: var(--rg-sans);
      font-size: 13.5px;
      font-weight: 500;
    }
    .cv-item.is-on .cv-tab {
      background: var(--rg-ink);
      color: var(--rg-on-ink);
    }
    .cv-movil {
      display: block;
      padding: 16px 2px 0;
    }
    .cv-movil .cv-desc__s {
      padding-bottom: 0;
    }
    .cv-ibtn[data-tip]::after {
      display: none;
    }
    .cv-lb {
      padding: 56px 12px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-img,
    .cv-marco,
    .cv-desc,
    .cv-mas svg {
      transition: none;
    }
  }
</style>

<script>
  function initCrmVitrina() {
    const sec = document.querySelector<HTMLElement>('.crm-vit');
    if (!sec || sec.dataset.listo === '1') return;
    sec.dataset.listo = '1';

    const items = Array.from(sec.querySelectorAll<HTMLElement>('[data-item]'));
    const tabs = Array.from(sec.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const imgs = Array.from(sec.querySelectorAll<HTMLImageElement>('.cv-img'));
    const marco = sec.querySelector<HTMLElement>('.cv-marco');
    const panel = sec.querySelector<HTMLElement>('#cv-panel');
    const grid = sec.querySelector<HTMLElement>('.cv-grid');
    const movilT = sec.querySelector<HTMLElement>('[data-movil-t]');
    const movilS = sec.querySelector<HTMLElement>('[data-movil-s]');
    if (items.length === 0 || imgs.length === 0) return;

    const lento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actual = 0;

    // ── Imágenes diferidas ──
    function resolver(img: HTMLImageElement) {
      if (img.dataset.src) {
        img.src = img.dataset.src;
        img.removeAttribute('data-src');
      }
    }

    // ── El marco adopta la proporción de la captura visible ──
    function ajustarMarco(img: HTMLImageElement) {
      if (!marco || !img.naturalWidth || !img.naturalHeight) return;
      marco.style.setProperty('--ratio', `${img.naturalWidth} / ${img.naturalHeight}`);
    }
    imgs.forEach((img, i) => {
      if (img.complete && i === actual) ajustarMarco(img);
      img.addEventListener('load', () => {
        if (i === actual) ajustarMarco(img);
      });
    });

    // ── Mostrar una pestaña ──
    function mostrar(i: number, enfocar = false) {
      const siguiente = (i + items.length) % items.length;

      items[actual].classList.remove('is-on');
      tabs[actual].setAttribute('aria-selected', 'false');
      tabs[actual].tabIndex = -1;
      imgs[actual].classList.remove('is-on');

      actual = siguiente;

      // Reiniciar la animación de progreso aunque se repita la misma pestaña
      void items[actual].offsetWidth;
      items[actual].classList.add('is-on');
      tabs[actual].setAttribute('aria-selected', 'true');
      tabs[actual].tabIndex = 0;
      if (enfocar) tabs[actual].focus();

      resolver(imgs[actual]);
      imgs[actual].classList.add('is-on');
      ajustarMarco(imgs[actual]);

      panel?.setAttribute('aria-labelledby', tabs[actual].id);

      const desc = items[actual];
      if (movilT) movilT.textContent = desc.querySelector('.cv-desc__t')?.textContent || '';
      if (movilS) movilS.textContent = desc.querySelector('.cv-desc__s')?.textContent || '';

      // En móvil, que la pastilla activa quede a la vista
      if (window.matchMedia('(max-width: 980px)').matches) {
        tabs[actual].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: lento ? 'auto' : 'smooth' });
      }
    }

    // ── Elección del usuario: apaga el avance automático ──
    function elegir(i: number, enfocar = false) {
      sec!.classList.remove('is-auto');
      if (i !== actual) mostrar(i, enfocar);
    }

    items.forEach((item, i) => {
      item.addEventListener('click', () => elegir(i));
    });

    tabs.forEach((tab) => {
      tab.addEventListener('keydown', (e) => {
        const teclas: Record<string, number> = {
          ArrowDown: actual + 1,
          ArrowRight: actual + 1,
          ArrowUp: actual - 1,
          ArrowLeft: actual - 1,
          Home: 0,
          End: items.length - 1,
        };
        if (e.key in teclas) {
          e.preventDefault();
          sec!.classList.remove('is-auto');
          mostrar(teclas[e.key], true);
        }
      });
    });

    // ── Avance automático (animationend de la línea de progreso) ──
    if (!lento && items.length > 1) {
      sec.classList.add('is-auto');
      items.forEach((item, i) => {
        item.querySelector('.cv-bar')?.addEventListener('animationend', () => {
          if (i === actual && sec.classList.contains('is-auto')) mostrar(actual + 1);
        });
      });
    }

    // Pausa al pasar el ratón o con el foco dentro de la rejilla
    let raton = false;
    let foco = false;
    let fuera = true;
    function pausa() {
      sec!.classList.toggle('is-pausa', raton || foco || fuera);
    }
    grid?.addEventListener('mouseenter', () => ((raton = true), pausa()));
    grid?.addEventListener('mouseleave', () => ((raton = false), pausa()));
    grid?.addEventListener('focusin', () => ((foco = true), pausa()));
    grid?.addEventListener('focusout', () => ((foco = false), pausa()));

    // Fuera de pantalla: pausa. Al acercarse: resolver todas las capturas.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          fuera = !e.isIntersecting;
          pausa();
        },
        { threshold: 0.25 }
      ).observe(sec);

      const precarga = new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) {
            imgs.forEach(resolver);
            precarga.disconnect();
          }
        },
        { rootMargin: '400px 0px' }
      );
      precarga.observe(sec);
    } else {
      fuera = false;
      pausa();
      imgs.forEach(resolver);
    }
    pausa();

    // ── Visor a pantalla completa ──
    const lb = sec.querySelector<HTMLElement>('[data-lb]');
    const lbImg = sec.querySelector<HTMLImageElement>('[data-lb-img]');
    const lbPie = sec.querySelector<HTMLElement>('[data-lb-pie]');
    const lbX = sec.querySelector<HTMLButtonElement>('[data-lb-x]');
    const lupa = sec.querySelector<HTMLButtonElement>('[data-lupa]');
    let ultimoFoco: HTMLElement | null = null;

    function abrirLb() {
      if (!lb || !lbImg) return;
      const img = imgs[actual];
      resolver(img);
      ultimoFoco = document.activeElement as HTMLElement | null;
      lbImg.src = img.currentSrc || img.src;
      lbImg.alt = img.alt;
      if (lbPie) lbPie.textContent = img.alt;
      lb.classList.add('is-on');
      document.body.style.overflow = 'hidden';
      raton = true;
      pausa();
      lbX?.focus();
    }
    function cerrarLb() {
      if (!lb) return;
      lb.classList.remove('is-on');
      document.body.style.overflow = '';
      raton = false;
      pausa();
      ultimoFoco?.focus();
      ultimoFoco = null;
    }
    lupa?.addEventListener('click', abrirLb);
    marco?.addEventListener('click', abrirLb);
    lbX?.addEventListener('click', cerrarLb);
    lb?.addEventListener('click', (e) => {
      if (e.target === lb) cerrarLb();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lb?.classList.contains('is-on')) cerrarLb();
    });
  }

  document.addEventListener('astro:page-load', initCrmVitrina);
  initCrmVitrina();
</script>
