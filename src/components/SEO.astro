// ============================================
// SCHEMA.ORG - BREADCRUMB
// [13] Etiquetas legibles + posibilidad de sobrescribirlas por prop
// ============================================
function prettifySegment(segment: string): string {
  const fixed = SEGMENT_FIXES[segment.toLowerCase()];
  if (fixed) return fixed;
  const words = segment.replace(/-/g, " ");
  return words.charAt(0).toUpperCase() + words.slice(1);
}

const pathSegments = currentPath
  .split("/")
  .filter(Boolean)
  .filter(s => !["es", "en", "fr", "ca", "pt-br"].includes(s));

const autoBreadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": config.homeLabel,
    "item": `${siteDomain}/${lang}`,
  },
  ...pathSegments.map((segment, index) => ({
    "@type": "ListItem",
    "position": index + 2,
    "name": prettifySegment(segment),
    "item": `${siteDomain}/${lang}/${pathSegments.slice(0, index + 1).join("/")}`,
  })),
];

const customBreadcrumbItems = breadcrumbs?.map((crumb, index) => ({
  "@type": "ListItem",
  "position": index + 1,
  "name": crumb.name,
  ...(crumb.url && { "item": buildHreflangUrl(crumb.url) }),
}));

const schemaBreadcrumb = {
  "@type": "BreadcrumbList",
  "@id": breadcrumbId,
  "itemListElement": customBreadcrumbItems || autoBreadcrumbItems,
};

// ============================================
