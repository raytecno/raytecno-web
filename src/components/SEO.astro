// ============================================
// PROPS DEL COMPONENTE
// ============================================
interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  /** Texto alternativo de la imagen OG. Describe la IMAGEN, no la página. */
  imageAlt?: string;
  type?: "website" | "article" | "product";
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  alternateUrls?: { lang: Lang; url: string }[];
  /** [13] Migas personalizadas. Si se pasan, sustituyen a las automáticas. */
  breadcrumbs?: { name: string; url?: string }[];
}

const {
  lang = "es",
  title,
  description,
  keywords,
  image,
  imageAlt,
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  alternateUrls = [],
  breadcrumbs,
} = Astro.props;

// ============================================
// VARIABLES CALCULADAS
// ============================================
const config = LANG_CONFIG[lang] || LANG_CONFIG.es;

// Siempre usar el dominio principal .es
const siteDomain = COMPANY.primaryDomain;

// ============================================
// FUNCIÓN HELPER: Eliminar trailing slash
// ============================================
function removeTrailingSlash(url: string): string {
  if (url === '/' || url.endsWith('://')) return url;
  return url.endsWith('/') ? url.slice(0, -1) : url;
}

// ============================================
// URL CANONICAL - CORREGIDO para build estático
//
// Problema: Astro.url.pathname en build estático a veces
// devuelve "/" en vez del path real para rutas dinámicas [lang].
//
// Solución: Usar alternateUrls[lang].url como fuente de verdad
// cuando está disponible.
// ============================================
function getCanonicalPath(): string {
  const currentLangAlt = alternateUrls.find(alt => alt.lang === lang);
  if (currentLangAlt?.url) {
    if (currentLangAlt.url.startsWith('http')) {
      try {
        const urlObj = new URL(currentLangAlt.url);
        return removeTrailingSlash(urlObj.pathname);
      } catch {
        return removeTrailingSlash(currentLangAlt.url);
      }
    }
    return removeTrailingSlash(currentLangAlt.url);
  }

  let path = Astro.url.pathname;
  if (path.length > 1 && path.endsWith('/')) {
    path = path.slice(0, -1);
  }
  return path;
}

const currentPath = getCanonicalPath();
const canonicalUrl = `${siteDomain}${currentPath}`;

// ============================================
// TÍTULO - [1] Sin duplicar la marca
// ============================================
const fullTitle = title
  ? (BRAND_PATTERN.test(title) ? title : `${title} | ${COMPANY.name}`)
  : config.defaultTitle;

// Aviso SOLO en desarrollo: Google muestra ~60 caracteres
if (import.meta.env.DEV && fullTitle.length > MAX_TITLE_LENGTH) {
  console.warn(
    `[SEO] Título de ${fullTitle.length} car. (recomendado <= ${MAX_TITLE_LENGTH}) en ${currentPath}\n      "${fullTitle}"`
  );
}

// Descripción
const finalDescription = description || config.defaultDescription;

// Aviso SOLO en desarrollo: Google corta la descripción sobre los 160 car.
if (import.meta.env.DEV && finalDescription.length > 160) {
  console.warn(
    `[SEO] Descripción de ${finalDescription.length} car. (se cortará en ~160) en ${currentPath}`
  );
}

// Keywords - NO se emiten como meta tag (Google las ignora desde 2009).
// Se conservan como documentación interna de la intención de cada idioma.
const finalKeywords = keywords || config.defaultKeywords;

// Imagen OG
const ogImage = image
  ? (image.startsWith("http") ? image : `${siteDomain}${image}`)
  : `${siteDomain}${COMPANY.defaultOgImage}`;

// [3] Alt de la imagen OG: describe la imagen, no repite el título
const ogImageAlt = imageAlt || config.ogImageAlt;

// Logo absoluto
const logoUrl = `${siteDomain}${COMPANY.logo}`;

// [9] Fecha de modificación: la de la página, o la revisión del sitio.
// Nunca la fecha del build.
const finalModified = modifiedTime || SITE_LAST_UPDATED;

// ============================================
// FUNCIÓN HELPER: Normalizar URL para hreflang
// ============================================
function buildHreflangUrl(altUrl: string): string {
  if (altUrl.startsWith('http')) {
    return removeTrailingSlash(altUrl);
  }
  const cleanPath = removeTrailingSlash(altUrl);
  return `${siteDomain}${cleanPath}`;
}

// ============================================
// FILTRAR ALTERNATE URLS
// Las páginas noindex NO generan hreflang
// ============================================
const indexableAlternateUrls = noindex ? [] : alternateUrls;

// ============================================
// [10] LOCALES ALTERNATIVOS PARA OPEN GRAPH
// Solo los idiomas que esta página tiene de verdad.
// Si la página no declara alternateUrls, se asume que existe en todos.
// ============================================
const ogAlternateLocales = (
  alternateUrls.length > 0
    ? alternateUrls.filter(alt => alt.lang !== lang).map(alt => LANG_CONFIG[alt.lang]?.locale)
    : Object.entries(LANG_CONFIG).filter(([code]) => code !== lang).map(([_, conf]) => conf.locale)
).filter(Boolean);

// ============================================
// [4] X-DEFAULT
// ============================================
function getXDefaultUrl(): string {
  const englishAlt = alternateUrls.find(alt => alt.lang === 'en');
  if (englishAlt) {
    return buildHreflangUrl(englishAlt.url);
  }
  return `${siteDomain}/en`;
}

const xDefaultUrl = getXDefaultUrl();

// ============================================
// [7] IDENTIFICADORES ESTABLES DEL GRAFO
