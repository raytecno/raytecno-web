// distintas que se parecen. Es lo que permite que un buscador consolide
// "Raytecno BCN SL" y "RayGold" en una sola ficha.
// ============================================
const ORG_ID = `${siteDomain}/#organization`;
const SITE_ID = `${siteDomain}/#website`;
const SOFTWARE_ID = `${siteDomain}/#raygold`;
const pageId = `${canonicalUrl}#webpage`;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;

// ============================================
// SCHEMA.ORG - ORGANIZATION
// ============================================
const schemaOrganization = {
  "@type": "Organization",
  "@id": ORG_ID,
  "name": COMPANY.legalName,
  "alternateName": ["RayGold", "RayGold ERP", "Raytecno", "Raytecno BCN"],
  "url": COMPANY.primaryDomain,
  "logo": {
    "@type": "ImageObject",
    "url": logoUrl,
