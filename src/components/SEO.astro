const config = LANG_CONFIG[lang] || LANG_CONFIG.es;
const siteDomain = COMPANY.primaryDomain;

function removeTrailingSlash(url: string): string {
  if (url === '/' || url.endsWith('://')) return url;
  return url.endsWith('/') ? url.slice(0, -1) : url;
}

// ============================================
// URL CANONICAL - CORREGIDO para build estático
// ============================================
function getCanonicalPath(): string {
  const currentLangAlt = alternateUrls.find(alt => alt.lang === lang);
  if (currentLangAlt?.url) {
    if (currentLangAlt.url.startsWith('http')) {
      try {
        const urlObj = new URL(currentLangAlt.url);
        return removeTrailingSlash(urlObj.pathname);
      } catch {
        return removeTrailingSlash(currentLangAlt.url);
      }
    }
    return removeTrailingSlash(currentLangAlt.url);
  }

  let path = Astro.url.pathname;
  if (path.length > 1 && path.endsWith('/')) {
    path = path.slice(0, -1);
  }
  return path;
}

const currentPath = getCanonicalPath();
const canonicalUrl = `${siteDomain}${currentPath}`;

// ============================================
// [17] TRADUCCIONES DERIVADAS DE pages.ts
// Misma lógica que el sitemap en astro.config.mjs.
// ============================================
type AltGroup = { source: string; key: string; urls: Record<Lang, string> };

function buildAltIndex(): Map<string, AltGroup> {
  const index = new Map<string, AltGroup>();

  const register = (
    source: string,
    key: string,
    build: (l: Lang) => string,
    allowLangRoot = false,
  ) => {
    const urls = {} as Record<Lang, string>;
    for (const l of supportedLangs) {
      const path = removeTrailingSlash(build(l));
      // Las funciones de pages.ts devuelven /{lang} cuando falta un slug
      if (!allowLangRoot && path === `/${l}`) return;
      urls[l] = path;
    }
    const group = { source, key, urls };
    for (const path of Object.values(urls)) index.set(path, group);
  };

  for (const key of Object.keys(pageSlugs)) register("page", key, (l) => getPageUrl(key, l), key === "home");
  for (const key of Object.keys(moduloSlugs)) register("modulo", key, (l) => getModuloUrl(key, l));
  for (const key of Object.keys(toolSlugs)) register("tool", key, (l) => getToolUrl(key, l));
  for (const key of Object.keys(legalSlugs)) register("legal", key, (l) => getLegalUrl(key, l));

  return index;
}

const BLOG_RE = /^\/(es|en|fr|ca|pt-br)(\/blog(?:\/.*)?)$/;

function getAltGroup(path: string): AltGroup | null {
  const group = buildAltIndex().get(path);
  if (group) return group;
  const m = path.match(BLOG_RE);
  if (m) {
    const urls = Object.fromEntries(supportedLangs.map(l => [l, `/${l}${m[2]}`])) as Record<Lang, string>;
    return { source: "blog", key: m[2], urls };
  }
  return null;
}

const altGroup = getAltGroup(currentPath);

