---
/**
 * VideoDemo.astro - Sección de video demo para RayGold
 * Con soporte multiidioma y tema adaptativo móvil
 * Reproductor: YouTube (facade + IFrame API + eventos GA4 manuales)
 *
 * TEMA CLARO/OSCURO (Septiembre 2026):
 * - Solo tokens --rg-. Fuera los degradados #0a0a0f/#12121a, el violeta
 *   #8b5cf6/#a78bfa/#6366f1/#ec4899 y los white literales.
 * - Fuera el bloque "MÓVIL: tema blanco": en móvil solo quedan ajustes de
 *   layout, el color lo pone el tema en todos los anchos.
 * - .video-frame y .video-player siguen siendo oscuros a propósito (el vídeo
 *   lo es), pero con un negro fijo propio, no con tokens de texto.
 * - Marcado, traducciones y el <script> del reproductor sin tocar.
 */
import { type Lang, getPageUrl } from "@/config/pages";

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

// Configuración de video (YouTube)
const videoType = "youtube";
const youtubeId = "DEg5bo16s2Y";
const posterSrc = "https://raygoldstorage.blob.core.windows.net/web/Video_RayGold_poster.jpg";

// Traducciones
const translations: Record<Lang, {
  badge: string;
  titleStart: string;
  titleHighlight: string;
  subtitle: string;
  playText: string;
  videoAlt: string;
  feature1Value: string;
  feature1Label: string;
  feature2Value: string;
  feature2Label: string;
  feature3Value: string;
  feature3Label: string;
  ctaText: string;
  ctaButton: string;
}> = {
  es: {
    badge: "Ver en acción",
    titleStart: "Descubre RayGold en",
    titleHighlight: "90 segundos",
    subtitle: "Un recorrido por las funcionalidades que transformarán la gestión de tu joyería",
    playText: "Ver demostración",
    videoAlt: "Demo de RayGold ERP",
    feature1Value: "90 seg",
    feature1Label: "de demo",
    feature2Value: "8 módulos",
    feature2Label: "en acción",
    feature3Value: "100%",
    feature3Label: "joyería",
    ctaText: "¿Te gustaría ver una demo personalizada para tu negocio?",
    ctaButton: "Solicitar demo gratuita"
  },
  en: {
    badge: "See it in action",
    titleStart: "Discover RayGold in",
    titleHighlight: "90 seconds",
    subtitle: "A tour of the features that will transform your jewelry business management",
    playText: "Watch demo",
    videoAlt: "RayGold ERP Demo",
    feature1Value: "90 sec",
    feature1Label: "demo",
    feature2Value: "8 modules",
    feature2Label: "in action",
    feature3Value: "100%",
    feature3Label: "jewelry",
    ctaText: "Would you like to see a personalized demo for your business?",
    ctaButton: "Request free demo"
  },
  fr: {
    badge: "Voir en action",
    titleStart: "Découvrez RayGold en",
    titleHighlight: "90 secondes",
    subtitle: "Une visite des fonctionnalités qui transformeront la gestion de votre bijouterie",
    playText: "Voir la démo",
    videoAlt: "Démo RayGold ERP",
    feature1Value: "90 sec",
    feature1Label: "de démo",
    feature2Value: "8 modules",
    feature2Label: "en action",
    feature3Value: "100%",
    feature3Label: "bijouterie",
    ctaText: "Souhaitez-vous voir une démo personnalisée pour votre entreprise?",
    ctaButton: "Demander une démo gratuite"
  },
  ca: {
    badge: "Veure en acció",
    titleStart: "Descobreix RayGold en",
    titleHighlight: "90 segons",
    subtitle: "Un recorregut per les funcionalitats que transformaran la gestió de la teva joieria",
    playText: "Veure demostració",
    videoAlt: "Demo de RayGold ERP",
    feature1Value: "90 seg",
    feature1Label: "de demo",
    feature2Value: "8 mòduls",
    feature2Label: "en acció",
    feature3Value: "100%",
    feature3Label: "joieria",
    ctaText: "T'agradaria veure una demo personalitzada per al teu negoci?",
    ctaButton: "Sol·licitar demo gratuïta"
  },
  "pt-br": {
    badge: "Veja em ação",
    titleStart: "Descubra o RayGold em",
    titleHighlight: "90 segundos",
    subtitle: "Um tour pelas funcionalidades que transformarão a gestão da sua joalheria",
    playText: "Ver demonstração",
    videoAlt: "Demo do RayGold ERP",
    feature1Value: "90 seg",
    feature1Label: "de demo",
    feature2Value: "8 módulos",
    feature2Label: "em ação",
    feature3Value: "100%",
    feature3Label: "joalheria",
    ctaText: "Gostaria de ver uma demo personalizada para o seu negócio?",
    ctaButton: "Solicitar demo gratuita"
  }
};

const t = translations[lang] || translations.es;
const contactUrl = getPageUrl('contacto', lang);
---

<section class="video-section" id="demo">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <span class="section-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        {t.badge}
      </span>
      <h2 class="section-title">
        {t.titleStart} 
        <span class="gradient-text">{t.titleHighlight}</span>
      </h2>
      <p class="section-subtitle">{t.subtitle}</p>
    </div>

    <!-- Video Container -->
    <div class="video-wrapper">
      <div class="video-frame">
        <div class="glow-effect"></div>
        
        <div
          class="video-player"
          id="videoPlayer"
          data-video-id={youtubeId}
          data-video-title={t.videoAlt}
          data-video-provider={videoType}
        >
          <div class="video-poster" id="videoPoster">
            <img 
              src={posterSrc} 
              alt={t.videoAlt}
              class="poster-image"
              loading="lazy"
              onerror="this.style.display='none'"
            />
            <div class="poster-overlay">
              <button class="play-button" id="playButton" type="button" aria-label={t.playText}>
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
              <span class="play-text">{t.playText}</span>
            </div>
          </div>

          <!-- El iframe de YouTube se inserta aquí al pulsar play -->
          <div class="video-embed" id="ytMount"></div>
        </div>
      </div>

      <!-- Features bajo el video -->
      <div class="video-features">
        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="feature-text">
            <span class="feature-value">{t.feature1Value}</span>
            <span class="feature-label">{t.feature1Label}</span>
          </div>
        </div>
        
        <div class="feature-divider"></div>
        
        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div class="feature-text">
            <span class="feature-value">{t.feature2Value}</span>
            <span class="feature-label">{t.feature2Label}</span>
          </div>
        </div>
        
        <div class="feature-divider"></div>
        
        <div class="feature-item">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="feature-text">
            <span class="feature-value">{t.feature3Value}</span>
            <span class="feature-label">{t.feature3Label}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="video-cta">
      <p class="cta-text">{t.ctaText}</p>
      <a href={contactUrl}
        class="cta-button"
        data-ga="contacto_click"
        data-ga-canal="pagina_contacto"
        data-ga-elemento="solicitar_demo"
        data-ga-ubicacion="video_demo"
      >
        {t.ctaButton}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* ============================================
     Un solo tema, el que marque --rg-*
     ============================================ */
  .video-section {
    /* Negro del marco del vídeo: fijo a propósito, el vídeo también lo es */
    --video-negro: #0b0b10;

    padding: 100px 0;
    background: var(--rg-sup2);
    color: var(--rg-ink);
    position: relative;
    overflow: hidden;
    transition: background 0.25s ease, color 0.25s ease;
  }

  /* Trama de puntos muy tenue, derivada del acento */
  .video-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(
      color-mix(in srgb, var(--rg-accent) 18%, transparent) 1px,
      transparent 1px
    );
    background-size: 40px 40px;
    opacity: 0.5;
    pointer-events: none;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--rg-accent-soft);
    border: 1px solid color-mix(in srgb, var(--rg-accent) 35%, transparent);
    color: var(--rg-accent);
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .section-title {
    font-family: var(--rg-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--rg-ink);
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .gradient-text {
    color: var(--rg-accent);
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--rg-soft);
    max-width: 500px;
    margin: 0 auto;
  }

  .video-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .video-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--video-negro);
    border: 1px solid var(--rg-line);
    box-shadow: 0 24px 48px -20px var(--rg-sombra);
  }

  .glow-effect {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--rg-accent) 12%, transparent) 0%,
      transparent 50%
    );
    pointer-events: none;
    z-index: 0;
  }

  .video-player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--video-negro);
  }

  .video-poster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    cursor: pointer;
  }

  .poster-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(11, 11, 16, 0.65) 0%, rgba(11, 11, 16, 0.35) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    transition: background 0.3s ease;
  }

  .video-poster:hover .poster-overlay {
    background: linear-gradient(135deg, rgba(11, 11, 16, 0.55) 0%, rgba(11, 11, 16, 0.25) 100%);
  }

  .play-button {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--rg-accent);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--rg-on-ink);
    transition: transform 0.3s ease, background 0.3s ease;
    box-shadow: 0 10px 40px color-mix(in srgb, var(--rg-accent) 35%, transparent);
    animation: pulse-play 2.4s ease-in-out infinite;
  }

  @keyframes pulse-play {
    0%, 100% {
      box-shadow:
        0 10px 40px color-mix(in srgb, var(--rg-accent) 35%, transparent),
        0 0 0 0 color-mix(in srgb, var(--rg-accent) 40%, transparent);
    }
    50% {
      box-shadow:
        0 10px 40px color-mix(in srgb, var(--rg-accent) 35%, transparent),
        0 0 0 20px transparent;
    }
  }

  .play-button:hover {
    transform: scale(1.08);
  }

  .play-button:focus-visible {
    outline: 3px solid var(--rg-accent);
    outline-offset: 4px;
  }

  .play-button svg {
    width: 32px;
    height: 32px;
    margin-left: 4px;
  }

  .play-text {
    color: #fff;
    font-size: 1rem;
    font-weight: 500;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
  }

  /* Contenedor del iframe de YouTube */
  .video-embed {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .video-embed :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .video-poster.hidden {
    display: none;
  }

  .video-features {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    padding: 20px 24px;
    margin-top: 12px;
    background: var(--rg-panel);
    border: 1px solid var(--rg-line);
    border-radius: 14px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .feature-icon {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--rg-accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-icon svg {
    width: 20px;
    height: 20px;
    color: var(--rg-accent);
  }

  .feature-text {
    display: flex;
    flex-direction: column;
  }

  .feature-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--rg-ink);
  }

  .feature-label {
    font-size: 0.75rem;
    color: var(--rg-faint);
  }

  .feature-divider {
    width: 1px;
    height: 32px;
    background: var(--rg-line);
  }

  .video-cta {
    text-align: center;
    margin-top: 48px;
  }

  .cta-text {
    color: var(--rg-soft);
    margin: 0 0 20px 0;
    font-size: 1rem;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--rg-ink);
    color: var(--rg-on-ink);
    padding: 13px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .cta-button:hover {
    background: var(--rg-accent);
    color: var(--rg-on-ink);
  }

  .cta-button svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .cta-button:hover svg {
    transform: translateX(4px);
  }

  /* ============================================
     Móvil: solo layout, el color lo pone el tema
     ============================================ */
  @media (max-width: 768px) {
    .video-section {
      padding: 60px 0;
    }

    .section-header {
      margin-bottom: 32px;
    }

    .video-features {
      flex-direction: column;
      gap: 16px;
    }

    .feature-item {
      width: 100%;
      max-width: 220px;
    }

    .feature-divider {
      width: 60px;
      height: 1px;
    }

    .play-button {
      width: 64px;
      height: 64px;
    }

    .play-button svg {
      width: 24px;
      height: 24px;
    }

    .cta-button {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .play-button {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const playerEl = document.getElementById('videoPlayer');
    const poster = document.getElementById('videoPoster');
    const playButton = document.getElementById('playButton');
    const mount = document.getElementById('ytMount');

    if (!playerEl || !poster || !playButton || !mount) return;

    const w = window as any;
    const videoId = playerEl.dataset.videoId || '';
    const videoTitle = playerEl.dataset.videoTitle || 'RayGold Demo';
    const videoUrl = 'https://www.youtube.com/watch?v=' + videoId;

    let player: any = null;
    let poll: number | null = null;
    let started = false;
    let initializing = false;
    const milestones = [10, 25, 50, 75];
    const sent = new Set<number>();

    const gaEvent = (name: string, params: Record<string, unknown>) => {
      if (typeof w.gtag === 'function') w.gtag('event', name, params);
    };

    const baseParams = () => {
      const current = player && player.getCurrentTime ? Math.round(player.getCurrentTime()) : 0;
      const duration = player && player.getDuration ? Math.round(player.getDuration()) : 0;
      return {
        video_provider: 'youtube',
        video_title: videoTitle,
        video_url: videoUrl,
        video_current_time: current,
        video_duration: duration,
        visible: true,
        ubicacion: 'video_demo',
        idioma: document.documentElement.lang || 'es'
      };
    };

    const stopPoll = () => {
      if (poll !== null) {
        window.clearInterval(poll);
        poll = null;
      }
    };

    const startPoll = () => {
      stopPoll();
      poll = window.setInterval(() => {
        if (!player || !player.getDuration) return;
        const duration = player.getDuration();
        if (!duration) return;
        const percent = (player.getCurrentTime() / duration) * 100;
        milestones.forEach((m) => {
          if (percent >= m && !sent.has(m)) {
            sent.add(m);
            gaEvent('video_progress', { ...baseParams(), video_percent: m });
          }
        });
      }, 1000);
    };

    const loadApi = (): Promise<void> =>
      new Promise((resolve) => {
        if (w.YT && w.YT.Player) {
          resolve();
          return;
        }
        const previous = w.onYouTubeIframeAPIReady;
        w.onYouTubeIframeAPIReady = () => {
          if (typeof previous === 'function') previous();
          resolve();
        };
        if (!document.getElementById('yt-iframe-api')) {
          const script = document.createElement('script');
          script.id = 'yt-iframe-api';
          script.src = 'https://www.youtube.com/iframe_api';
          document.head.appendChild(script);
        }
      });

    const startVideo = async () => {
      if (initializing || player) return;
      initializing = true;

      poster.classList.add('hidden');
      await loadApi();

      const target = document.createElement('div');
      target.id = 'ytPlayerTarget';
      mount.appendChild(target);

      player = new w.YT.Player(target, {
        videoId,
        host: 'https://www.youtube-nocookie.com',
        playerVars: {
          autoplay: 1,
          rel: 0,
          modestbranding: 1,
          playsinline: 1,
          enablejsapi: 1,
          origin: window.location.origin
        },
        events: {
          onReady: (e: any) => {
            e.target.playVideo();
          },
          onStateChange: (e: any) => {
            const state = e.data;
            if (state === w.YT.PlayerState.PLAYING) {
              if (!started) {
                started = true;
                gaEvent('video_start', baseParams());
              }
              startPoll();
            } else if (state === w.YT.PlayerState.PAUSED) {
              stopPoll();
            } else if (state === w.YT.PlayerState.ENDED) {
              stopPoll();
              gaEvent('video_complete', { ...baseParams(), video_percent: 100 });
            }
          }
        }
      });
    };

    playButton.addEventListener('click', (e) => {
      e.stopPropagation();
      startVideo();
    });
    poster.addEventListener('click', startVideo);
  });
</script>