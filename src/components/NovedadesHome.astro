---
/**
 * NovedadesHome.astro — Franja "Novedades" de la portada (Noviembre 2026)
 *
 * @file src/components/NovedadesHome.astro
 *
 * Cuatro tarjetas que llevan a lo publicado en noviembre de 2026:
 * Ingeniería de producto, Calidad preventiva (Fabricación), cronometraje
 * (artículo del blog) y la ayuda en cada pantalla (Tecnología). El CRM no
 * va aquí porque CrmVitrina, justo encima, ya lo presenta.
 *
 * Textos aquí mismo, en los cinco idiomas. Las URLs salen de los ayudantes
 * de config/pages (nada escrito a mano salvo el slug del artículo, que es
 * igual en todos los idiomas). Tokens --rg-* para los dos temas.
 *
 * Para retirarla o cambiar las tarjetas basta con editar `tarjetas`.
 */
import { getPageUrl, getModuloUrl, type Lang } from '@/config/pages';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

type Clave = 'ingenieria' | 'calidad' | 'tiempos' | 'ayuda';

interface Textos {
  sello: string;
  titulo: string;
  lead: string;
  ver: string;
  blog: string;
  tarjetas: Record<Clave, { tag: string; titulo: string; texto: string }>;
}

const T: Record<Lang, Textos> = {
  es: {
    sello: 'Novedades',
    titulo: 'Lo último que hemos incorporado a RayGold',
    lead: 'Del estudio de cada joya antes de fabricarla a una ayuda que conoce tu forma de trabajar.',
    ver: 'Ver más',
    blog: 'Todas las novedades en el blog',
    tarjetas: {
      ingenieria: { tag: 'Módulo nuevo', titulo: 'Ingeniería de producto', texto: 'Del boceto a producción: prototipos, peso estimado desde el STL, coste por etapas y semáforo de margen antes de fabricar.' },
      calidad: { tag: 'Fabricación', titulo: 'Calidad preventiva', texto: 'Puntos de control en la ruta que paran el defecto en la fase donde nace, con autocontrol, ley, peso y Cpk.' },
      tiempos: { tag: 'Fabricación', titulo: 'Métodos y tiempos', texto: 'Tiempos estándar medidos por cronometraje, no estimados. Por qué hacen falta entre 10 y 15 ciclos.' },
      ayuda: { tag: 'En cada pantalla', titulo: 'La ayuda que conoce tu empresa', texto: 'Pulsas ?, tocas el campo y se explica solo, con la forma de trabajar de tu empresa y tus propias notas.' },
    },
  },
  en: {
    sello: 'What’s new',
    titulo: 'The latest additions to RayGold',
    lead: 'From studying each piece before it is made to help that knows how your company works.',
    ver: 'Learn more',
    blog: 'All the news on the blog',
    tarjetas: {
      ingenieria: { tag: 'New module', titulo: 'Product Engineering', texto: 'From sketch to production: prototypes, estimated weight from the STL, stage-by-stage cost and a margin traffic light before production.' },
      calidad: { tag: 'Manufacturing', titulo: 'In-process quality', texto: 'Control points in the route that stop a defect at the stage where it starts, with self-inspection, fineness, weight and Cpk.' },
      tiempos: { tag: 'Manufacturing', titulo: 'Methods and times', texto: 'Standard times measured by time study, not estimated. Why you need 10 to 15 cycles.' },
      ayuda: { tag: 'On every screen', titulo: 'Help that knows your business', texto: 'Press ?, touch the field and it explains itself, with your company’s way of working and your own notes.' },
    },
  },
  fr: {
    sello: 'Nouveautés',
    titulo: 'Les dernières nouveautés de RayGold',
    lead: 'De l’étude de chaque bijou avant sa fabrication à une aide qui connaît votre façon de travailler.',
    ver: 'En savoir plus',
    blog: 'Toutes les nouveautés sur le blog',
    tarjetas: {
      ingenieria: { tag: 'Nouveau module', titulo: 'Ingénierie produit', texto: 'Du croquis à la production : prototypes, poids estimé depuis le STL, coût par étape et feu de marge avant de fabriquer.' },
      calidad: { tag: 'Fabrication', titulo: 'Qualité préventive', texto: 'Des points de contrôle dans la gamme qui arrêtent le défaut à l’étape où il naît, avec autocontrôle, titre, poids et Cpk.' },
      tiempos: { tag: 'Fabrication', titulo: 'Méthodes et temps', texto: 'Des temps standard mesurés par chronométrage, pas estimés. Pourquoi il faut entre 10 et 15 cycles.' },
      ayuda: { tag: 'Sur chaque écran', titulo: 'L’aide qui connaît votre entreprise', texto: 'Appuyez sur ?, touchez le champ et il s’explique, avec la façon de travailler de votre entreprise et vos propres notes.' },
    },
  },
  ca: {
    sello: 'Novetats',
    titulo: 'El darrer que hem incorporat a RayGold',
    lead: 'De l’estudi de cada joia abans de fabricar-la a una ajuda que coneix la teva manera de treballar.',
    ver: 'Veure’n més',
    blog: 'Totes les novetats al blog',
    tarjetas: {
      ingenieria: { tag: 'Mòdul nou', titulo: 'Enginyeria de producte', texto: 'De l’esbós a producció: prototips, pes estimat des de l’STL, cost per etapes i semàfor de marge abans de fabricar.' },
      calidad: { tag: 'Fabricació', titulo: 'Qualitat preventiva', texto: 'Punts de control a la ruta que aturen el defecte a la fase on neix, amb autocontrol, llei, pes i Cpk.' },
      tiempos: { tag: 'Fabricació', titulo: 'Mètodes i temps', texto: 'Temps estàndard mesurats per cronometratge, no estimats. Per què calen entre 10 i 15 cicles.' },
      ayuda: { tag: 'A cada pantalla', titulo: 'L’ajuda que coneix la teva empresa', texto: 'Prems ?, toques el camp i s’explica sol, amb la manera de treballar de la teva empresa i les teves pròpies notes.' },
    },
  },
  'pt-br': {
    sello: 'Novidades',
    titulo: 'O que acabamos de incorporar ao RayGold',
    lead: 'Do estudo de cada joia antes de fabricá-la a uma ajuda que conhece o seu jeito de trabalhar.',
    ver: 'Saiba mais',
    blog: 'Todas as novidades no blog',
    tarjetas: {
      ingenieria: { tag: 'Módulo novo', titulo: 'Engenharia de produto', texto: 'Do esboço à produção: protótipos, peso estimado a partir do STL, custo por etapa e semáforo de margem antes de fabricar.' },
      calidad: { tag: 'Fabricação', titulo: 'Qualidade preventiva', texto: 'Pontos de controle no roteiro que param o defeito na etapa onde nasce, com autocontrole, teor, peso e Cpk.' },
      tiempos: { tag: 'Fabricação', titulo: 'Métodos e tempos', texto: 'Tempos-padrão medidos por cronoanálise, não estimados. Por que são necessários de 10 a 15 ciclos.' },
      ayuda: { tag: 'Em cada tela', titulo: 'A ajuda que conhece a sua empresa', texto: 'Aperte ?, toque o campo e ele se explica, com o jeito de trabalhar da sua empresa e as suas próprias notas.' },
    },
  },
};

const t = T[lang] ?? T.es;

const iconos: Record<Clave, string> = {
  ingenieria: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M7 4h10l4 5-9 11L3 9z"/><path d="M3 9h18M9 4l-1.5 5L12 20l4.5-11L15 4"/></svg>`,
  calidad: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7.5 3v5.5c0 5-3.2 8.5-7.5 10.5-4.3-2-7.5-5.5-7.5-10.5V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>`,
  tiempos: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="13.5" r="7.5"/><path d="M10 2.5h4M12 2.5v3.5M12 13.5V9.5M18.5 6.5l1.5-1.5"/></svg>`,
  ayuda: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6"/><circle cx="12" cy="17" r=".6" fill="currentColor"/></svg>`,
};

const blogUrl = `/${lang}/blog`;
const tarjetas: { clave: Clave; url: string; color: string }[] = [
  { clave: 'ingenieria', url: getModuloUrl('ingenieria', lang), color: '#e11d48' },
  { clave: 'calidad', url: getModuloUrl('fabricacion', lang), color: '#f59e0b' },
  { clave: 'tiempos', url: `${blogUrl}/cronometraje-taller-joyeria`, color: '#f59e0b' },
  { clave: 'ayuda', url: `${getPageUrl('tecnologia', lang)}#ayuda`, color: '#8b5cf6' },
];
---

<section class="nov" aria-labelledby="nov-titulo">
  <div class="nov-in">
    <header class="nov-head">
      <span class="nov-sello"><i aria-hidden="true"></i>{t.sello}</span>
      <h2 id="nov-titulo">{t.titulo}</h2>
      <p>{t.lead}</p>
    </header>

    <div class="nov-grid">
      {tarjetas.map(({ clave, url, color }) => {
        const c = t.tarjetas[clave];
        return (
          <a
            class="nov-card"
            href={url}
            style={`--nov-c: ${color}`}
            data-ga="novedad_click"
            data-ga-elemento={clave}
            data-ga-ubicacion="home"
          >
            <span class="nov-icon" set:html={iconos[clave]} aria-hidden="true" />
            <span class="nov-tag">{c.tag}</span>
            <h3>{c.titulo}</h3>
            <p>{c.texto}</p>
            <span class="nov-ver">
              {t.ver}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4"></path>
              </svg>
            </span>
          </a>
        );
      })}
    </div>

    <p class="nov-blog"><a href={blogUrl}>{t.blog} →</a></p>
  </div>
</section>

<style>
  .nov {
    padding: 72px 0 64px;
    background: var(--rg-bg);
    color: var(--rg-ink);
    font-family: var(--rg-sans);
    border-top: 1px solid var(--rg-line);
  }
  .nov-in {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .nov-head h2 {
    margin: 16px 0 0;
    font-family: var(--rg-display);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .nov-head p {
    margin: 10px 0 0;
    max-width: 60ch;
    color: var(--rg-soft);
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .nov-sello {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--rg-accent);
    background: var(--rg-accent-soft);
    padding: 6px 14px;
    border-radius: 999px;
  }
  .nov-sello i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--rg-accent);
  }

  .nov-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 32px;
  }
  .nov-card {
    display: flex;
    flex-direction: column;
    padding: 22px;
    border: 1px solid var(--rg-line);
    border-top: 3px solid var(--nov-c);
    border-radius: 14px;
    background: var(--rg-panel);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .nov-card:hover {
    border-color: var(--nov-c);
    transform: translateY(-2px);
    box-shadow: 0 16px 40px var(--rg-sombra);
  }
  .nov-card:focus-visible {
    outline: 2px solid var(--nov-c);
    outline-offset: 2px;
  }
  .nov-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--nov-c);
    background: color-mix(in srgb, var(--nov-c) 12%, transparent);
  }
  .nov-icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .nov-tag {
    margin-top: 16px;
    font-family: var(--rg-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rg-faint);
  }
  .nov-card h3 {
    margin: 6px 0 0;
    font-family: var(--rg-display);
    font-weight: 450;
    font-size: 1.2rem;
    line-height: 1.25;
  }
  .nov-card p {
    margin: 8px 0 0;
    flex: 1;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--rg-soft);
  }
  .nov-ver {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--nov-c);
  }
  .nov-ver svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s;
  }
  .nov-card:hover .nov-ver svg {
    transform: translateX(3px);
  }
  .nov-blog {
    margin: 24px 0 0;
    font-size: 14.5px;
  }
  .nov-blog a {
    color: var(--rg-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .nov-blog a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .nov-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .nov {
      padding: 56px 0 48px;
    }
    .nov-in {
      padding: 0 16px;
    }
    .nov-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nov-card,
    .nov-ver svg {
      transition: none;
    }
    .nov-card:hover {
      transform: none;
    }
  }
</style>
