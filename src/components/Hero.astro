---
/**
 * Hero.astro - Banner hero comercial principal
 * Con tema adaptativo: azul oscuro en desktop, blanco en móvil
 * Incluye badge de certificación VERI*FACTU
 * Visual lado derecho: carrusel adaptativo al tamaño de cada imagen
 * - Autoplay cada 5s
 * - Click sobre la imagen avanza al siguiente
 * - Dots clicables para ir directo a una slide
 */
import { type Lang, getPageUrl, getLegalUrl } from "@/config/pages";

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

// Traducciones
const translations: Record<Lang, {
  badge: string;
  title: string;
  subtitle: string;
  subtitleHighlight: string;
  stat1Number: string;
  stat1Label: string;
  stat2Number: string;
  stat2Label: string;
  stat3Number: string;
  stat3Label: string;
  ctaPrimary: string;
  ctaSecondary: string;
  visualLabel: string;
  badge1: string;
  badge2: string;
  scrollText: string;
  verifactuBadge: string;
}> = {
 es: {
    badge: "Desde 1990 · +200 joyerías confían en nosotros",
    title: "ERP joyero y software de joyería: el sistema que habla el idioma de tu negocio",
    subtitle: "Gestiona fabricación, trazabilidad de oro, mermas en fundición, ventas multitienda y contabilidad con un software ERP",
    subtitleHighlight: "diseñado exclusivamente para joyerías",
    stat1Number: "35",
    stat1Label: "años de experiencia",
    stat2Number: "200+",
    stat2Label: "joyerías activas",
    stat3Number: "8",
    stat3Label: "módulos integrados",
    ctaPrimary: "Ver demostración",
    ctaSecondary: "Explorar módulos",
    visualLabel: "Gestión de artículos",
    badge1: "Stock sincronizado",
    badge2: "Control de costes",
    scrollText: "Descubre más",
    verifactuBadge: "Certificado VERI*FACTU",
  },
  en: {
    badge: "Since 1990 · +200 jewelers trust us",
    title: "Jewelry ERP and jewelry software: the system that speaks your business language",
    subtitle: "Manage manufacturing, gold traceability, casting losses, multi-store sales and accounting with an ERP software",
    subtitleHighlight: "designed exclusively for jewelers",
    stat1Number: "35",
    stat1Label: "years of experience",
    stat2Number: "200+",
    stat2Label: "active jewelers",
    stat3Number: "8",
    stat3Label: "integrated modules",
    ctaPrimary: "Watch demo",
    ctaSecondary: "Explore modules",
    visualLabel: "Item management",
    badge1: "Synced stock",
    badge2: "Cost control",
    scrollText: "Discover more",
    verifactuBadge: "VERI*FACTU Certified",
  },
  fr: {
    badge: "Depuis 1990 · +200 bijouteries nous font confiance",
    title: "ERP joaillerie et logiciel pour bijouterie : le système qui parle le langage de votre métier",
    subtitle: "Gérez fabrication, traçabilité de l'or, pertes en fonte, ventes multi-boutique et comptabilité avec un logiciel ERP",
    subtitleHighlight: "conçu exclusivement pour les bijouteries",
    stat1Number: "35",
    stat1Label: "ans d'expérience",
    stat2Number: "200+",
    stat2Label: "bijouteries actives",
    stat3Number: "8",
    stat3Label: "modules intégrés",
    ctaPrimary: "Voir la démo",
    ctaSecondary: "Explorer les modules",
    visualLabel: "Gestion des articles",
    badge1: "Stock synchronisé",
    badge2: "Contrôle des coûts",
    scrollText: "Découvrir plus",
    verifactuBadge: "Certifié VERI*FACTU",
  },
  ca: {
    badge: "Des de 1990 · +200 joieries confien en nosaltres",
    title: "ERP joier i programari de joieria: el sistema que parla l'idioma del teu negoci",
    subtitle: "Gestiona fabricació, traçabilitat d'or, minves en fosa, vendes multibotiga i comptabilitat amb un programari ERP",
    subtitleHighlight: "dissenyat exclusivament per a joieries",
    stat1Number: "35",
    stat1Label: "anys d'experiència",
    stat2Number: "200+",
    stat2Label: "joieries actives",
    stat3Number: "8",
    stat3Label: "mòduls integrats",
    ctaPrimary: "Veure demostració",
    ctaSecondary: "Explorar mòduls",
    visualLabel: "Gestió d'articles",
    badge1: "Stock sincronitzat",
    badge2: "Control de costos",
    scrollText: "Descobreix més",
    verifactuBadge: "Certificat VERI*FACTU",
  },
  "pt-br": {
    badge: "Desde 1990 · +200 joalherias confiam em nós",
    title: "ERP joalheria e software para joalheria: o sistema que fala a língua do seu negócio",
    subtitle: "Gerencie fabricação, rastreabilidade de ouro, perdas em fundição, vendas multiloja e contabilidade com um software ERP",
    subtitleHighlight: "projetado exclusivamente para joalherias",
    stat1Number: "35",
    stat1Label: "anos de experiência",
    stat2Number: "200+",
    stat2Label: "joalherias ativas",
    stat3Number: "8",
    stat3Label: "módulos integrados",
    ctaPrimary: "Ver demonstração",
    ctaSecondary: "Explorar módulos",
    visualLabel: "Gestão de artigos",
    badge1: "Estoque sincronizado",
    badge2: "Controle de custos",
    scrollText: "Descubra mais",
    verifactuBadge: "Certificado VERI*FACTU",
  },
};

const t = translations[lang] || translations.es;
const contactUrl = getPageUrl('contacto', lang);
const modulosUrl = getPageUrl('modulos', lang);
const verifactuUrl = getLegalUrl('verifactu', lang);

// Imágenes del carrusel
const carouselImages = [
  { src: "https://raygoldstorage.blob.core.windows.net/web/InicioFin4.png", alt: "Planes Articulos" },
  { src: "https://raygoldstorage.blob.core.windows.net/web/InicioFIN3.png", alt: "Dashboard RayGold" },
  { src: "https://raygoldstorage.blob.core.windows.net/web/A02.png", alt: "Ficha artículo" },
  { src: "https://raygoldstorage.blob.core.windows.net/web/I02.png", alt: "Configuración" },
];
---

<section class="hero-section">
  <div class="hero-bg">
    <div class="hero-gradient"></div>
    <div class="hero-pattern"></div>
  </div>
  
  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <!-- Badges de confianza -->
        <div class="hero-badges">
          <div class="hero-badge">
            <span class="badge-icon">💎</span>
            <span>{t.badge}</span>
          </div>
          
          <!-- Badge VERI*FACTU -->
          <a href={verifactuUrl} class="verifactu-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <span>{t.verifactuBadge}</span>
          </a>
        </div>

        <!-- Titular principal -->
        <h1>{t.title}</h1>
        
        <!-- Subtítulo -->
        <p class="hero-subtitle">
          {t.subtitle} <strong>{t.subtitleHighlight}</strong>. Sin adaptaciones, sin parches.
        </p>

        <!-- Stats rápidos -->
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">{t.stat1Number}</span>
            <span class="stat-label">{t.stat1Label}</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">{t.stat2Number}</span>
            <span class="stat-label">{t.stat2Label}</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">{t.stat3Number}</span>
            <span class="stat-label">{t.stat3Label}</span>
          </div>
        </div>

        <!-- CTAs -->
        <div class="hero-ctas">
          <a href={contactUrl} class="cta-primary">
            <span>{t.ctaPrimary}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href={modulosUrl} class="cta-secondary">
            {t.ctaSecondary}
          </a>
        </div>
      </div>

      <!-- Visual lado derecho: carrusel adaptativo -->
      <div class="hero-visual">
        <div class="carousel" id="hero-carousel">
          <div class="carousel-track">
            {carouselImages.map((img, i) => (
              <div class={`carousel-slide ${i === 0 ? 'active' : ''}`}>
                <img src={img.src} alt={img.alt} />
              </div>
            ))}
          </div>

          <div class="visual-label">
            <span class="label-dot"></span>
            {t.visualLabel}
          </div>

          <div class="carousel-dots">
            {carouselImages.map((_, i) => (
              <button class={`carousel-dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Slide ${i + 1}`}></button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Indicador scroll -->
  <div class="scroll-indicator">
    <span>{t.scrollText}</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </div>
</section>

<style>
  /* ============================================
     DESKTOP: Tema azul oscuro (default)
     ============================================ */
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 6rem 1.5rem 4rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(102, 126, 234, 0.1) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.5;
  }

  .container {
    max-width: 1300px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-text {
    max-width: 560px;
  }

  /* Contenedor de badges */
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(102, 126, 234, 0.15);
    border: 1px solid rgba(102, 126, 234, 0.3);
    border-radius: 50px;
  }

  .badge-icon {
    font-size: 1rem;
  }

  .hero-badge span:last-child {
    color: #c4b5fd;
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* Badge VERI*FACTU */
  .verifactu-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.875rem;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .verifactu-badge:hover {
    background: rgba(16, 185, 129, 0.25);
    border-color: rgba(16, 185, 129, 0.6);
    transform: translateY(-1px);
  }

  .verifactu-badge svg {
    width: 14px;
    height: 14px;
    color: #10b981;
  }

  .verifactu-badge span {
    color: #6ee7b7;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  h1 {
    font-size: 3rem;
    font-weight: 800;
    color: white;
    line-height: 1.1;
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  .hero-subtitle strong {
    color: #e2e8f0;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding: 1.25rem 0;
    border-top: 1px solid #334155;
    border-bottom: 1px solid #334155;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
  }

  .stat-label {
    font-size: 0.8rem;
    color: #64748b;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: #334155;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.75rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(102, 126, 234, 0.3);
  }

  .cta-primary svg {
    width: 20px;
    height: 20px;
    transition: transform 0.2s ease;
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(102, 126, 234, 0.4);
  }

  .cta-primary:hover svg {
    transform: translateX(4px);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.75rem;
    background: transparent;
    color: #94a3b8;
    text-decoration: none;
    border: 1px solid #334155;
    border-radius: 12px;
    font-weight: 500;
    font-size: 1rem;
    transition: all 0.2s ease;
  }

  .cta-secondary:hover {
    color: white;
    border-color: #94a3b8;
    background: rgba(255, 255, 255, 0.05);
  }

  /* ============================================
     Visual lado derecho: carrusel adaptativo
     El slide activo es position:relative y define
     la altura del track. Los demás son absolute
     con opacity 0 superpuestos.
     ============================================ */
  .hero-visual {
    position: relative;
    width: 100%;
  }

  .carousel {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
    border: 1px solid #334155;
    cursor: pointer;
  }

  .carousel-track {
    position: relative;
    width: 100%;
    transition: height 0.4s ease;
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .carousel-slide.active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  .carousel-slide img {
    width: 100%;
    height: auto;
    display: block;
  }

  .visual-label {
    position: absolute;
    bottom: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(8px);
    border-radius: 8px;
    font-size: 0.8rem;
    color: white;
    font-weight: 500;
    z-index: 3;
    pointer-events: none;
  }

  .label-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .carousel-dots {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 3;
  }

  .carousel-dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .carousel-dot:hover {
    background: rgba(255, 255, 255, 0.7);
  }

  .carousel-dot.active {
    background: white;
    width: 24px;
    border-radius: 5px;
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: #64748b;
    font-size: 0.75rem;
    animation: bounce 2s ease-in-out infinite;
  }

  .scroll-indicator svg {
    width: 20px;
    height: 20px;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* ============================================
     TABLET: Reorganización
     ============================================ */
  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-text {
      max-width: 100%;
      text-align: center;
    }

    .hero-badges {
      justify-content: center;
    }

    h1 {
      font-size: 2.25rem;
    }

    .hero-stats {
      justify-content: center;
    }

    .hero-ctas {
      justify-content: center;
    }

    .hero-visual {
      max-width: 600px;
      margin: 0 auto;
    }
  }

  /* ============================================
     MÓVIL: Tema blanco claro
     ============================================ */
  @media (max-width: 768px) {
    .hero-section {
      padding: 5rem 1rem 3rem;
    }

    /* Fondo blanco */
    .hero-gradient {
      background: linear-gradient(135deg, #ffffff 0%, #f8fafc 50%, #ffffff 100%);
    }

    .hero-pattern {
      background-image: radial-gradient(rgba(102, 126, 234, 0.08) 1px, transparent 1px);
      opacity: 0.8;
    }

    /* Textos oscuros */
    h1 {
      font-size: 1.75rem;
      color: #1e293b;
    }

    .hero-subtitle {
      font-size: 1rem;
      color: #64748b;
    }

    .hero-subtitle strong {
      color: #334155;
    }

    /* Badges adaptados */
    .hero-badges {
      flex-direction: column;
      gap: 0.5rem;
    }

    .hero-badge {
      background: rgba(102, 126, 234, 0.1);
      border-color: rgba(102, 126, 234, 0.2);
    }

    .hero-badge span:last-child {
      color: #667eea;
    }

    .verifactu-badge {
      background: rgba(16, 185, 129, 0.1);
      border-color: rgba(16, 185, 129, 0.3);
    }

    .verifactu-badge span {
      color: #059669;
    }

    .verifactu-badge svg {
      color: #059669;
    }

    /* Stats */
    .hero-stats {
      flex-direction: column;
      gap: 1rem;
      border-color: #e2e8f0;
    }

    .stat-number {
      color: #1e293b;
    }

    .stat-label {
      color: #64748b;
    }

    .stat-divider {
      width: 40px;
      height: 1px;
      background: #e2e8f0;
    }

    /* CTAs */
    .hero-ctas {
      flex-direction: column;
    }

    .cta-primary,
    .cta-secondary {
      width: 100%;
      justify-content: center;
    }

    .cta-secondary {
      color: #64748b;
      border-color: #e2e8f0;
    }

    .cta-secondary:hover {
      color: #1e293b;
      border-color: #94a3b8;
      background: rgba(0, 0, 0, 0.02);
    }

    /* Carrusel */
    .carousel {
      border-color: #e2e8f0;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
    }

    .visual-label {
      background: rgba(255, 255, 255, 0.95);
      color: #1e293b;
      border: 1px solid #e2e8f0;
    }

    .scroll-indicator {
      display: none;
    }
  }
</style>

<script>
  function initHeroCarousel() {
    const carousel = document.getElementById('hero-carousel');
    if (!carousel) return;

    const track = carousel.querySelector('.carousel-track') as HTMLElement | null;
    const slides = Array.from(carousel.querySelectorAll('.carousel-slide')) as HTMLElement[];
    const dots = Array.from(carousel.querySelectorAll('.carousel-dot')) as HTMLElement[];
    if (!track || slides.length === 0) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    const AUTOPLAY_MS = 5000;

    // Fija la altura del track al slide activo para suavizar la transición
    // cuando las imágenes tienen alturas distintas
    function updateTrackHeight() {
      const activeSlide = slides[current];
      const img = activeSlide.querySelector('img') as HTMLImageElement | null;
      const apply = () => {
        track!.style.height = activeSlide.offsetHeight + 'px';
      };
      if (img && !img.complete) {
        img.addEventListener('load', apply, { once: true });
      }
      apply();
    }

    function show(index: number) {
      slides[current].classList.remove('active');
      dots[current]?.classList.remove('active');
      current = (index + slides.length) % slides.length;
      slides[current].classList.add('active');
      dots[current]?.classList.add('active');
      // Esperar un tick para que el nuevo slide pase a position:relative
      // y podamos medir su altura natural
      requestAnimationFrame(updateTrackHeight);
    }

    function next() { show(current + 1); }

    function start() {
      stop();
      timer = setInterval(next, AUTOPLAY_MS);
    }
    function stop() {
      if (timer) clearInterval(timer);
    }

    // Click en los dots → ir a esa slide
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        show(Number(dot.getAttribute('data-index')));
        start();
      });
    });

    // Click en cualquier otra parte del carrusel → siguiente
    carousel.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.carousel-dot')) return;
      next();
      start();
    });

    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);

    // Recalcular altura al redimensionar la ventana
    window.addEventListener('resize', updateTrackHeight);

    updateTrackHeight();
    start();
  }

  document.addEventListener('astro:page-load', initHeroCarousel);
  initHeroCarousel();
</script>