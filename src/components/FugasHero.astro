---
/**
 * FugasHero.astro — Portada: la frase + las capturas del ERP en vitrina
 *
 * @file src/components/FugasHero.astro
 *
 * CAMBIO (Septiembre 2026): se retira el fondo a sangre.
 * Las capturas del ERP son rejillas densas con texto pequeño y colores de
 * estado fuertes; detrás de un titular no hay velo que las salve. Vuelven al
 * panel enmarcado de la web anterior, pero dentro del hero nuevo:
 *   - texto a la izquierda sobre fondo limpio,
 *   - captura a la derecha, entera (object-fit: contain, sin recortes),
 *   - etiqueta debajo diciendo qué pantalla es,
 *   - puntos para cambiar y lupa para verla a pantalla completa.
 *
 * Ya no se usan las variables --rg-velo-fuerte, --rg-velo-suave,
 * --rg-filtro-img ni --rg-barra: puedes borrarlas de tokens.css.
 *
 * Las imágenes se pintan en el build, no por JS: la primera es el LCP.
 */
import { getPageUrl, type Lang } from '@/config/pages';
import { getFugasTranslations } from '@/i18n/fugas';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = getFugasTranslations(lang);
const h = t.hero;

const BLOB = 'https://raygoldstorage.blob.core.windows.net/web';
const pantallas = t.pantallas.map((p) => ({ ...p, url: `${BLOB}/${p.archivo}` }));

const urlContacto = getPageUrl('contacto', lang);
---

<section class="fugas-hero">
  <div class="hero-in">
    <!-- Columna de texto -->
    <div class="hero-texto">
      <span class="sello"><i aria-hidden="true"></i>{h.sello}</span>

      <h1>
        {h.titulo}
        <em>{h.tituloEnfasis}</em>
      </h1>

      <p class="lead">
        {h.lead} <strong>{h.leadFuerte}</strong> que los saca a la luz uno a uno y te da con qué
        cerrarlos: gramo a gramo, del lingote al escaparate.
      </p>

      <div class="ctas">
        <a class="btn btn--solid" href="#fugas">{h.ctaPrimario}</a>
        <a class="btn btn--ghost" href={urlContacto}>{h.ctaSecundario}</a>
      </div>
    </div>

    <!-- Vitrina: la captura, entera y nítida -->
    <figure class="vitrina">
      <div class="vitrina__marco">
        {pantallas.map((p, i) => (
          <img
            src={p.url}
            alt={p.alt}
            class:list={['vitrina__img', { 'is-on': i === 0 }]}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
            data-nombre={p.nombre}
            data-alt={p.alt}
          />
        ))}
      </div>

      <figcaption class="vitrina__pie">
        <span class="vitrina__et">{h.etiquetaDetras}</span>
        <span class="vitrina__n" data-pie-nombre>{pantallas[0].nombre}</span>

        <button class="ibtn" data-lupa data-tip={h.verPantalla} aria-label={h.verPantalla}>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <circle cx="8.8" cy="8.8" r="5.6"></circle>
            <path d="M13 13l4 4M8.8 6.6v4.4M6.6 8.8h4.4"></path>
          </svg>
        </button>

        <span class="puntos">
          {pantallas.map((p, i) => (
            <button
              class:list={['punto', { 'is-on': i === 0 }]}
              data-punto={i}
              aria-label={p.nombre}
            ></button>
          ))}
        </span>
      </figcaption>
    </figure>
  </div>

  <!-- Lightbox -->
  <div class="lb" data-lb role="dialog" aria-modal="true" aria-label={h.verPantalla}>
    <button class="ibtn lb__x" data-lb-x aria-label={h.cerrar}>
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M5 5l10 10M15 5L5 15"></path>
      </svg>
    </button>
    <img data-lb-img src="" alt="" />
  </div>
</section>

<style>
  .fugas-hero {
    background: var(--rg-bg);
    color: var(--rg-ink);
    font-family: var(--rg-sans);
    border-bottom: 1px solid var(--rg-line);
    padding: 72px 24px 80px;
  }

  .hero-in {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  /* ── Texto ── */
  .sello {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    color: var(--rg-soft);
    border: 1px solid var(--rg-line);
    background: var(--rg-panel);
    padding: 6px 13px;
    border-radius: 999px;
  }
  .sello i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rg-accent);
  }

  h1 {
    margin: 22px 0 0;
    font-family: var(--rg-display);
    font-weight: 380;
    font-size: clamp(2.05rem, 4vw, 3.25rem);
    line-height: 1.07;
    letter-spacing: -0.022em;
    max-width: 16ch;
    text-wrap: balance;
  }
  h1 em {
    font-style: italic;
    color: var(--rg-accent);
  }

  .lead {
    margin: 22px 0 0;
    max-width: 52ch;
    font-size: 1.04rem;
    line-height: 1.55;
    color: var(--rg-soft);
  }
  .lead strong {
    color: var(--rg-ink);
    font-weight: 600;
  }

  .ctas {
    margin-top: 30px;
    display: flex;
    gap: 13px;
    align-items: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 21px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--rg-ink);
    transition: background 0.18s, color 0.18s, border-color 0.18s;
  }
  .btn--solid {
    background: var(--rg-ink);
    color: var(--rg-on-ink);
  }
  .btn--solid:hover {
    background: var(--rg-accent);
    border-color: var(--rg-accent);
  }
  .btn--ghost {
    background: var(--rg-panel);
    color: var(--rg-ink);
  }
  .btn--ghost:hover {
    background: var(--rg-accent-soft);
  }

  /* ── Vitrina ──
     La captura se ve ENTERA (contain), nunca recortada: son pantallas de
     trabajo, y recortarlas por la mitad no dice nada. El marco absorbe la
     diferencia de proporción entre unas y otras. */
  .vitrina {
    margin: 0;
    min-width: 0;
  }

  .vitrina__marco {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--rg-panel);
    border: 1px solid var(--rg-line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 18px 50px var(--rg-sombra);
  }

  .vitrina__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .vitrina__img.is-on {
    opacity: 1;
  }

  .vitrina__pie {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 4px 0;
    font-size: 13px;
    color: var(--rg-soft);
  }
  .vitrina__et {
    font-family: var(--rg-mono);
    font-size: 11px;
    color: var(--rg-faint);
    letter-spacing: 0.05em;
  }
  .vitrina__n {
    color: var(--rg-ink);
  }

  .puntos {
    display: flex;
    gap: 7px;
    margin-left: auto;
  }
  .punto {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--rg-line);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .punto.is-on {
    background: var(--rg-accent);
    transform: scale(1.25);
  }

  /* ── Botón solo icono ── */
  .ibtn {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--rg-soft);
    cursor: pointer;
    position: relative;
    flex: 0 0 auto;
    transition: background 0.15s, color 0.15s;
  }
  .ibtn:hover {
    background: var(--rg-accent-soft);
    color: var(--rg-accent);
  }
  .ibtn svg {
    width: 16px;
    height: 16px;
  }
  .ibtn[data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--rg-ink);
    color: var(--rg-on-ink);
    font-size: 11.5px;
    padding: 5px 9px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s;
    z-index: 5;
  }
  .ibtn:hover::after,
  .ibtn:focus-visible::after {
    opacity: 1;
  }

  /* ── Lightbox ── */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(10, 12, 18, 0.9);
    display: none;
    place-items: center;
    padding: 28px;
  }
  .lb.is-on {
    display: grid;
  }
  .lb img {
    max-width: min(1400px, 95vw);
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.5);
  }
  .lb__x {
    position: absolute;
    top: 18px;
    right: 18px;
    color: #fff;
  }
  .lb__x:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  /* ── Responsive ── */
  @media (max-width: 980px) {
    .fugas-hero {
      padding: 48px 20px 56px;
    }
    .hero-in {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    h1 {
      max-width: 20ch;
    }
    .vitrina__marco {
      aspect-ratio: 16 / 10;
    }
    .ibtn[data-tip]::after {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vitrina__img {
      transition: none;
    }
  }
</style>

<script>
  function initFugasHero() {
    const hero = document.querySelector<HTMLElement>('.fugas-hero');
    if (!hero || hero.dataset.listo === '1') return;
    hero.dataset.listo = '1';

    const imgs = Array.from(hero.querySelectorAll<HTMLImageElement>('.vitrina__img'));
    const puntos = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-punto]'));
    const pieNombre = hero.querySelector<HTMLElement>('[data-pie-nombre]');
    const lb = hero.querySelector<HTMLElement>('[data-lb]');
    const lbImg = hero.querySelector<HTMLImageElement>('[data-lb-img]');
    const lupa = hero.querySelector<HTMLButtonElement>('[data-lupa]');
    const lbX = hero.querySelector<HTMLButtonElement>('[data-lb-x]');
    if (imgs.length === 0) return;

    const lento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actual = 0;
    let reloj: ReturnType<typeof setInterval> | null = null;

    function mostrar(i: number) {
      imgs[actual].classList.remove('is-on');
      puntos[actual]?.classList.remove('is-on');
      actual = (i + imgs.length) % imgs.length;
      imgs[actual].classList.add('is-on');
      puntos[actual]?.classList.add('is-on');
      if (pieNombre) pieNombre.textContent = imgs[actual].dataset.nombre || '';
    }

    function arrancar() {
      if (lento || imgs.length < 2 || reloj) return;
      reloj = setInterval(() => mostrar(actual + 1), 6500);
    }
    function parar() {
      if (reloj) clearInterval(reloj);
      reloj = null;
    }

    puntos.forEach((p, i) =>
      p.addEventListener('click', () => {
        parar();
        mostrar(i);
        arrancar();
      })
    );

    // Pausa al pasar el ratón por la vitrina
    const vitrina = hero.querySelector('.vitrina');
    vitrina?.addEventListener('mouseenter', parar);
    vitrina?.addEventListener('mouseleave', arrancar);

    // Lightbox
    function abrir() {
      if (!lb || !lbImg) return;
      lbImg.src = imgs[actual].src;
      lbImg.alt = imgs[actual].dataset.alt || '';
      lb.classList.add('is-on');
      document.body.style.overflow = 'hidden';
      parar();
    }
    function cerrar() {
      if (!lb) return;
      lb.classList.remove('is-on');
      document.body.style.overflow = '';
      arrancar();
    }
    lupa?.addEventListener('click', abrir);
    lbX?.addEventListener('click', cerrar);
    lb?.addEventListener('click', (e) => {
      if (e.target === lb) cerrar();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lb?.classList.contains('is-on')) cerrar();
    });

    // Pausa cuando el hero no está en pantalla
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => (e.isIntersecting ? arrancar() : parar()),
        { threshold: 0.15 }
      ).observe(hero);
    } else {
      arrancar();
    }
  }

  document.addEventListener('astro:page-load', initFugasHero);
  initFugasHero();
</script>