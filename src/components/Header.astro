---
/**
 * Header.astro - Navegación principal con Herramientas dropdown
 *
 * CORRECCIÓN SEO (Febrero 2026):
 * - TODAS las URLs SIN trailing slash
 * - Coherente con canonicals y comportamiento de Azure SWA
 *
 * INSTRUMENTACIÓN GA4 (Julio 2026):
 * - data-ga en logo, navegación y herramientas
 * - data-lang-switch en el selector de idioma
 * - El parámetro idioma lo añade AnalyticsEvents.astro automáticamente
 *
 * TEMA CLARO/OSCURO (Septiembre 2026):
 * - class="rg-inv rg-inv--barra": superficie invertida. En tema claro el menú
 *   es oscuro, en tema oscuro es claro. Siempre contrasta con el fondo.
 * - Usa SOLO variables con prefijo --rg-. Las antiguas (--ink, --soft,
 *   --accent) tienen otro significado en el resto del proyecto y no se tocan.
 * - Se han eliminado los colores literales: el marino rgba(15,23,42,.95), los
 *   rgba(255,255,255,.x), el violeta rgba(102,126,234,.x) y el #764ba2.
 * - El header ya NO se vuelve blanco en móvil: mismo color en todos los anchos.
 */
import { getPageUrl, getToolUrl, type Lang } from "@/config/pages";
import { getTranslations } from "@/i18n";
import ThemeToggle from "@/components/ThemeToggle.astro";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  const normalizedCurrent = currentPath.replace(/\/$/, "");
  const normalizedPath = path.replace(/\/$/, "");
  if (normalizedPath === `/${lang}` || normalizedPath === `/${lang}/`) {
    return normalizedCurrent === `/${lang}` || normalizedCurrent === `/${lang}/`;
  }
  return normalizedCurrent.startsWith(normalizedPath);
};

const languages: { code: Lang; name: string; flag: string }[] = [
  { code: "es", name: "Español", flag: "🇪🇸" },
  { code: "en", name: "English", flag: "🇬🇧" },
  { code: "fr", name: "Français", flag: "🇫🇷" },
  { code: "ca", name: "Català", flag: "🏴󠁥󠁳󠁣󠁴󠁿" },
  { code: "pt-br", name: "Português", flag: "🇧🇷" },
];

const currentLang = languages.find((l) => l.code === lang) || languages[0];

// URLs de navegación - SIN trailing slash
const homeUrl = `/${lang}`;
const modulosUrl = getPageUrl("modulos", lang);
const preciosUrl = getPageUrl("precios", lang);
const tecnologiaUrl = getPageUrl("tecnologia", lang);
const blogUrl = `/${lang}/blog`;
const contactoUrl = getPageUrl("contacto", lang);
const queEsUrl = getPageUrl("queEsRayGold", lang);

// URLs de herramientas - SIN trailing slash
const calculadoraUrl = getToolUrl("calculadora", lang);
const cotizacionUrl = getToolUrl("cotizacion", lang);

const navLabels: Record<Lang, { tools: string; calculator: string; prices: string }> = {
  es: { tools: "Herramientas", calculator: "Calculadora Rentabilidad", prices: "Cotización Oro/Plata" },
  en: { tools: "Tools", calculator: "Profitability Calculator", prices: "Gold/Silver Prices" },
  fr: { tools: "Outils", calculator: "Calculateur Rentabilité", prices: "Cours Or/Argent" },
  ca: { tools: "Eines", calculator: "Calculadora Rendibilitat", prices: "Cotització Or/Plata" },
  "pt-br": { tools: "Ferramentas", calculator: "Calculadora Rentabilidade", prices: "Cotação Ouro/Prata" },
};

const blogLabel: Record<Lang, string> = {
  es: "Blog", en: "Blog", fr: "Blog", ca: "Blog", "pt-br": "Blog",
};

const queEsLabel: Record<Lang, string> = {
  es: "Qué es RayGold",
  en: "What is RayGold",
  fr: "Qu'est-ce que RayGold",
  ca: "Què és RayGold",
  "pt-br": "O que é RayGold",
};

const nl = navLabels[lang];
const isToolsActive = currentPath.includes('/herramientas') || currentPath.includes('/tools') || currentPath.includes('/outils') || currentPath.includes('/eines') || currentPath.includes('/ferramentas');
---

<header class="header rg-inv rg-inv--barra">
  <div class="header-container">
    <a
      href={`/${lang}`}
      class="logo"
      data-ga="cta_click"
      data-ga-elemento="logo"
      data-ga-ubicacion="header"
    >
      <svg class="logo-icon" viewBox="0 0 40 40" fill="none">
        <path d="M20 2L37 12V28L20 38L3 28V12L20 2Z" fill="url(#grad1)" stroke="currentColor" stroke-width="1"></path>
        <path d="M20 8L30 14V26L20 32L10 26V14L20 8Z" fill="var(--logo-cara)"></path>
        <defs>
          <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:var(--rg-accent)"></stop>
            <stop offset="100%" style="stop-color:var(--logo-fin)"></stop>
          </linearGradient>
        </defs>
      </svg>
      <div class="logo-text">
        <span class="logo-name">RAYGOLD</span>
        <span class="logo-tagline">Software para Joyería</span>
      </div>
    </a>

    <nav class="nav-main">
      <a
        href={homeUrl}
        class:list={["nav-link", { active: isActive(homeUrl) && (currentPath === `/${lang}` || currentPath === `/${lang}/`) }]}
        data-ga="cta_click"
        data-ga-elemento="inicio"
        data-ga-ubicacion="header"
      >{t.nav?.home || "Inicio"}</a>

      <a
        href={modulosUrl}
        class:list={["nav-link", { active: isActive(modulosUrl) }]}
        data-ga="cta_click"
        data-ga-elemento="modulos"
        data-ga-ubicacion="header"
      >{t.nav?.modules || "Módulos"}</a>
      <a
        href={preciosUrl}
        class:list={["nav-link", { active: isActive(preciosUrl) }]}
        data-ga="cta_click"
        data-ga-elemento="precios"
        data-ga-ubicacion="header"
      >{t.nav?.pricing || "Precios"}</a>
      <a
        href={tecnologiaUrl}
        class:list={["nav-link", { active: isActive(tecnologiaUrl) }]}
        data-ga="cta_click"
        data-ga-elemento="tecnologia"
        data-ga-ubicacion="header"
      >{t.nav?.technology || "Tecnología"}</a>

      <!-- Herramientas Dropdown -->
      {/*
      <div class="nav-dropdown">
        <button class:list={["nav-link dropdown-trigger", { active: isToolsActive }]}>
          {nl.tools}
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>
        <div class="dropdown-menu">
          <a href={calculadoraUrl} class="dropdown-item" data-ga="cta_click" data-ga-elemento="calculadora_rentabilidad" data-ga-ubicacion="header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="2" width="16" height="20" rx="2"/>
              <line x1="8" y1="6" x2="16" y2="6"/>
              <line x1="8" y1="10" x2="16" y2="10"/>
              <line x1="8" y1="14" x2="12" y2="14"/>
            </svg>
            {nl.calculator}
          </a>
          <a href={cotizacionUrl} class="dropdown-item" data-ga="cta_click" data-ga-elemento="cotizacion_oro_plata" data-ga-ubicacion="header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            {nl.prices}
          </a>
        </div>
      </div>
        */}

      <a
        href={blogUrl}
        class:list={["nav-link", { active: isActive(blogUrl) }]}
        data-ga="cta_click"
        data-ga-elemento="blog"
        data-ga-ubicacion="header"
      >{blogLabel[lang]}</a>
      <a
        href={contactoUrl}
        class:list={["nav-link", { active: isActive(contactoUrl) }]}
        data-ga="contacto_click"
        data-ga-canal="pagina_contacto"
        data-ga-ubicacion="header"
      >{t.nav?.contact || "Contacto"}</a>

      {lang === "es" && (
        <a href={queEsUrl}
          class:list={["nav-link", { active: isActive(queEsUrl) }]}
          data-ga="cta_click"
          data-ga-elemento="que_es_raygold"
          data-ga-ubicacion="header"
        >{queEsLabel[lang]}</a>
      )}
    </nav>

    <!-- Herramientas de cabecera: idioma + tema -->
    <div class="header-tools">
      <div class="lang-selector">
        <button class="lang-trigger" aria-label="Seleccionar idioma" aria-expanded="false">
          <span class="lang-flag">{currentLang.flag}</span>
          <span class="lang-name">{currentLang.name}</span>
          <svg class="lang-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>
        <div class="lang-dropdown">
          {languages.map((l) => (
            <a
              href={`/${l.code}`}
              class:list={["lang-option", { active: l.code === lang }]}
              hreflang={l.code}
              data-lang-switch={l.code}
            >
              <span class="lang-option-flag">{l.flag}</span>
              <span class="lang-option-name">{l.name}</span>
              {l.code === lang && (
                <svg class="lang-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 6L9 17l-5-5"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <ThemeToggle lang={lang} />

      <button class="mobile-toggle" aria-label="Menú">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /* Variables propias del logo, derivadas del acento ya invertido */
  .header {
    --logo-fin: color-mix(in srgb, var(--rg-accent) 45%, var(--rg-ink));
    --logo-cara: color-mix(in srgb, var(--rg-ink) 22%, transparent);

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1px solid var(--rg-line);
  }

  .header-container { max-width:1280px; margin:0 auto; padding:0 24px; height:72px; display:flex; align-items:center; justify-content:space-between; gap:16px; }

  .logo { display:flex; align-items:center; gap:12px; text-decoration:none; }
  .logo-icon { width:40px; height:40px; color:var(--rg-ink); }
  .logo-text { display:flex; flex-direction:column; }
  .logo-name { font-family:var(--rg-display); font-size:1.1rem; font-weight:600; color:var(--rg-ink); letter-spacing:2px; }
  .logo-tagline { font-size:0.65rem; color:var(--rg-soft); letter-spacing:0.5px; }

  .nav-main { display:flex; align-items:center; gap:4px; margin-left:auto; }
  .nav-link { padding:8px 14px; color:var(--rg-soft); text-decoration:none; font-size:0.9rem; font-weight:500; border-radius:999px; border:1px solid transparent; transition:color .2s, background .2s, border-color .2s; }
  .nav-link:hover { color:var(--rg-ink); background:var(--rg-accent-soft); }
  .nav-link.active { color:var(--rg-ink); background:var(--rg-accent-soft); border-color:var(--rg-accent); }

  /* Dropdown de herramientas (hoy comentado en el marcado) */
  .nav-dropdown { position:relative; }
  .dropdown-trigger { display:flex; align-items:center; gap:4px; background:none; border:none; cursor:pointer; font-family:inherit; }
  .dropdown-chevron { transition:transform 0.2s; }
  .nav-dropdown:hover .dropdown-chevron { transform:rotate(180deg); }
  .dropdown-menu { position:absolute; top:calc(100% + 8px); left:50%; min-width:220px; background:var(--rg-panel); border:1px solid var(--rg-line); border-radius:12px; padding:8px; opacity:0; visibility:hidden; transform:translateX(-50%) translateY(-10px); transition:all 0.2s; z-index:100; box-shadow:0 10px 40px var(--rg-sombra); }
  .nav-dropdown:hover .dropdown-menu { opacity:1; visibility:visible; transform:translateX(-50%) translateY(0); }
  .dropdown-item { display:flex; align-items:center; gap:12px; padding:12px 16px; color:var(--rg-soft); text-decoration:none; border-radius:8px; transition:all 0.15s; font-size:0.9rem; }
  .dropdown-item:hover { background:var(--rg-accent-soft); color:var(--rg-ink); }
  .dropdown-item svg { width:18px; height:18px; opacity:0.7; }

  /* Herramientas de cabecera */
  .header-tools { display:flex; align-items:center; gap:8px; margin-left:24px; }

  /* Selector de idioma */
  .lang-selector { position:relative; }
  .lang-trigger { display:flex; align-items:center; gap:8px; padding:8px 14px; background:var(--rg-accent-soft); border:1px solid var(--rg-line); border-radius:999px; color:var(--rg-ink); font-family:inherit; font-size:0.85rem; font-weight:500; cursor:pointer; transition:background .2s, border-color .2s; min-width:130px; }
  .lang-trigger:hover { border-color:var(--rg-accent); }
  .lang-flag { font-size:1.1rem; }
  .lang-name { font-weight:500; flex:1; text-align:left; }
  .lang-chevron { transition:transform 0.2s; }
  .lang-selector:hover .lang-chevron { transform:rotate(180deg); }
  .lang-dropdown { position:absolute; top:calc(100% + 8px); right:0; min-width:180px; background:var(--rg-panel); border:1px solid var(--rg-line); border-radius:12px; padding:8px; opacity:0; visibility:hidden; transform:translateY(-10px); transition:all 0.2s; z-index:100; box-shadow:0 10px 40px var(--rg-sombra); }
  .lang-selector:hover .lang-dropdown { opacity:1; visibility:visible; transform:translateY(0); }
  .lang-option { display:flex; align-items:center; gap:10px; padding:10px 12px; color:var(--rg-soft); text-decoration:none; border-radius:8px; transition:all 0.15s; }
  .lang-option:hover { background:var(--rg-accent-soft); color:var(--rg-ink); }
  .lang-option.active { background:var(--rg-accent-soft); color:var(--rg-accent); }
  .lang-option-flag { font-size:1.25rem; }
  .lang-option-name { flex:1; font-size:0.9rem; }
  .lang-check { color:var(--rg-accent); }

  .mobile-toggle { display:none; padding:8px; background:transparent; border:none; color:var(--rg-soft); cursor:pointer; }
  .mobile-toggle:hover { color:var(--rg-ink); }

  @media (max-width:900px) {
    /* El header mantiene la superficie invertida también en móvil */
    .header-container { gap:8px; }
    .logo-tagline { display:none; }

    .nav-main { display:none; position:absolute; top:72px; left:0; right:0; background:var(--rg-inv-bg); flex-direction:column; align-items:stretch; padding:16px; border-bottom:1px solid var(--rg-line); box-shadow:0 4px 20px var(--rg-sombra); }
    .nav-main.mobile-open { display:flex; }
    .nav-link { padding:12px 16px; width:100%; text-align:center; }

    .nav-dropdown { width:100%; }
    .dropdown-trigger { width:100%; justify-content:center; }
    .dropdown-menu { position:static; transform:none; width:100%; opacity:1; visibility:visible; background:transparent; border:none; box-shadow:none; margin-top:8px; }
    .dropdown-item { justify-content:center; }

    .header-tools { margin-left:auto; gap:2px; }
    .mobile-toggle { display:block; }
    .lang-trigger { min-width:auto; padding:8px 10px; }
    .lang-name { display:none; }
  }
</style>

<script>
  document.querySelectorAll(".lang-trigger").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const expanded = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", (!expanded).toString());
    });
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest(".lang-selector")) {
      document.querySelectorAll(".lang-trigger").forEach((trigger) => {
        trigger.setAttribute("aria-expanded", "false");
      });
    }
  });

  const mobileToggle = document.querySelector(".mobile-toggle");
  const navMain = document.querySelector(".nav-main");

  mobileToggle?.addEventListener("click", () => {
    navMain?.classList.toggle("mobile-open");
    mobileToggle.classList.toggle("active");
  });

  document.querySelectorAll(".nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      navMain?.classList.remove("mobile-open");
      mobileToggle?.classList.remove("active");
    });
  });
</script>