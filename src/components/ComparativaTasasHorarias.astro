---
/*  ═══════════════════════════════════════════════════════════════════════════
 *  ComparativaTasasHorarias.astro
 *
 *  Seccion multiidioma: como calculan el coste de produccion por seccion
 *  SAP, Dynamics 365, PIRO y Odoo frente a RayGold.
 *
 *  Textos en src/i18n/comparativa.ts (patron del repo). Los NIVELES viven
 *  aqui porque son datos, no traduccion, y asi no pueden divergir por idioma.
 *
 *  Uso:  <ComparativaTasasHorarias lang={lang} />                (claro)
 *        <ComparativaTasasHorarias lang={lang} theme="adaptive" />  (oscuro desktop)
 *  ═══════════════════════════════════════════════════════════════════════════
 */
import { getComparativaTexts, getContactoUrl } from "@/i18n/comparativa";

interface Props {
    lang?: string;
    /** "light" (por defecto) o "adaptive": oscuro en escritorio (>768px)
     *  y claro en movil, igual que SubmoduloLayout. */
    theme?: "light" | "adaptive";
}

const { lang = "es", theme = "light" } = Astro.props;

const t = getComparativaTexts(lang);
const contactoUrl = getContactoUrl(lang);

type Nivel = "si" | "parcial" | "no";

//  Nombres de columna (marcas, no se traducen) + tags traducidos.
const columnas = [
    { nombre: "RayGold", tag: t.tags.raygold, destacada: true },
    { nombre: "SAP S/4HANA", tag: t.tags.sap },
    { nombre: "Dynamics 365", tag: t.tags.d365 },
    { nombre: "PIRO", tag: t.tags.piro },
    { nombre: "Odoo", tag: t.tags.odoo }
];

//  Niveles por fila, en orden de columnas [RayGold, SAP, D365, PIRO, Odoo].
//  Mismo orden que t.filas; el grupo se resuelve con "grupos" de abajo.
const niveles: Nivel[][] = [
    ["si", "si", "si", "parcial", "si"],
    ["si", "si", "si", "no", "parcial"],
    ["si", "si", "si", "no", "no"],
    ["si", "si", "no", "no", "no"],
    ["si", "si", "no", "no", "no"],
    ["si", "si", "parcial", "no", "no"],
    ["si", "parcial", "si", "no", "parcial"],
    ["si", "si", "si", "parcial", "si"],
    ["si", "parcial", "parcial", "si", "si"],
    ["si", "si", "parcial", "no", "no"],
    ["si", "si", "no", "parcial", "parcial"],
    ["si", "no", "no", "si", "no"],
    ["si", "no", "no", "si", "no"],
    ["si", "no", "no", "parcial", "parcial"]
];

//  Cuantas filas tiene cada grupo (suma = niveles.length).
const filasPorGrupo = [7, 4, 3];

const grupos = filasPorGrupo.map((cuenta, g) => {
    const desde = filasPorGrupo.slice(0, g).reduce((a, x) => a + x, 0);
    return {
        titulo: t.grupos[g],
        filas: t.filas.slice(desde, desde + cuenta).map((fila, i) => ({
            ...fila,
            niveles: niveles[desde + i]
        }))
    };
});

const srNivel = (n: Nivel) => (n === "si" ? t.sr.si : n === "parcial" ? t.sr.parcial : t.sr.no);
---

<section class:list={["cth", { "cth--adaptive": theme === "adaptive" }]} id="comparativa-tasas">
    <div class="cth__wrap">

        <header class="cth__head">
            <span class="cth__kicker">{t.kicker}</span>
            <h2>{t.titulo}</h2>
            <p>{t.intro}</p>
        </header>

        <div class="cth__glosario" aria-label={t.sr.glosario}>
            {t.glosario.map((g) => (
                <div class="cth__glos-item">
                    <span class="cth__sap">{g.codigo}</span>
                    <span>{g.texto}</span>
                </div>
            ))}
        </div>

        <div class="cth__scroll" role="region" aria-label={t.sr.tabla} tabindex="0">
            <table class="cth__table">
                <thead>
                    <tr>
                        <th class="cth__concepto" scope="col"><span class="sr-only">{t.sr.concepto}</span></th>
                        {columnas.map((c) => (
                            <th scope="col" class={c.destacada ? "cth__col--ray" : ""}>
                                <span class="cth__col-nombre">{c.nombre}</span>
                                <span class="cth__col-tag">{c.tag}</span>
                            </th>
                        ))}
                    </tr>
                </thead>

                {grupos.map((grupo) => (
                    <tbody>
                        <tr class="cth__grupo">
                            <th colspan={columnas.length + 1} scope="colgroup">{grupo.titulo}</th>
                        </tr>
                        {grupo.filas.map((fila) => (
                            <tr>
                                <th class="cth__concepto" scope="row">
                                    <strong>{fila.concepto}</strong>
                                    <span>{fila.detalle}</span>
                                </th>
                                {fila.niveles.map((nivel, i) => (
                                    <td class={columnas[i].destacada ? "cth__col--ray" : ""}>
                                        <span class={`cth__dot cth__dot--${nivel}`} aria-hidden="true">
                                            {nivel === "si" ? (
                                                <svg viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
                                            ) : nivel === "parcial" ? (
                                                <svg viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M19 13H5v-2h14z"/></svg>
                                            ) : (
                                                <svg viewBox="0 0 24 24" width="11" height="11"><path fill="currentColor" d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"/></svg>
                                            )}
                                        </span>
                                        <span class="sr-only">{srNivel(nivel)}</span>
                                        {fila.notas[i] && <span class="cth__nota">{fila.notas[i]}</span>}
                                    </td>
                                ))}
                            </tr>
                        ))}
                    </tbody>
                ))}
            </table>
        </div>

        <div class="cth__leyenda">
            <span><i class="cth__dot cth__dot--si"></i> {t.leyenda.si}</span>
            <span><i class="cth__dot cth__dot--parcial"></i> {t.leyenda.parcial}</span>
            <span><i class="cth__dot cth__dot--no"></i> {t.leyenda.no}</span>
        </div>

        <p class="cth__pie">
            {t.pie} <a href={contactoUrl}>{t.pieLink}</a>.
        </p>

        <div class="cth__cta">
            <p>{t.cta1}<br />{t.cta2}</p>
            <a class="cth__btn" href={contactoUrl}>{t.ctaBoton}</a>
        </div>
    </div>
</section>

<style>
    .cth {
        --violeta: #667eea;
        --violeta-2: #764ba2;
        --tinta: #1e2433;
        --gris: #6b7280;
        --linea: #eceef4;
        --fondo: #fafbfd;
        --bg: #fff;
        --hover: #fafbff;
        --nota-ray: var(--violeta-2);
        --ray-bg-a: rgba(102, 126, 234, 0.07);
        --ray-bg-b: rgba(118, 75, 162, 0.05);
        --dot-no-bg: #f1f2f6;
        --dot-no-fg: #b3b9c4;
        --nota: #4b5563;
        --pie: #9aa1af;
        --warn-bg: #fffaf0;
        --warn-fg: #b45309;

        padding: 72px 20px;
        background: var(--bg);
        color: var(--tinta);
        font-size: 16px;
        line-height: 1.5;
    }

    .cth__wrap { max-width: 1120px; margin: 0 auto; }

    /*  ── Cabecera ── */
    .cth__head { max-width: 640px; margin: 0 auto 34px; text-align: center; }

    .cth__kicker {
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--violeta);
        background: rgba(102, 126, 234, 0.1);
        border-radius: 999px;
        padding: 5px 14px;
        margin-bottom: 14px;
    }

    .cth__head h2 {
        font-size: clamp(1.5rem, 3.2vw, 2.1rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.15;
        margin: 0 0 12px;
    }

    .cth__head p { color: var(--gris); margin: 0; font-size: 0.98rem; }

    /*  ── Glosario SAP ── */
    .cth__glosario {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 10px;
        margin-bottom: 30px;
    }

    .cth__glos-item {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--fondo);
        border: 1px solid var(--linea);
        border-radius: 12px;
        padding: 11px 14px;
        font-size: 0.8rem;
        color: var(--gris);
    }

    .cth__sap {
        flex: 0 0 auto;
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        color: var(--violeta);
        background: rgba(102, 126, 234, 0.12);
        border-radius: 7px;
        padding: 3px 8px;
    }

    /*  ── Tabla ── */
    .cth__scroll {
        overflow-x: auto;
        border: 1px solid var(--linea);
        border-radius: 16px;
        -webkit-overflow-scrolling: touch;
    }

    .cth__table {
        width: 100%;
        min-width: 880px;
        border-collapse: collapse;
        font-size: 0.82rem;
    }

    .cth__table thead th {
        padding: 16px 12px 14px;
        text-align: center;
        background: var(--fondo);
        border-bottom: 1px solid var(--linea);
        vertical-align: bottom;
    }

    .cth__col-nombre { display: block; font-weight: 800; font-size: 0.86rem; letter-spacing: -0.01em; }
    .cth__col-tag {
        display: block;
        font-size: 0.62rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--gris);
        font-weight: 600;
        margin-top: 3px;
    }

    .cth__col--ray {
        background: linear-gradient(180deg, var(--ray-bg-a), var(--ray-bg-b)) !important;
        border-inline: 1px solid rgba(102, 126, 234, 0.18);
    }

    thead .cth__col--ray .cth__col-nombre { color: var(--violeta); }
    thead .cth__col--ray .cth__col-tag { color: var(--violeta-2); }

    .cth__grupo th {
        text-align: left;
        padding: 14px 18px 10px;
        font-size: 0.66rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--gris);
        background: var(--bg);
        border-bottom: 1px solid var(--linea);
    }

    .cth__table td,
    .cth__table th.cth__concepto {
        padding: 12px;
        border-bottom: 1px solid var(--linea);
        vertical-align: middle;
    }

    .cth__table tbody tr:hover td { background: var(--hover); }
    .cth__table tbody tr:hover .cth__col--ray {
        background: linear-gradient(180deg, var(--ray-bg-a), var(--ray-bg-b)) !important;
    }

    th.cth__concepto {
        text-align: left;
        min-width: 230px;
        max-width: 280px;
        position: sticky;
        left: 0;
        background: var(--bg);
        z-index: 1;
    }

    th.cth__concepto strong { display: block; font-size: 0.82rem; font-weight: 700; }
    th.cth__concepto span { display: block; font-size: 0.72rem; color: var(--nota); font-weight: 500; margin-top: 2px; line-height: 1.4; }

    .cth__table td { text-align: center; }

    .cth__dot {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border-radius: 999px;
    }

    .cth__dot--si { background: rgba(102, 126, 234, 0.14); color: var(--violeta); }
    .cth__dot--parcial { background: #fef3c7; color: #b45309; }
    .cth__dot--no { background: var(--dot-no-bg); color: var(--dot-no-fg); }

    .cth__nota {
        display: block;
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--nota);
        margin-top: 5px;
        line-height: 1.3;
    }

    .cth__col--ray .cth__nota { color: var(--nota-ray); font-weight: 600; }

    /*  ── Leyenda + pie ── */
    .cth__leyenda {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        justify-content: center;
        margin: 16px 0 6px;
        font-size: 0.74rem;
        color: var(--gris);
    }

    .cth__leyenda span { display: inline-flex; align-items: center; gap: 7px; }
    .cth__leyenda .cth__dot { width: 16px; height: 16px; }

    .cth__pie {
        text-align: center;
        font-size: 0.7rem;
        color: var(--pie);
        max-width: 560px;
        margin: 10px auto 0;
    }

    .cth__pie a { color: var(--violeta); }

    /*  ── CTA ── */
    .cth__cta {
        margin-top: 40px;
        text-align: center;
        background: linear-gradient(135deg, var(--violeta), var(--violeta-2));
        border-radius: 20px;
        padding: 34px 24px;
        color: #fff;
    }

    .cth__cta p { font-size: 1.15rem; font-weight: 700; line-height: 1.4; margin: 0 0 18px; }

    .cth__btn {
        display: inline-block;
        background: #fff;
        color: var(--violeta);
        font-weight: 700;
        font-size: 0.9rem;
        border-radius: 999px;
        padding: 12px 26px;
        text-decoration: none;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .cth__btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18); }

    .sr-only {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    /*  Variante adaptativa: oscuro en escritorio, como SubmoduloLayout.
        En movil (<=768px) el layout pasa a claro, y esta seccion tambien.  */
    @media (min-width: 769px) {
        .cth--adaptive {
            --tinta: #f1f5f9;
            --gris: #94a3b8;
            --linea: #334155;
            --fondo: #1e293b;
            --bg: #0f172a;
            --hover: #16203a;
            --nota-ray: #b6c0f5;
            --ray-bg-a: rgba(102, 126, 234, 0.14);
            --ray-bg-b: rgba(118, 75, 162, 0.1);
            --dot-no-bg: #1e293b;
            --dot-no-fg: #475569;
            --nota: #cbd5e1;
            --pie: #64748b;
            --warn-bg: rgba(245, 158, 11, 0.1);
            --warn-fg: #fbbf24;
        }

        .cth--adaptive .cth__dot--si { background: rgba(102, 126, 234, 0.2); color: #a5b3f2; }
        .cth--adaptive .cth__dot--parcial { background: rgba(245, 158, 11, 0.16); color: #fbbf24; }
        .cth--adaptive .cth__sap { background: rgba(102, 126, 234, 0.18); color: #a5b3f2; }
        .cth--adaptive .cth__kicker { background: rgba(102, 126, 234, 0.16); color: #a5b3f2; }
        .cth--adaptive .cth__col--ray { border-inline-color: rgba(102, 126, 234, 0.3); }
        .cth--adaptive thead .cth__col--ray .cth__col-nombre { color: #a5b3f2; }
        .cth--adaptive thead .cth__col--ray .cth__col-tag { color: #b6c0f5; }
        .cth--adaptive .cth__pie a { color: #a5b3f2; }
    }

    @media (max-width: 640px) {
        .cth { padding: 52px 14px; }
        th.cth__concepto { min-width: 190px; box-shadow: 6px 0 8px -6px rgba(30, 36, 51, 0.08); }
    }
</style>
