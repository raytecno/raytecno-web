---
/**
 * AnalyticsEvents.astro — Instrumentacion de eventos GA4
 *
 * Un unico listener delegado para toda la web. Para medir un
 * elemento basta con marcarlo en el HTML, sin tocar este fichero:
 *
 *   data-ga="cta_click"
 *   data-ga-elemento="ver_demostracion"
 *   data-ga-ubicacion="hero"
 *
 * Cualquier atributo data-ga-XXX se convierte en parametro del
 * evento. Los nombres compuestos usan guion y se traducen a
 * guion bajo: data-ga-idioma-destino pasa a idioma_destino.
 *
 * El parametro idioma se anade solo, leyendo el lang del html.
 *
 * Depuracion: anadir ?ga_debug=1 a la URL vuelca cada evento
 * por consola sin necesidad de mirar la pestana Network.
 *
 * NOTA: no escribir etiquetas HTML entre angulos en estos
 * comentarios. El compilador de Astro las detecta y falla.
 */
---

<script>
  (function () {
    var DEBUG = new URLSearchParams(location.search).has("ga_debug");

    function lang() {
      return document.documentElement.lang || "es";
    }

    /** Convierte gaIdiomaDestino en idioma_destino */
    function toSnake(key) {
      var name = key.slice(2);
      name = name.charAt(0).toLowerCase() + name.slice(1);
      return name.replace(/([A-Z])/g, function (m) {
        return "_" + m.toLowerCase();
      });
    }

    /** Lee todos los data-ga-XXX de un elemento */
    function paramsFrom(el) {
      var out = { idioma: lang() };
      Object.keys(el.dataset).forEach(function (k) {
        if (k === "ga") return;
        if (k.indexOf("ga") !== 0) return;
        if (k.length < 3) return;
        if (k.charAt(2) !== k.charAt(2).toUpperCase()) return;
        out[toSnake(k)] = el.dataset[k];
      });
      return out;
    }

    /** Envio centralizado. Unico punto que habla con gtag. */
    function send(name, params) {
      var payload = params || {};
      if (!payload.idioma) payload.idioma = lang();
      if (DEBUG) console.log("[GA4]", name, payload);
      if (typeof window.gtag !== "function") return;
      window.gtag("event", name, payload);
    }

    // Expuesto para codigo que no puede usar atributos:
    // validaciones de formulario, respuestas de la API, etc.
    window.gaEvent = send;

    /* ---------- 1. Clics con atributos data-ga ---------- */

    document.addEventListener(
      "click",
      function (e) {
        var el = e.target.closest("[data-ga]");
        if (!el) return;
        send(el.dataset.ga, paramsFrom(el));
      },
      true
    );

    /* ---------- 2. Selector de idioma ---------- */

    document.addEventListener(
      "click",
      function (e) {
        var el = e.target.closest("[data-lang-switch]");
        if (!el) return;
        var destino = el.getAttribute("data-lang-switch");
        if (destino === lang()) return; // ya esta en ese idioma
        send("cambio_idioma", { idioma_destino: destino });
      },
      true
    );

    /* ---------- 3. Video nativo ---------- */

    function trackVideo(video) {
      var nombre = video.getAttribute("data-ga-video") || "video";
      var hitos = [25, 50, 75];
      var vistos = {};
      var arrancado = false;

      video.addEventListener("play", function () {
        if (arrancado) return;
        arrancado = true;
        send("video_progreso", { elemento: nombre, accion: "play" });
      });

      video.addEventListener("timeupdate", function () {
        if (!video.duration || !isFinite(video.duration)) return;
        var pct = (video.currentTime / video.duration) * 100;
        hitos.forEach(function (h) {
          if (pct >= h && !vistos[h]) {
            vistos[h] = true;
            send("video_progreso", { elemento: nombre, accion: String(h) });
          }
        });
      });

      video.addEventListener("ended", function () {
        if (vistos[100]) return;
        vistos[100] = true;
        send("video_progreso", { elemento: nombre, accion: "100" });
      });
    }

    function initVideos() {
      document.querySelectorAll("video[data-ga-video]").forEach(trackVideo);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initVideos);
    } else {
      initVideos();
    }

    if (DEBUG) {
      console.log(
        "[GA4] Modo depuracion activo. Elementos marcados:",
        document.querySelectorAll("[data-ga]").length
      );
    }
  })();
</script>