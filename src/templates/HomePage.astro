---
/**
 * Template: HomePage
 * Página de inicio de RayGold
 *
 * USA LOS COMPONENTES ORIGINALES con soporte multiidioma
 * Fondos intercalados: oscuro / claro / oscuro / claro / oscuro
 */
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Modulos from "@/components/Modulos.astro";
import PorQueRayGold from "@/components/PorQueRayGold.astro";
import VideoDemo from "@/components/VideoDemo.astro";
import Testimonios from "@/components/Testimonios.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { getAlternateUrls, type Lang } from "@/config/pages";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const alternateUrls = getAlternateUrls("home");

// Meta información por idioma
const metaInfo: Record<Lang, { title: string; description: string }> = {
 es: {
    title: "ERP Joyero y Software de Joyería RayGold | Gestión integral para joyerías",
    description:
      "ERP joyero y software de gestión para joyería especializado. Trazabilidad de oro y plata, control de mermas en fundición, gestión multitienda e impresión 3D integrada. Cumplimiento VERI*FACTU. +200 joyerías confían en RayGold desde 1990.",
  },
  en: {
    title: "Jewelry ERP and Jewelry Software RayGold | Comprehensive management for jewelers",
    description:
      "Specialized jewelry ERP and management software for jewelers. Gold and silver traceability, casting loss control, multi-store management and integrated 3D printing. +200 jewelers trust RayGold since 1990.",
  },
  fr: {
    title: "ERP Joaillerie et Logiciel pour Bijouterie RayGold | Gestion intégrale pour bijoutiers",
    description:
      "ERP joaillerie et logiciel de gestion pour bijouterie spécialisé. Traçabilité d'or et d'argent, contrôle des pertes en fonte, gestion multi-boutique et impression 3D intégrée. +200 bijouteries font confiance à RayGold depuis 1990.",
  },
 ca: {
    title: "ERP Joier i Programari de Joieria RayGold | Gestió integral per a joieries",
    description:
      "ERP joier i programari de gestió per a joieria especialitzat. Traçabilitat d'or i plata, control de minves en fosa, gestió multibotiga i impressió 3D integrada. Compliment VERI*FACTU. +200 joieries confien en RayGold des de 1990.",
  },
  "pt-br": {
    title: "ERP Joalheria e Software para Joalheria RayGold | Gestão integral para joalherias",
    description:
      "ERP joalheria e software de gestão para joalheria especializado. Rastreabilidade de ouro e prata, controle de perdas em fundição, gestão multiloja e impressão 3D integrada. +200 joalherias confiam em RayGold desde 1990.",
  },
};

const meta = metaInfo[lang] || metaInfo.es;
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  type="product"
  alternateUrls={alternateUrls}
>
  <!-- Hero Section - Banner principal (fondo oscuro propio) -->
  <Hero lang={lang} />

  <!-- Módulos - fondo CLARO -->
  <div class="section-bg section-bg--light">
    <Modulos lang={lang} />
  </div>

  <!-- Por Qué RayGold - fondo OSCURO -->
  <div class="section-bg section-bg--dark">
    <PorQueRayGold lang={lang} />
  </div>

  <!-- Video Demo - fondo CLARO -->
  <div class="section-bg section-bg--light">
    <VideoDemo lang={lang} />
  </div>

  <!-- Testimonios - fondo OSCURO -->
  <div class="section-bg section-bg--dark">
    <Testimonios lang={lang} />
  </div>

  <!-- WhatsApp Button - flotante -->
  <WhatsAppButton lang={lang} />
</Layout>

<style>
  .section-bg {
    position: relative;
  }

  .section-bg--dark {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
  }

  .section-bg--light {
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 50%, #ffffff 100%);
  }

  /* Transición suave entre la zona oscura y la clara
     usando un degradado de empalme en el borde */
  .section-bg--light::before,
  .section-bg--dark::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 80px;
    pointer-events: none;
    z-index: 1;
  }
</style>