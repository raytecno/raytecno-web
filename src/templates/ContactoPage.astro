<style>
  /* Variables locales de la página.
     ANTES estaban en :root, que en un <style> de Astro NO queda acotado y
     redefinía los colores de toda la web. */
  .contacto-page {
    --borde: var(--rg-line);
    --verde: #10b981;
    --rojo: #ef4444;

    background: var(--rg-bg);
    color: var(--rg-ink);
    min-height: 100vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Hero */
  .contacto-hero {
    padding: 60px 0 40px;
    text-align: center;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .contacto-hero h1 {
    font-family: var(--rg-display);
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--rg-ink);
    margin: 0 0 1rem;
    line-height: 1.12;
    text-wrap: balance;
  }

  .titulo-enfasis {
    font-style: italic;
    color: var(--rg-accent);
  }

  .contacto-hero p {
    font-size: 1.1rem;
    color: var(--rg-soft);
    margin: 0;
  }

  /* Contact Section */
  .contacto-section {
    padding: 0 0 60px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  /* Contact Card */
  .contact-card {
    background: var(--rg-panel);
    border: 1px solid var(--borde);
    border-radius: 20px;
    padding: 32px;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--borde);
  }

  .card-icon {
    width: 48px;
    height: 48px;
    background: var(--rg-accent);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--rg-on-ink);
    flex-shrink: 0;
  }

  .card-icon.contact {
    background: var(--verde);
    color: #fff;
  }

  .card-header h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--rg-ink);
    margin: 0 0 4px 0;
  }

  .card-header p {
    font-size: 0.875rem;
    color: var(--rg-faint);
    margin: 0;
  }

  /* Form Styles */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group.full-width {
    grid-column: span 2;
  }

  .form-group label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--rg-soft);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 12px 14px;
    background: var(--rg-bg);
    border: 1px solid var(--borde);
    border-radius: 10px;
    color: var(--rg-ink);
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--rg-accent);
    box-shadow: 0 0 0 3px var(--rg-accent-soft);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--rg-faint);
  }

  .form-group select option {
    background-color: var(--rg-panel);
    color: var(--rg-ink);
  }

  /* Campo a corregir */
  .form-group input.is-invalid,
  .form-group textarea.is-invalid,
  .input-prefix.is-invalid {
    border-color: var(--rojo);
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
  }

  /* Pista y contador del mensaje */
  .form-hint {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.75rem;
    color: var(--rg-faint);
  }

  .char-counter {
    font-variant-numeric: tabular-nums;
    transition: color 0.2s ease;
  }

  .char-counter.ok {
    color: var(--verde);
  }

  .turnstile-wrap {
    min-height: 65px;
  }

  /* Aviso de resultado (éxito / error) */
  .form-status {
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 0.9rem;
    line-height: 1.4;
    border: 1px solid transparent;
  }

  .form-status.error {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.35);
    color: var(--rojo);
  }

  .form-status.success {
    background: rgba(16, 185, 129, 0.1);
    border-color: rgba(16, 185, 129, 0.35);
    color: var(--verde);
  }

  .input-prefix {
    display: flex;
    align-items: center;
    background: var(--rg-bg);
    border: 1px solid var(--borde);
    border-radius: 10px;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  .input-prefix span {
    padding: 8px 10px;
    background: var(--rg-sup2);
    color: var(--rg-soft);
    font-size: 0.9rem;
    border-right: 1px solid var(--borde);
  }

  .input-prefix input {
    border: none;
    background: transparent;
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  .btn-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 24px;
    background: var(--rg-ink);
    color: var(--rg-on-ink);
    border: 1px solid var(--rg-ink);
    border-radius: 999px;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .btn-submit:hover {
    background: var(--rg-accent);
    border-color: var(--rg-accent);
    transform: translateY(-2px);
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: default;
    transform: none;
  }

  /* ============================================
     Card de Contacto Directo
     ============================================ */
  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact-channel {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    background: var(--rg-bg);
    border: 1px solid var(--borde);
    border-radius: 14px;
    text-decoration: none;
    color: var(--rg-ink);
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }

  .contact-channel:hover {
    transform: translateY(-2px);
    border-color: var(--rg-accent);
    background: var(--rg-accent-soft);
  }

  .channel-icon {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
  }

  .channel-icon.phone-bg {
    background: var(--rg-accent);
    color: var(--rg-on-ink);
  }

  .channel-icon.whatsapp-bg {
    background: #25d366;
  }

  .channel-icon.email-bg {
    background: #f59e0b;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .channel-label {
    font-size: 0.75rem;
    color: var(--rg-faint);
    font-weight: 500;
    letter-spacing: 0.4px;
  }

  .channel-value {
    font-size: 1rem;
    color: var(--rg-ink);
    font-weight: 600;
  }

  .channel-arrow {
    color: var(--rg-faint);
    transition: transform 0.25s ease, color 0.25s ease;
    flex-shrink: 0;
  }

  .contact-channel:hover .channel-arrow {
    transform: translateX(3px);
    color: var(--rg-accent);
  }

  /* Bloques de información adicional */
  .contact-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--borde);
  }

  .info-block {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    background: var(--rg-bg);
    border: 1px solid var(--borde);
    border-radius: 10px;
  }

  .info-icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--rg-accent-soft);
    color: var(--rg-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-block > div:last-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .info-label {
    font-size: 0.7rem;
    color: var(--rg-faint);
    letter-spacing: 0.4px;
    font-weight: 500;
  }

  .info-value {
    font-size: 0.85rem;
    color: var(--rg-ink);
    font-weight: 500;
  }

  /* Responsive: solo estructura, el color no cambia */
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .contacto-hero {
      padding: 40px 0 30px;
    }

    .contact-card {
      padding: 24px;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .form-group.full-width {
      grid-column: span 1;
    }

    .contact-info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script
  define:vars={{
    CONTACT_API_URL,
    TURNSTILE_SITE_KEY,
    MIN_MENSAJE,
    STATUS,
    SENDING_TEXT,
  }}
>
  document.addEventListener("DOMContentLoaded", () => {
    const contactForm = document.getElementById("contactForm");
    if (!contactForm) return;

    const statusBox = document.getElementById("formStatus");
    const counter = document.getElementById("charCounter");
    const mensajeEl = contactForm.querySelector("#mensaje");
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    // Envío seguro: si analytics falla, el formulario sigue funcionando
    const ga = (name, params) => {
      if (typeof window.gaEvent === "function") window.gaEvent(name, params);
    };

    // Página interna desde la que llegó el usuario al formulario
    const origen = (() => {
      try {
        const r = document.referrer;
        if (!r) return "directo";
        const u = new URL(r);
        return u.host === location.host ? u.pathname : "externo";
      } catch {
        return "directo";
      }
    })();

    // ---- Avisos ----
    const showStatus = (type, text) => {
      if (!statusBox) return;
      statusBox.textContent = text;
      statusBox.className = "form-status " + type;
      statusBox.hidden = false;
    };

    const clearStatus = () => {
      if (!statusBox) return;
      statusBox.hidden = true;
      statusBox.textContent = "";
      statusBox.className = "form-status";
    };

    const markInvalid = (id) => {
      const el = contactForm.querySelector("#" + id);
      if (!el) return;
      el.classList.add("is-invalid");
      el.setAttribute("aria-invalid", "true");
      el.focus();
    };

    const clearInvalid = (el) => {
      el.classList.remove("is-invalid");
      el.removeAttribute("aria-invalid");
    };

    // Al corregir un campo se quita el rojo y el aviso de error
    contactForm.querySelectorAll("input, textarea").forEach((el) => {
      el.addEventListener("input", () => {
        if (el.classList.contains("is-invalid")) {
          clearInvalid(el);
          if (statusBox && statusBox.classList.contains("error")) clearStatus();
        }
      });
    });

    // ---- Contador de caracteres del mensaje ----
    const updateCounter = () => {
      if (!counter || !mensajeEl) return;
      const n = mensajeEl.value.trim().length;
      counter.textContent = n + " / " + MIN_MENSAJE;
      counter.classList.toggle("ok", n >= MIN_MENSAJE);
    };
    if (mensajeEl) mensajeEl.addEventListener("input", updateCounter);
    updateCounter();

    const resetTurnstile = () => {
      if (TURNSTILE_SITE_KEY && window.turnstile) {
        try {
          window.turnstile.reset();
        } catch {}
      }
    };

    // ---- Envío ----
    contactForm.addEventListener("submit", async function (e) {
      e.preventDefault();
      clearStatus();

      const formData = new FormData(contactForm);
      const data = {
        empresa: String(formData.get("empresa") || "").trim(),
        nombre: String(formData.get("nombre") || "").trim(),
        telefono: String(formData.get("telefono") || "").trim(),
        email: String(formData.get("email") || "").trim(),
        interes: formData.get("interes") || "informacion",
        tamano: formData.get("tamano") || "1-5",
        mensaje: String(formData.get("mensaje") || "").trim(),
      };

      // Validación antes de enviar: el usuario sabe qué corregir
      if (!data.empresa) {
        ga("form_error", { elemento: "empresa_vacia" });
        showStatus("error", STATUS.companyRequired);
        markInvalid("empresa");
        return;
      }

      if (!data.nombre) {
        ga("form_error", { elemento: "nombre_vacio" });
        showStatus("error", STATUS.nameRequired);
        markInvalid("nombre");
        return;
      }

      if (!EMAIL_RE.test(data.email)) {
        ga("form_error", { elemento: "email_invalido" });
        showStatus("error", STATUS.emailInvalid);
        markInvalid("email");
        return;
      }

      if (data.mensaje.length < MIN_MENSAJE) {
        ga("form_error", { elemento: "mensaje_corto" });
        showStatus("error", STATUS.messageShort);
        markInvalid("mensaje");
        return;
      }

      let url = CONTACT_API_URL;
      if (TURNSTILE_SITE_KEY) {
        const token = String(formData.get("cf-turnstile-response") || "");
        if (!token) {
          ga("form_error", { elemento: "captcha" });
          showStatus("error", STATUS.captcha);
          return;
        }
        url += "?cf=" + encodeURIComponent(token);
      }

      const btn = contactForm.querySelector(".btn-submit");
      if (!btn) return;

      const originalText = btn.innerHTML;
      btn.innerHTML = "<span>" + SENDING_TEXT + "</span>";
      btn.disabled = true;

      try {
        const response = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (!response.ok) {
          throw new Error("HTTP " + response.status);
        }

        ga("generate_lead", {
          origen: origen,
          elemento: data.interes,
        });

        contactForm.reset();
        updateCounter();
        showStatus("success", STATUS.success);
      } catch (error) {
        ga("form_error", { elemento: "envio_api" });
        console.error("Error contacto:", error);
        showStatus("error", STATUS.error);
      } finally {
        // El token de Turnstile solo vale una vez
        resetTurnstile();
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    });
  });
</script>