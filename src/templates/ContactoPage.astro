const t = contactT[lang] || contactT.es;

// Textos con el mínimo ya sustituido
const messageHint = t.form.messageHint.replace("{n}", String(MIN_MENSAJE));
const STATUS = {
  ...t.status,
  messageShort: t.status.messageShort.replace("{n}", String(MIN_MENSAJE)),
};
const SENDING_TEXT = t.form.sending;

// API URL del formulario de contacto
const CONTACT_API_URL =
  "https://raygoldapi-c3ckbgc6b5g5bvds.spaincentral-01.azurewebsites.net/api/contacto";
---

<Layout
  title={t.metaTitle}
  description={t.metaDesc}
  lang={lang}
  alternateUrls={alternateUrls}
>
  {
    TURNSTILE_SITE_KEY && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      />
    )
  }

  <div class="contacto-page">
    <!-- Hero Section -->
    <section class="contacto-hero">
      <div class="container">
        <div class="hero-content">
          <h1>
            {t.title}
            <span class="titulo-enfasis">{t.titleHighlight}</span>
          </h1>
          <p>{t.subtitle}</p>
        </div>
      </div>
    </section>

    <!-- Cards Container -->
    <section class="contacto-section">
      <div class="container">
        <div class="contact-grid">
          <!-- Card 1: Formulario de Contacto -->
          <div class="contact-card contact-form-card">
            <div class="card-header">
              <div class="card-icon">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div>
                <h3>{t.formCard.title}</h3>
                <p>{t.formCard.subtitle}</p>
              </div>
            </div>

            <form id="contactForm" class="contact-form" novalidate>
              <div class="form-row">
                <div class="form-group">
                  <label for="empresa">{t.form.company}</label>
                  <input
                    type="text"
                    id="empresa"
                    name="empresa"
                    placeholder={t.form.companyPlaceholder}
                    autocomplete="organization"
                    required
                  />
                </div>
                <div class="form-group">
                  <label for="nombre">{t.form.name}</label>
                  <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    placeholder={t.form.namePlaceholder}
                    autocomplete="name"
                    required
                  />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="telefono">{t.form.phone}</label>
                  <div class="input-prefix">
                    <span>+34</span>
                    <input
                      type="tel"
                      id="telefono"
                      name="telefono"
                      placeholder="612 345 678"
                      autocomplete="tel-national"
                    />
                  </div>
                </div>
                <div class="form-group">
                  <label for="email">{t.form.email}</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="juan@joyeria.com"
                    autocomplete="email"
                    required
                  />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="interes">{t.form.interest}</label>
                  <select id="interes" name="interes">
                    {
                      t.form.interestOptions.map((opt) => (
                        <option value={opt.value}>{opt.label}</option>
                      ))
                    }
                  </select>
                </div>
                <div class="form-group">
                  <label for="tamano">{t.form.size}</label>
                  <select id="tamano" name="tamano">
                    {
                      t.form.sizeOptions.map((opt) => (
                        <option value={opt.value}>{opt.label}</option>
                      ))
                    }
                  </select>
                </div>
              </div>

              <div class="form-group full-width">
                <label for="mensaje">{t.form.message}</label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="4"
                  minlength={MIN_MENSAJE}
                  maxlength="3000"
                  required
                  aria-describedby="mensajeHint"
                  placeholder={t.form.messagePlaceholder}></textarea>
                <div class="form-hint" id="mensajeHint">
                  <span>{messageHint}</span>
                  <span class="char-counter" id="charCounter" aria-live="polite"
                    >0 / {MIN_MENSAJE}</span
                  >
                </div>
              </div>

              {
                TURNSTILE_SITE_KEY && (
                  <div class="turnstile-wrap">
                    <div
                      class="cf-turnstile"
                      data-sitekey={TURNSTILE_SITE_KEY}
                      data-theme="auto"
                      data-size="flexible"
                    />
                  </div>
                )
              }

              <div
                class="form-status"
                id="formStatus"
                role="status"
                aria-live="polite"
                hidden
              >
              </div>

              <button type="submit" class="btn-submit">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                {t.form.submit}
              </button>
            </form>
          </div>

          <!-- Card 2: Contacto Directo -->
          <div class="contact-card direct-contact-card">
            <div class="card-header">
              <div class="card-icon contact">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3>{t.directContact.title}</h3>
                <p>{t.directContact.subtitle}</p>
              </div>
            </div>

            <div class="contact-channels">
              <!-- Teléfono -->
              <a href="tel:+34648088550" class="contact-channel" data-ga="contacto_click" data-ga-canal="telefono" data-ga-ubicacion="pagina_contacto">
                <div class="channel-icon phone-bg">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
                    ></path>
                  </svg>
                </div>
                <div class="channel-info">
                  <span class="channel-label">{t.directContact.phoneLabel}</span>
                  <span class="channel-value">+34 648 088 550</span>
                </div>
                <svg
                  class="channel-arrow"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <polyline points="9 18 15 12 9 6"></polyline>
