      email: string;
      interest: string;
      interestOptions: { value: string; label: string }[];
      size: string;
      sizeOptions: { value: string; label: string }[];
      message: string;
      messagePlaceholder: string;
      messageHint: string;
      submit: string;
      sending: string;
    };
    status: {
      companyRequired: string;
      nameRequired: string;
      emailInvalid: string;
      messageShort: string;
      captcha: string;
      success: string;
      error: string;
    };
    directContact: {
      title: string;
      subtitle: string;
      phoneLabel: string;
      whatsappLabel: string;
      emailLabel: string;
      scheduleTitle: string;
      scheduleValue: string;
      responseTitle: string;
      responseValue: string;
    };
  }
