    metaTitle: "Tecnologia | RayGold ERP para Joalheria",
    metaDesc:
      "Arquitetura tecnológica do RayGold: Vue.js, ASP.NET Core, Azure, IA com Claude. Software moderno para joalherias.",
    stackTitle: "Stack Tecnológico",
    frontend: { title: "Frontend", subtitle: "Interface de Usuário" },
    backend: { title: "Backend", subtitle: "API & Lógica" },
    web: { title: "Web", subtitle: "Presença Digital" },
    ai: { title: "Inteligência Artificial", subtitle: "Claude by Anthropic" },
    aiFeatures: [
      "Assistente Inteligente",
      "Análise de Dados",
      "Automação",
      "Geração de Conteúdo",
    ],
    cloud: { title: "Microsoft Azure", subtitle: "Infraestrutura Cloud" },
    cloudServices: [
      "App Service",
      "Static Web Apps",
      "SQL Database",
      "Blob Storage",
      "Multi-Tenant",
    ],
    database: { title: "Banco de Dados", subtitle: "Persistência" },
    storage: { title: "Armazenamento", subtitle: "Assets & Mídia" },
    result: {
      title: "RayGold ERP",
      subtitle: "Software especializado para joalherias",
    },
    modules: [
      "Mestres",
      "Comercial",
      "Fabricação",
      "Finanças",
      "Estatísticas",
      "Vendedores",
      "Ecommerce",
    ],
