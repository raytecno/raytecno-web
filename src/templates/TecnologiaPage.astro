const tt = techT[lang] || techT.es;

// Iconos de servicios cloud
const cloudIcons = ["🖥️", "📊", "🗄️", "📦", "🔐"];
const aiIcons = ["💬", "📊", "⚙️", "📝"];
const moduleIcons = ["📦", "🛒", "🏭", "💰", "📈", "👥", "🌐"];
---

<Layout
  title={tt.metaTitle}
  description={tt.metaDesc}
  lang={lang}
  alternateUrls={alternateUrls}
>
  <div class="tech-page">
    <!-- Header de página -->
    <section class="page-header">
      <div class="container">
        <div class="header-content">
          <h1>{tt.title} <span>{tt.titleHighlight}</span></h1>
          <p>{tt.subtitle}</p>
        </div>
      </div>
    </section>

    <!-- Diagrama -->
    <section class="diagram-section">
      <div class="container">
        <div class="diagram">
          <div class="diagram-title">{tt.stackTitle}</div>

          <div class="arch-grid">
            <!-- Frontend -->
            <div class="node node-frontend">
              <div class="node-header">
                <div class="node-icon">⚡</div>
                <div>
                  <div class="node-title">{tt.frontend.title}</div>
                  <div class="node-subtitle">{tt.frontend.subtitle}</div>
                </div>
              </div>
              <div class="node-tags">
                <span class="tag">Vue.js</span>
                <span class="tag">Vuetify</span>
                <span class="tag">Quasar</span>
                <span class="tag">SPA</span>
              </div>
            </div>

            <!-- Backend -->
            <div class="node node-backend">
              <div class="node-header">
                <div class="node-icon">🔷</div>
                <div>
                  <div class="node-title">{tt.backend.title}</div>
                  <div class="node-subtitle">{tt.backend.subtitle}</div>
                </div>
              </div>
              <div class="node-tags">
                <span class="tag">ASP.NET Core</span>
                <span class="tag">C#</span>
                <span class="tag">REST API</span>
              </div>
            </div>

            <!-- Web -->
            <div class="node node-web">
              <div class="node-header">
                <div class="node-icon">🚀</div>
                <div>
                  <div class="node-title">{tt.web.title}</div>
                  <div class="node-subtitle">{tt.web.subtitle}</div>
                </div>
              </div>
              <div class="node-tags">
                <span class="tag">Astro</span>
                <span class="tag">WordPress</span>
                <span class="tag">Ecommerce</span>
              </div>
            </div>

            <!-- AI -->
            <div class="node node-ai">
              <div class="node-header">
                <div>
                  <div class="node-title">{tt.ai.title}</div>
                  <div class="node-subtitle">{tt.ai.subtitle}</div>
                </div>
              </div>
              <div class="ai-features">
                {
                  tt.aiFeatures.map((feature, i) => (
                    <div class="ai-feature">
                      <span class="ai-feature-icon">{aiIcons[i]}</span>
                      {feature}
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- Cloud -->
            <div class="node node-cloud">
              <div class="node-header">
                <div>
                  <div class="node-title">{tt.cloud.title}</div>
                  <div class="node-subtitle">{tt.cloud.subtitle}</div>
                </div>
              </div>
              <div class="services">
                {
                  tt.cloudServices.map((service, i) => (
                    <div class="service">
                      <div class="service-icon">{cloudIcons[i]}</div>
                      <span class="service-name">{service}</span>
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- Base de Datos y Almacenamiento - Fila simétrica -->
            <div class="row-two">
              <div class="node node-data">
                <div class="node-header">
                  <div class="node-icon">🗃️</div>
                  <div>
                    <div class="node-title">{tt.database.title}</div>
                    <div class="node-subtitle">{tt.database.subtitle}</div>
                  </div>
                </div>
                <div class="node-tags">
                  <span class="tag">SQL Server</span>
                  <span class="tag">Entity Framework</span>
                  <span class="tag">Progress</span>
                </div>
              </div>

              <div class="node node-storage">
                <div class="node-header">
                  <div class="node-icon">💾</div>
                  <div>
                    <div class="node-title">{tt.storage.title}</div>
                    <div class="node-subtitle">{tt.storage.subtitle}</div>
                  </div>
                </div>
                <div class="node-tags">
                  <span class="tag">Blob Storage</span>
                  <span class="tag">CDN</span>
                  <span class="tag">Imágenes</span>
                  <span class="tag">Documentos</span>
                </div>
              </div>
            </div>

            <!-- RayGold Result -->
            <div class="node node-result">
              <div class="node-header">
                <div class="node-icon">💎</div>
                <div>
                  <div class="node-title">{tt.result.title}</div>
                  <div class="node-subtitle">{tt.result.subtitle}</div>
                </div>
              </div>
              <div class="result-features">
                {
                  tt.modules.map((mod, i) => (
                    <div class="result-feature">
                      <span>{moduleIcons[i]}</span> {mod}
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Tech logos -->
          <div class="tech-footer">
            <div class="tech-item">
              <div class="tech-logo vue">V</div>
              <span class="tech-name">Vue.js</span>
            </div>
            <div class="tech-item">
              <div class="tech-logo dotnet">.N</div>
              <span class="tech-name">.NET</span>
            </div>
            <div class="tech-item">
              <div class="tech-logo azure">☁️</div>
              <span class="tech-name">Azure</span>
            </div>
            <div class="tech-item">
              <div class="tech-logo astro">🚀</div>
              <span class="tech-name">Astro</span>
            </div>
            <div class="tech-item">
              <div class="tech-logo wordpress">W</div>
              <span class="tech-name">WordPress</span>
            </div>
            <div class="tech-item">
              <div class="tech-logo claude">🤖</div>
              <span class="tech-name">Claude AI</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <h2>{tt.ctaTitle}</h2>
        <p>{tt.ctaSubtitle}</p>
        <a href={getPageUrl("contacto", lang)} class="cta-button">
          {tt.ctaButton}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            width="18"
            height="18"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Variables locales de la página.
     ANTES estaban en :root, que en un <style> de Astro NO queda acotado. */
  .tech-page {
    /* Colores de marca de cada tecnología. Se usan en bordes y logos,
       nunca como color de texto: no funcionarían en los dos temas. */
    --vue: #42b883;
    --dotnet: #7c4dff;
    --astro: #ff5d01;
    --claude: #d97757;
    --azure: #0078d4;

    background: var(--rg-bg);
    color: var(--rg-ink);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Page Header */
  .page-header {
    padding: 60px 0 40px;
    text-align: center;
  }

  .header-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header h1 {
    font-family: var(--rg-display);
    font-size: clamp(1.9rem, 4.2vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.14;
    color: var(--rg-ink);
    margin: 0 0 1rem;
  }

  .page-header h1 span {
    font-style: italic;
    color: var(--rg-accent);
  }

  .page-header p {
    font-size: 1.1rem;
    color: var(--rg-soft);
    line-height: 1.6;
    margin: 0;
  }

  /* Diagram Section */
  .diagram-section {
    padding: 20px 0 60px;
  }

  .diagram {
    background: var(--rg-sup2);
    border: 1px solid var(--rg-line);
    border-radius: 24px;
    padding: 2rem;
  }

  .diagram-title {
    text-align: center;
    font-family: var(--rg-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    color: var(--rg-faint);
  }

  .arch-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* Nodes.
     Cada nodo define --nodo con su color de marca; el resto del estilo
     se deriva de ahí con color-mix, así funciona en claro y en oscuro. */
  .node {
    --nodo: var(--rg-faint);

    background: var(--rg-panel);
    border: 1px solid var(--rg-line);
    border-radius: 16px;
    padding: 1.25rem;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    min-height: 140px;
    display: flex;
    flex-direction: column;
  }

  .node:hover {
    border-color: var(--nodo);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px var(--rg-sombra);
  }

  .node-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1rem;
  }

  .node-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .node-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--rg-ink);
  }

  .node-subtitle {
    font-size: 0.8rem;
    color: var(--rg-soft);
  }

  .node-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  .tag {
    padding: 4px 10px;
    background: color-mix(in srgb, var(--nodo) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--nodo) 25%, transparent);
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--rg-ink);
    font-weight: 500;
  }

  /* Node variants: solo cambian --nodo y el filete superior */
  .node-frontend { --nodo: var(--vue); }
  .node-backend  { --nodo: var(--dotnet); }
  .node-web      { --nodo: var(--astro); }
  .node-data,
  .node-storage  { --nodo: var(--rg-faint); }

  .node-frontend,
  .node-backend,
  .node-web {
    border-color: color-mix(in srgb, var(--nodo) 35%, var(--rg-line));
  }

  /* AI Node */
  .node-ai {
    --nodo: var(--claude);
    grid-column: span 3;
    background: color-mix(in srgb, var(--claude) 7%, var(--rg-panel));
    border-color: color-mix(in srgb, var(--claude) 35%, var(--rg-line));
  }

  .node-ai .node-title {
    font-size: 1.1rem;
  }

  .ai-features {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-feature {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: color-mix(in srgb, var(--claude) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--claude) 28%, transparent);
    border-radius: 10px;
    font-size: 0.85rem;
    color: var(--rg-ink);
    font-weight: 500;
  }

  .ai-feature-icon {
    font-size: 1.1rem;
  }

  /* Cloud Node */
  .node-cloud {
    --nodo: var(--azure);
    grid-column: span 3;
    background: color-mix(in srgb, var(--azure) 7%, var(--rg-panel));
    border-color: color-mix(in srgb, var(--azure) 35%, var(--rg-line));
  }

  .node-cloud .node-title {
    font-size: 1.1rem;
  }

  .services {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .service {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: color-mix(in srgb, var(--azure) 12%, transparent);
