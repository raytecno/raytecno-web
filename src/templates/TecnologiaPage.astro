const tt = techT[lang] || techT.es;

// Iconos de servicios cloud
const cloudIcons = ["🖥️", "📊", "🗄️", "📦", "🔐"];
const aiIcons = ["💬", "📊", "⚙️", "📝"];
const moduleIcons = ["📦", "🛒", "🏭", "💰", "📈", "👥", "🌐"];
---

<Layout
  title={tt.metaTitle}
  description={tt.metaDesc}
  lang={lang}
  alternateUrls={alternateUrls}
>
  <main class="tech-page">
    <!-- Header de página -->
    <section class="page-header">
      <div class="container">
        <div class="header-content">
          <h1>{tt.title} <span>{tt.titleHighlight}</span></h1>
          <p>{tt.subtitle}</p>
        </div>
      </div>
    </section>

    <!-- Diagrama -->
    <section class="diagram-section">
      <div class="container">
        <div class="diagram">
          <div class="diagram-title">{tt.stackTitle}</div>

          <div class="arch-grid">
            <!-- Frontend -->
            <div class="node node-frontend">
              <div class="node-header">
                <div class="node-icon">⚡</div>
                <div>
                  <div class="node-title">{tt.frontend.title}</div>
                  <div class="node-subtitle">{tt.frontend.subtitle}</div>
                </div>
              </div>
              <div class="node-tags">
                <span class="tag">Vue.js</span>
                <span class="tag">Vuetify</span>
                <span class="tag">Quasar</span>
                <span class="tag">SPA</span>
              </div>
            </div>

            <!-- Backend -->
            <div class="node node-backend">
              <div class="node-header">
                <div class="node-icon">🔷</div>
                <div>
                  <div class="node-title">{tt.backend.title}</div>
                  <div class="node-subtitle">{tt.backend.subtitle}</div>
                </div>
              </div>
              <div class="node-tags">
                <span class="tag">ASP.NET Core</span>
                <span class="tag">C#</span>
                <span class="tag">REST API</span>
              </div>
            </div>

            <!-- Web -->
            <div class="node node-web">
              <div class="node-header">
                <div class="node-icon">🚀</div>
                <div>
                  <div class="node-title">{tt.web.title}</div>
                  <div class="node-subtitle">{tt.web.subtitle}</div>
                </div>
              </div>
              <div class="node-tags">
                <span class="tag">Astro</span>
                <span class="tag">WordPress</span>
                <span class="tag">Ecommerce</span>
              </div>
            </div>

            <!-- AI -->
            <div class="node node-ai">
              <div class="node-header">
                <div>
                  <div class="node-title">{tt.ai.title}</div>
                  <div class="node-subtitle">{tt.ai.subtitle}</div>
                </div>
              </div>
              <div class="ai-features">
                {
                  tt.aiFeatures.map((feature, i) => (
                    <div class="ai-feature">
                      <span class="ai-feature-icon">{aiIcons[i]}</span>
                      {feature}
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- Cloud -->
            <div class="node node-cloud">
              <div class="node-header">
                <div>
                  <div class="node-title">{tt.cloud.title}</div>
                  <div class="node-subtitle">{tt.cloud.subtitle}</div>
                </div>
              </div>
              <div class="services">
                {
                  tt.cloudServices.map((service, i) => (
                    <div class="service">
                      <div class="service-icon">{cloudIcons[i]}</div>
                      <span class="service-name">{service}</span>
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- Base de Datos y Almacenamiento - Fila simétrica -->
            <div class="row-two">
              <div class="node node-data">
                <div class="node-header">
                  <div class="node-icon">🗃️</div>
                  <div>
                    <div class="node-title">{tt.database.title}</div>
                    <div class="node-subtitle">{tt.database.subtitle}</div>
                  </div>
                </div>
                <div class="node-tags">
                  <span class="tag">SQL Server</span>
                  <span class="tag">Entity Framework</span>
                  <span class="tag">Progress</span>
                </div>
              </div>

              <div class="node node-storage">
                <div class="node-header">
                  <div class="node-icon">💾</div>
                  <div>
                    <div class="node-title">{tt.storage.title}</div>
                    <div class="node-subtitle">{tt.storage.subtitle}</div>
                  </div>
                </div>
                <div class="node-tags">
                  <span class="tag">Blob Storage</span>
                  <span class="tag">CDN</span>
                  <span class="tag">Imágenes</span>
                  <span class="tag">Documentos</span>
                </div>
              </div>
            </div>

            <!-- RayGold Result -->
            <div class="node node-result">
              <div class="node-header">
                <div class="node-icon">💎</div>
                <div>
                  <div class="node-title">{tt.result.title}</div>
                  <div class="node-subtitle">{tt.result.subtitle}</div>
                </div>
              </div>
              <div class="result-features">
                {
                  tt.modules.map((mod, i) => (
                    <div class="result-feature">
                      <span>{moduleIcons[i]}</span> {mod}
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Tech logos -->
          <div class="tech-footer">
            <div class="tech-item">
              <div class="tech-logo vue">V</div>
              <span class="tech-name">Vue.js</span>
            </div>
            <div class="tech-item">
              <div class="tech-logo dotnet">.N</div>
              <span class="tech-name">.NET</span>
            </div>
            <div class="tech-item">
              <div class="tech-logo azure">☁️</div>
              <span class="tech-name">Azure</span>
            </div>
            <div class="tech-item">
              <div class="tech-logo astro">🚀</div>
              <span class="tech-name">Astro</span>
            </div>
            <div class="tech-item">
              <div class="tech-logo wordpress">W</div>
              <span class="tech-name">WordPress</span>
            </div>
            <div class="tech-item">
              <div class="tech-logo claude">🤖</div>
              <span class="tech-name">Claude AI</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <h2>{tt.ctaTitle}</h2>
        <p>{tt.ctaSubtitle}</p>
        <a href={getPageUrl("contacto", lang)} class="cta-button">
          {tt.ctaButton}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            width="18"
            height="18"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Variables */
  :root {
    --bg-dark: #0a0a0f;
    --bg-card: rgba(20, 20, 30, 0.6);
    --text-primary: var(--panel);
    --text-secondary: var(--soft);
    --text-muted: var(--soft);
    --border-subtle: rgba(255, 255, 255, 0.1);
    --accent-purple: var(--accent);
    --accent-green: #10b981;
    --accent-amber: #f59e0b;
    --accent-cyan: #06b6d4;
  }

  .tech-page {
    background: var(--bg-dark);
    color: var(--text-primary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Page Header */
  .page-header {
    padding: 60px 0 40px;
    text-align: center;
    background: linear-gradient(
      180deg,
      rgba(102, 126, 234, 0.1) 0%,
      transparent 100%
    );
  }

  .header-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(102, 126, 234, 0.15);
    border: 1px solid rgba(102, 126, 234, 0.3);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 500;
    color: #a5b4fc;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-green);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* .page-header h1 {
    font-size: 3rem;
    font-weight: 700;
    margin: 0 0 1rem;
    letter-spacing: -1px;
  } */

  .page-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 1rem;
    background: linear-gradient(135deg, #fff 0%, var(--soft) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .page-header h1 span {
    background: linear-gradient(135deg, var(--accent-purple) 0%, #a78bfa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-header p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Diagram Section */
  .diagram-section {
    padding: 40px 0 60px;
  }

  .diagram {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    padding: 2rem;
  }

  .diagram-title {
    text-align: center;
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 2rem;
    color: var(--text-secondary);
  }

  .arch-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* Nodes */
  .node {
    background: rgba(30, 30, 45, 0.8);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.25rem;
    transition: all 0.3s ease;
    min-height: 140px;
    display: flex;
    flex-direction: column;
  }

  .node:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }

  .node-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1rem;
  }

  .node-icon {
    font-size: 1.5rem;
  }

  .node-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .node-subtitle {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .node-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  .tag {
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--panel);
    font-weight: 500;
  }

  /* Node variants */
  .node-frontend {
    border-color: rgba(66, 184, 131, 0.4);
  }
  .node-frontend:hover {
    border-color: #42b883;
  }
  .node-frontend .node-title {
    color: #42b883;
  }

  .node-backend {
    border-color: rgba(81, 43, 212, 0.4);
  }
  .node-backend:hover {
    border-color: #512bd4;
  }
  .node-backend .node-title {
    color: #a78bfa;
  }

  .node-web {
    border-color: rgba(255, 93, 1, 0.4);
  }
  .node-web:hover {
    border-color: #ff5d01;
  }
  .node-web .node-title {
    color: #ff8a4c;
  }

  /* AI Node */
  .node-ai {
    grid-column: span 3;
    background: linear-gradient(
      135deg,
      rgba(217, 119, 87, 0.1) 0%,
      rgba(191, 90, 60, 0.05) 100%
    );
    border-color: rgba(217, 119, 87, 0.4);
  }
  .node-ai:hover {
    border-color: #d97757;
  }
  .node-ai .node-title {
    color: #d97757;
    font-size: 1.1rem;
  }

  .ai-features {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-feature {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: rgba(217, 119, 87, 0.15);
    border: 1px solid rgba(217, 119, 87, 0.3);
    border-radius: 10px;
    font-size: 0.85rem;
    color: var(--panel);
    font-weight: 500;
  }

  .ai-feature-icon {
    font-size: 1.1rem;
  }

  /* Cloud Node */
  .node-cloud {
    grid-column: span 3;
    background: linear-gradient(
      135deg,
      rgba(0, 120, 212, 0.1) 0%,
      rgba(0, 188, 242, 0.05) 100%
    );
    border-color: rgba(0, 120, 212, 0.4);
  }
  .node-cloud:hover {
    border-color: #0078d4;
  }
  .node-cloud .node-title {
    color: #00bcf2;
    font-size: 1.1rem;
  }

  .services {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .service {
    display: flex;
