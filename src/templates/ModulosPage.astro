---
/**
 * Template: Módulos (índice)
 *
 * TEMA CLARO/OSCURO (Septiembre 2026):
 * - La página usaba background: var(--ink) (token de TEXTO como fondo) y las
 *   tarjetas rgba(30,41,59,.5) fijo. Sobre fondo claro salía gris barro.
 * - El h1 usaba gradiente recortado a texto (-webkit-text-fill-color:
 *   transparent). Si el gradiente no se aplica, el titular queda invisible,
 *   que es justo lo que pasaba. Ahora es color sólido.
 * - Eliminado el bloque de "tema blanco en móvil": con tema oscuro dejaba
 *   texto claro sobre fondo blanco.
 * - Los colores propios de cada módulo se mantienen: son identidad de módulo,
 *   no del tema, y funcionan sobre claro y sobre oscuro.
 *
 * CONTENIDO: el subtítulo decía "11 módulos" en los cinco idiomas y la
 * rejilla tiene 12. Corregido también en las meta-descripciones.
 */
import Layout from "@/layouts/Layout.astro";
import { getAlternateUrls, getPageUrl, type Lang } from "@/config/pages";

interface Props {
  lang: Lang;
  pageId: string;
}

const { lang } = Astro.props;
const alternateUrls = getAlternateUrls("modulos");

// Slug de la carpeta "modulos" por idioma
const modulosFolderSlug: Record<Lang, string> = {
  es: 'modulos',
  en: 'modules',
  fr: 'modules',
  ca: 'moduls',
  'pt-br': 'modulos',
};

// Slugs de cada módulo por idioma
const moduloSlugs: Record<string, Record<Lang, string>> = {
  maestros: { es: 'maestros', en: 'masters', fr: 'maitres', ca: 'mestres', 'pt-br': 'cadastros' },
  comercial: { es: 'comercial', en: 'commercial', fr: 'commercial', ca: 'comercial', 'pt-br': 'comercial' },
  fabricacion: { es: 'fabricacion', en: 'manufacturing', fr: 'fabrication', ca: 'fabricacio', 'pt-br': 'fabricacao' },
  finanzas: { es: 'finanzas', en: 'finance', fr: 'finances', ca: 'finances', 'pt-br': 'financas' },
  historicos: { es: 'historicos', en: 'history', fr: 'historique', ca: 'historics', 'pt-br': 'historicos' },
  inventario: { es: 'inventarios', en: 'stocktaking', fr: 'stocks', ca: 'inventaris', 'pt-br': 'estoques' },
  estadisticas: { es: 'estadisticas', en: 'statistics', fr: 'statistiques', ca: 'estadistiques', 'pt-br': 'estatisticas' },
  vendedores: { es: 'vendedores', en: 'sales-reps', fr: 'vendeurs', ca: 'venedors', 'pt-br': 'vendedores' },
  ecommerce: { es: 'ecommerce', en: 'ecommerce', fr: 'ecommerce', ca: 'ecommerce', 'pt-br': 'ecommerce' },
  impresoras3d: { es: 'impresoras3d', en: '3dprinters', fr: 'imprimantes3d', ca: 'impressores3d', 'pt-br': 'impressoras3d' },
  portal: { es: 'portal', en: 'portal', fr: 'portail', ca: 'portal', 'pt-br': 'portal' },
  asistenteia: { es: 'asistente-ia', en: 'ai-assistant', fr: 'assistant-ia', ca: 'assistent-ia', 'pt-br': 'assistente-ia' },
};

// Función para obtener la URL de un módulo
function getModuloUrl(moduloId: string, currentLang: Lang): string {
  const folder = modulosFolderSlug[currentLang];
  const slug = moduloSlugs[moduloId]?.[currentLang] || moduloId;
  return `/${currentLang}/${folder}/${slug}`;
}

