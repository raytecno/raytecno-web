---

<Layout
  title={pt.metaTitle}
  description={pt.metaDescription}
  lang={lang}
  alternateUrls={alternateUrls}
>
  <div class="modulos-page">
    <!-- Hero -->
    <section class="hero-section">
      <div class="container">
        <h1>{pt.title}</h1>
        <p class="hero-subtitle">{pt.subtitle}</p>
      </div>
    </section>

    <!-- Grid de Módulos -->
    <section class="modulos-section">
      <div class="container">
        <div class="modulos-grid">
          {
            modulos.map((modulo) => {
              const data = mt[modulo.id];
              return (
                <a
                  href={getModuloUrl(modulo.id, lang)}
                  class="modulo-card"
                  style={`--modulo-color: ${modulo.color}`}
                >
                  <div class="modulo-icon" set:html={modulo.icono} />
                  <div class="modulo-content">
                    <h3>{data.nombre}</h3>
                    <p>{data.descripcion}</p>
                  </div>
                  <div class="modulo-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <h2>{pt.ctaTitle}</h2>
        <p>{pt.ctaDesc}</p>
        <div class="cta-buttons">
          <a href={getPageUrl("contacto", lang)} class="btn-primary">{pt.ctaDemo}</a>
          <a href={getPageUrl("precios", lang)} class="btn-secondary">{pt.ctaPrecios}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .modulos-page {
    background: var(--rg-bg);
    color: var(--rg-ink);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero */
  .hero-section {
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .hero-section h1 {
